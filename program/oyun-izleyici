        b_copy.clicked.connect(_copy_key)
        b_keys.clicked.connect(_open_deploy_keys)
        b_save_api.clicked.connect(_save_api)
        b_clone.clicked.connect(_connect_ssh)
        return dlg.exec() == QDialog.DialogCode.Accepted


class SessionTimelineWidget(QWidget):
    """Seçili oturumun FPS + GPU °C + CPU °C zaman grafiği (QPainter, aktif temayla uyumlu)."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.theme = "klasik"
        self.accent_hex = "#40ff70"
        self.title = ""
        self.points = []   # [[sec, fps, gpu_c, cpu_c, gpu_w], ...]
        self.setFixedHeight(162)
        self.hide()

    def set_theme(self, theme, accent_hex):
        self.theme = theme
        self.accent_hex = accent_hex
        self.update()

    def set_session(self, title, timeline_json):
        import json
        self.title = title or ""
        self.points = []
        if timeline_json:
            try:
                pts = json.loads(timeline_json)
                if isinstance(pts, list) and len(pts) >= 2:
                    self.points = pts
            except Exception:
                self.points = []
        self.setVisible(bool(self.points))
        self.update()

    def paintEvent(self, _ev):
        if len(self.points) < 2:
            return
        pal = theme_palette(self.theme, self.accent_hex)
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing, True)
        w, h = self.width(), self.height()

        p.setPen(QPen(QColor(pal["border_strong"]), 1))
        p.setBrush(QColor(pal["surface"]))
        p.drawRoundedRect(QRectF(0.5, 0.5, w - 1, h - 1), 6, 6)

        fps_vals = [pt[1] for pt in self.points if pt[1] is not None]
        gpu_vals = [pt[2] for pt in self.points if len(pt) > 2 and pt[2] is not None]
        cpu_vals = [pt[3] for pt in self.points if len(pt) > 3 and pt[3] is not None]
        if not fps_vals:
            p.end()
            return

        f_max = max(30.0, max(fps_vals) * 1.12)
        t_max = max(95.0, max(gpu_vals + cpu_vals + [80]) * 1.05)

        # Üst başlık + açıklama (legend)
        p.setFont(make_font(9, QFont.Weight.Bold))
        p.setPen(QColor(pal["accent"]))
        p.drawText(QRectF(12, 6, w * 0.55, 18), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter,
                   f"OTURUM GRAFİĞİ — {self.title}")
        leg = f"━ FPS (maks {max(fps_vals):.0f})"
        if gpu_vals:
            leg += f"    ━ GPU °C (maks {max(gpu_vals):.0f}°)"
        if cpu_vals:
            leg += f"    ━ CPU °C (maks {max(cpu_vals):.0f}°)"
        p.setPen(QColor(pal["text_dim"]))
        p.drawText(QRectF(w * 0.40, 6, w * 0.58, 18), Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter, leg)

        gx, gy, gw, gh = 44.0, 28.0, max(40.0, w - 88.0), h - 48.0
        p.setPen(QPen(QColor(pal["border"]), 1, Qt.PenStyle.DashLine))
        for k in range(4):
            yy = gy + gh * k / 3.0
            p.drawLine(QPointF(gx, yy), QPointF(gx + gw, yy))
            p.setPen(QColor(pal["text_dim"]))
            p.setFont(make_font(8, QFont.Weight.Normal))
            p.drawText(QRectF(4, yy - 8, gx - 8, 16), Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter,
                       f"{f_max * (1.0 - k / 3.0):.0f}")
            p.drawText(QRectF(gx + gw + 4, yy - 8, 36, 16), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter,
                       f"{t_max * (1.0 - k / 3.0):.0f}°")
            p.setPen(QPen(QColor(pal["border"]), 1, Qt.PenStyle.DashLine))

        n = len(self.points)
        def _draw_series(idx, vmax, col, width=1.8, fill=False):
            path = QPainterPath()
            started = False
            first_x = last_x = gx
            for i, pt in enumerate(self.points):
                val = pt[idx] if len(pt) > idx else None
                if val is None:
                    continue
                x = gx + gw * i / max(1, n - 1)
                y = gy + gh * (1.0 - max(0.0, min(1.0, val / vmax)))
                if not started:
                    path.moveTo(x, y)
                    first_x = x
                    started = True
                else:
                    path.lineTo(x, y)
                last_x = x
            if not started:
                return
            if fill:
                fp = QPainterPath(path)
                fp.lineTo(last_x, gy + gh)
                fp.lineTo(first_x, gy + gh)
                fp.closeSubpath()
                cfill = QColor(col)
                cfill.setAlpha(38)
                p.setPen(Qt.PenStyle.NoPen)
                p.setBrush(cfill)
                p.drawPath(fp)
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.setPen(QPen(QColor(col), width))
            p.drawPath(path)

        _draw_series(1, f_max, pal["accent"], 2.0, fill=True)
        if gpu_vals:
            _draw_series(2, t_max, "#fdbc4b", 1.5, fill=False)
        if cpu_vals:
            _draw_series(3, t_max, "#ff6b6b", 1.4, fill=False)

        # Zaman ekseni (başlangıç -> bitiş)
        dur = self.points[-1][0]
        p.setPen(QColor(pal["text_dim"]))
        p.setFont(make_font(8, QFont.Weight.Normal))
        p.drawText(QRectF(gx, gy + gh + 3, 80, 14), Qt.AlignmentFlag.AlignLeft, "0 dk")
        p.drawText(QRectF(gx + gw - 90, gy + gh + 3, 90, 14), Qt.AlignmentFlag.AlignRight, fmt_duration(dur))
        p.end()


class CompareBarWidget(QWidget):
    """PC Karşılaştırma sekmesinde ortak oyunlar için yan yana görsel FPS çubukları."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.theme = "klasik"
        self.accent_hex = "#40ff70"
        self.name_a = "A"
        self.name_b = "B"
        self.items = []   # [(game, fps_a, fps_b), ...]
        self.hide()

    def set_theme(self, theme, accent_hex):
        self.theme = theme
        self.accent_hex = accent_hex
        self.update()

    def set_data(self, name_a, name_b, items):
        self.name_a = name_a or "A"
        self.name_b = name_b or "B"
        self.items = items[:6]
        if self.items:
            self.setFixedHeight(32 + len(self.items) * 26)
            self.show()
        else:
            self.hide()
        self.update()

    def paintEvent(self, _ev):
        if not self.items:
            return
        pal = theme_palette(self.theme, self.accent_hex)
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing, True)
        w, h = self.width(), self.height()

        p.setPen(QPen(QColor(pal["border_strong"]), 1))
        p.setBrush(QColor(pal["surface"]))
        p.drawRoundedRect(QRectF(0.5, 0.5, w - 1, h - 1), 6, 6)

        col_a = QColor(pal["accent"])
        col_b = QColor("#fdbc4b")
        p.setFont(make_font(9, QFont.Weight.Bold))
        p.setPen(col_a)
        p.drawText(QRectF(12, 5, w * 0.45, 18), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter,
                   f"■ A: {self.name_a}")
        p.setPen(col_b)
        p.drawText(QRectF(w * 0.48, 5, w * 0.50, 18), Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter,
                   f"■ B: {self.name_b}   (Ort. FPS)")

        mx = max(1.0, max(max(a or 0, b or 0) for _, a, b in self.items))
        lbl_w = 180.0
        val_w = 96.0
        bar_x = lbl_w + 12.0
        bar_w = max(80.0, w - bar_x - val_w - 14.0)

        for i, (game, fa, fb) in enumerate(self.items):
            y = 26.0 + i * 26.0
            p.setFont(make_font(9, QFont.Weight.Bold))
            p.setPen(QColor(pal["text"]))
            elided = p.fontMetrics().elidedText(game, Qt.TextElideMode.ElideRight, int(lbl_w - 8))
            p.drawText(QRectF(12, y, lbl_w - 4, 20), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, elided)

            # Bar A (üst) ve Bar B (alt)
            wa = max(4.0, bar_w * ((fa or 0) / mx))
            wb = max(4.0, bar_w * ((fb or 0) / mx))
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QColor(pal["border"]))
            p.drawRoundedRect(QRectF(bar_x, y + 2, bar_w, 7), 3, 3)
            p.drawRoundedRect(QRectF(bar_x, y + 11, bar_w, 7), 3, 3)
            p.setBrush(col_a)
            p.drawRoundedRect(QRectF(bar_x, y + 2, wa, 7), 3, 3)
            p.setBrush(col_b)
            p.drawRoundedRect(QRectF(bar_x, y + 11, wb, 7), 3, 3)

            p.setFont(make_font(8, QFont.Weight.Bold))
            p.setPen(QColor(pal["text"]))
            p.drawText(QRectF(bar_x + bar_w + 8, y, val_w, 20),
                       Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter,
                       f"{(fa or 0):.0f} / {(fb or 0):.0f}")
        p.end()


