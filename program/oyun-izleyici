    def _draw_gauge_icon(self, p: QPainter, cx, cy, r, green):
        pen = QPen(green, 2.6)
        pen.setCapStyle(Qt.PenCapStyle.RoundCap)
        p.setPen(pen)
        p.setBrush(Qt.BrushStyle.NoBrush)
        p.drawArc(QRectF(cx - r, cy - r * 0.7, 2 * r, 2 * r), 0 * 16, 180 * 16)
        # Needle
        p.drawLine(QPointF(cx, cy + r * 0.25), QPointF(cx + r * 0.55, cy - r * 0.35))
        p.setBrush(green)
        p.drawEllipse(QPointF(cx, cy + r * 0.25), 2.5, 2.5)

    def _draw_settings_gear_icon(self, p: QPainter, cx: float, cy: float, r: float, color: QColor, hover: bool):
        p.save()
        if hover:
            glow = QColor(color)
            glow.setAlpha(60)
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(glow)
            p.drawEllipse(QPointF(cx, cy), r * 1.9, r * 1.9)
        pen = QPen(QColor(255, 255, 255) if hover else color, 1.5, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap)
        p.setPen(pen)
        p.setBrush(Qt.BrushStyle.NoBrush)
        # 8 dişli çark (gear teeth)
        r_body = r * 0.72
        r_tooth = r * 1.05
        for i in range(8):
            ang = math.radians(i * 45.0)
            x1 = cx + math.cos(ang) * (r_body * 0.85)
            y1 = cy + math.sin(ang) * (r_body * 0.85)
            x2 = cx + math.cos(ang) * r_tooth
            y2 = cy + math.sin(ang) * r_tooth
            p.drawLine(QPointF(x1, y1), QPointF(x2, y2))
        p.setBrush(QColor(6, 9, 8))
        p.drawEllipse(QPointF(cx, cy), r_body, r_body)
        p.setBrush(QColor(255, 255, 255) if hover else color)
        p.setPen(Qt.PenStyle.NoPen)
        p.drawEllipse(QPointF(cx, cy), r * 0.28, r * 0.28)
        p.restore()

    def _draw_gpu_3fan_icon(self, p: QPainter, x, y, w, h, green, angle):
        p.save()
        c_mid = QColor(green)
        c_mid.setAlpha(135)
        c_dark = QColor(green.red() // 6, green.green() // 6, green.blue() // 6)
        c_deep = QColor(green.red() // 11, green.green() // 11, green.blue() // 11)
        c_blade = QColor(green)
        c_blade.setAlpha(65)

        # 1. MSI Gaming X Trio / Suprim tarzı fanları takip eden agresif poligonal shroud konturu
        fan_r = min(h * 0.38, (w - 10) / 6.05)
        centers_x = [x + w * 0.185, x + w * 0.50, x + w * 0.815]
        cy = y + h * 0.50

        c0, c1, c2 = centers_x
        v01 = (c0 + c1) * 0.5
        v12 = (c1 + c2) * 0.5
        top_peak = y + 1.2
        top_valley = y + 5.0
        bot_peak = y + h - 1.2
        bot_valley = y + h - 5.0
        chamfer = 6.5

        shroud = QPainterPath()
        shroud.moveTo(x + 1.0, cy - h * 0.22)
        shroud.lineTo(x + chamfer, top_peak + 1.2)
        # Sol fan üst kemeri
        shroud.lineTo(c0 - fan_r * 0.55, top_peak)
        shroud.lineTo(c0 + fan_r * 0.55, top_peak)
        # 1-2 fan arası V-girintisi (Trio shroud boğumu)
        shroud.lineTo(v01, top_valley)
        # Orta fan üst kemeri
        shroud.lineTo(c1 - fan_r * 0.55, top_peak)
        shroud.lineTo(c1 + fan_r * 0.55, top_peak)
        # 2-3 fan arası V-girintisi
        shroud.lineTo(v12, top_valley)
        # Sağ fan üst kemeri
        shroud.lineTo(c2 - fan_r * 0.55, top_peak)
        shroud.lineTo(c2 + fan_r * 0.55, top_peak)
        shroud.lineTo(x + w - chamfer, top_peak + 1.2)
        shroud.lineTo(x + w - 1.0, cy - h * 0.22)
        shroud.lineTo(x + w - 1.0, cy + h * 0.22)
        shroud.lineTo(x + w - chamfer, bot_peak - 1.2)
        # Sağ fan alt kemeri
        shroud.lineTo(c2 + fan_r * 0.55, bot_peak)
        shroud.lineTo(c2 - fan_r * 0.55, bot_peak)
        # 2-3 fan arası alt V-girintisi
        shroud.lineTo(v12, bot_valley)
        # Orta fan alt kemeri
        shroud.lineTo(c1 + fan_r * 0.55, bot_peak)
        shroud.lineTo(c1 - fan_r * 0.55, bot_peak)
        # 1-2 fan arası alt V-girintisi
        shroud.lineTo(v01, bot_valley)
        # Sol fan alt kemeri
        shroud.lineTo(c0 + fan_r * 0.55, bot_peak)
        shroud.lineTo(c0 - fan_r * 0.55, bot_peak)
        shroud.lineTo(x + chamfer, bot_peak - 1.2)
        shroud.lineTo(x + 1.0, cy + h * 0.22)
        shroud.closeSubpath()

        p.setPen(QPen(green, 1.7, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap, Qt.PenJoinStyle.RoundJoin))
        p.setBrush(c_dark)
        p.drawPath(shroud)

        # MSI Trio tarzı fanlar arası çapraz RGB pençe (claw) aksan çizgileri
        p.setPen(QPen(green, 1.3, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
        for vx in (v01, v12):
            p.drawLine(QPointF(vx - 2.2, top_valley + 1.5), QPointF(vx + 1.2, top_valley + 5.2))
            p.drawLine(QPointF(vx + 2.2, top_valley + 1.5), QPointF(vx - 1.2, top_valley + 5.2))
            p.drawLine(QPointF(vx - 2.2, bot_valley - 1.5), QPointF(vx + 1.2, bot_valley - 5.2))
            p.drawLine(QPointF(vx + 2.2, bot_valley - 1.5), QPointF(vx - 1.2, bot_valley - 5.2))

        # 2. Sekizgen/Dairesel fan yuvaları ve 9 kanatlı Torx Fan 4.0 / 5.0 kavisli pervaneler
        num_blades = 9
        for idx, fcx in enumerate(centers_x):
            p.setPen(QPen(c_mid, 1.0))
            p.setBrush(c_deep)
            p.drawEllipse(QPointF(fcx, cy), fan_r + 0.9, fan_r + 0.9)

            p.setPen(QPen(green, 1.3))
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.drawEllipse(QPointF(fcx, cy), fan_r, fan_r)

            dir_sign = -1.0 if idx == 1 else 1.0
            base_ang = angle * dir_sign + idx * 15.0

            p.setPen(QPen(green, 1.2, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap, Qt.PenJoinStyle.RoundJoin))
            p.setBrush(c_blade)
            hub_r = fan_r * 0.27
            tip_r = fan_r * 0.89

            for b in range(num_blades):
                a0 = math.radians(base_ang + b * (360.0 / num_blades))
                a_mid = a0 + dir_sign * 0.40
                a_tip = a0 + dir_sign * 0.68
                a_back = a0 + dir_sign * 0.20

                sx = fcx + math.cos(a0) * hub_r
                sy = cy + math.sin(a0) * hub_r
                cx1 = fcx + math.cos(a_mid) * (fan_r * 0.63)
                cy1 = cy + math.sin(a_mid) * (fan_r * 0.63)
                tx = fcx + math.cos(a_tip) * tip_r
                ty = cy + math.sin(a_tip) * tip_r
                bx = fcx + math.cos(a_back) * (hub_r * 1.12)
                by = cy + math.sin(a_back) * (hub_r * 1.12)

                blade = QPainterPath(QPointF(sx, sy))
                blade.quadTo(QPointF(cx1, cy1), QPointF(tx, ty))
                blade.quadTo(QPointF(cx1 * 0.96 + fcx * 0.04, cy1 * 0.96 + cy * 0.04), QPointF(bx, by))
                blade.closeSubpath()
                p.drawPath(blade)

            # Merkez motor göbeği (MSI Torx metalik göbek halkası)
            p.setPen(QPen(green, 1.15))
            p.setBrush(c_dark)
            p.drawEllipse(QPointF(fcx, cy), hub_r, hub_r)
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(green)
            p.drawEllipse(QPointF(fcx, cy), hub_r * 0.38, hub_r * 0.38)

        p.restore()

    def paintEvent(self, event):
        t = self.telemetry
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing, True)
        p.setRenderHint(QPainter.RenderHint.TextAntialiasing, True)

        # Scale logical coordinate system to 390 x 770
        p.scale(self.width() / float(self.base_w), self.height() / float(self.base_h))

        W, H = self.base_w, self.base_h
        hh = self.header_h
        edna = self.theme == "edna"
        # Arka plan ve çerçeve çizgileri self.opacity ile şeffaflaşır; tüm yazılar, sayılar ve aktif grafikler %100 opak kalır.
        # Windows'ta alpha=0 olan pikseller DWM tarafından arkadaki pencereye geçer (scroll/tık çalışmaz);
        # en az 1/255 (~%0.4, gözle görünmez) tutulur ki %0 şeffaflıkta bile fare tekerleği ve sürükleme yakalansın.
        bg_alpha = max(1, int(round(255 * self.opacity))) if IS_WIN else int(round(255 * self.opacity))
        line_alpha = int(round(255 * self.opacity))
        track_alpha = int(round(55 + 200 * self.opacity))

        bg_dark = QColor(6, 9, 8, bg_alpha)
        bg_cell = QColor(8, 12, 10, bg_alpha)
        green = QColor(self.accent_hex)
        if not green.isValid():
            green = QColor(64, 255, 112)
        green_dim = QColor(max(12, green.red() // 4), max(16, green.green() // 4), max(14, green.blue() // 4), track_alpha)
        grid_col = QColor(max(24, green.red() // 5 + 18), max(32, green.green() // 5 + 22), max(28, green.blue() // 5 + 20), line_alpha)
        border_outer = QColor(max(35, green.red() // 3 + 20), max(45, green.green() // 3 + 25), max(38, green.blue() // 3 + 20), line_alpha)
        white = QColor(248, 252, 249, 255)
        if edna:   # KDE "Edna" renk şeması
            bg_dark = QColor(38, 50, 56, bg_alpha)
            bg_cell = QColor(44, 58, 65, bg_alpha)
            green = QColor(16, 166, 212)
            green_dim = QColor(33, 52, 61, track_alpha)
            grid_col = QColor(62, 80, 89, line_alpha)
            border_outer = QColor(84, 110, 122, line_alpha)
            white = QColor(237, 240, 242, 255)

        # Önce pencere yüzeyini temizle (WA_TranslucentBackground açıkken eski kare izi kalmasın)
        p.setCompositionMode(QPainter.CompositionMode.CompositionMode_Source)
        if edna:
            zemin = QLinearGradient(0, 0, 0, H)
            zemin.setColorAt(0.0, QColor(42, 55, 62, bg_alpha))
            zemin.setColorAt(1.0, QColor(31, 42, 48, bg_alpha))
            p.fillRect(QRectF(0, 0, W, H), QBrush(zemin))
        else:
            p.fillRect(0, 0, W, H, bg_dark)
        p.setCompositionMode(QPainter.CompositionMode.CompositionMode_SourceOver)

        if line_alpha > 0:
            p.setPen(QPen(border_outer, 2))
            p.drawRect(1, 1, W - 2, H - 2)

        if hh:
            self._draw_header(p, W, hh, edna, green, white, QColor(190, 200, 195))
            p.translate(0, hh)       # asıl panel içeriği şeridin altından başlar

        col_split = 216  # Left column width = 216, Right column = 174

        # Izgara Y koordinatları
        y_r1 = 0
        y_r2 = 258
        y_r3 = 382
        y_r4 = 682

        # Draw vertical middle divider (from top down to y_r4)
        p.setPen(QPen(grid_col, 2.5))
        p.drawLine(col_split, 0, col_split, y_r4)
        p.drawLine(0, y_r2, W, y_r2)
        p.drawLine(0, y_r3, W, y_r3)
        p.drawLine(0, y_r4, W, y_r4)

        # =====================================================================
        # ROW 1 LEFT: Sol Üst Küçük Ayarlar Çarkı + RX 9070 XT + Giant FPS + LOW | AVG
        # =====================================================================
        dr = self.DOTS_RECT
        self._draw_settings_gear_icon(p, dr.center().x() - 1.0, dr.center().y() - 1.0, 5.2, green, self.dots_hover)

        f_gpu_title = self._font(22)
        p.setFont(f_gpu_title)
        p.setPen(white)
        sm = self.summary
        p.drawText(QRectF(16, 8, col_split - 22, 42), Qt.AlignmentFlag.AlignCenter,
                   "SON OYUN" if sm else t.gpu_name)

        # Neon green underline under RX 9070 XT
        p.setPen(QPen(green, 3))
        p.drawLine(8, 54, col_split - 8, 54)

        # Giant FPS number (4 haneli 1000+ FPS değerlerinde 1. hanenin sola taşmasını önlemek için dinamik ölçek)
        fps_text = f"{sm['avg_fps']:.0f}" if sm else ("—" if t.fps is None else str(t.fps))
        f_fps_big = self._font(48 if len(fps_text) >= 4 else 62)
        p.setFont(f_fps_big)
        p.setPen(green)
        p.drawText(QRectF(4, 58, col_split - 50, 105), Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter, fps_text)

        f_fps_lbl = self._font(16)
        p.setFont(f_fps_lbl)
        p.drawText(QRectF(col_split - 46, 70, 44, 34), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop, "ORT" if sm else "FPS")

        # LOW | AVG at bottom of Row 1 Left
        f_sub_num = self._font(18)
        f_sub_lbl = self._font(13 if sm else 15)

        # Vertical green bar between LOW and AVG
        p.setPen(QPen(green, 3))
        p.drawLine(col_split // 2, 174, col_split // 2, 242)

        # LOW
        p.setFont(f_sub_num)
        p.setPen(white)
        p.drawText(QRectF(10, 170, col_split // 2 - 14, 32), Qt.AlignmentFlag.AlignCenter, f"{sm['low1']:.0f}" if sm else ("—" if t.fps_low is None else str(t.fps_low)))
        p.setFont(f_sub_lbl)
        p.setPen(green)
        p.drawText(QRectF(10, 206, col_split // 2 - 14, 32), Qt.AlignmentFlag.AlignCenter, "1% LOW")

        # AVG
        p.setFont(f_sub_num)
        p.setPen(white)
        p.drawText(QRectF(col_split // 2 + 4, 170, col_split // 2 - 14, 32), Qt.AlignmentFlag.AlignCenter, f"{sm['low01']:.0f}" if sm else ("—" if t.fps_avg is None else str(t.fps_avg)))
        p.setFont(f_sub_lbl)
        p.setPen(green)
        p.drawText(QRectF(col_split // 2 + 4, 206, col_split // 2 - 14, 32), Qt.AlignmentFlag.AlignCenter, "0.1% LOW" if sm else "AVG")

        # =====================================================================
        # ROW 1 RIGHT: Fan % / RPM + 3-Fan Icon + GPU %, W, °C, MHz
        # =====================================================================
        rx = col_split + 8
        rw = W - col_split - 16

        f_fan_pct = self._font(14)
        f_fan_rpm = self._font(10 if t.fan_rpm >= 1000 else 11)  # 3-4 haneli RPM fan simgesine asla taşmasın
        p.setFont(f_fan_pct)
        p.setPen(white)
        p.drawText(QRectF(rx, 6, 74, 24), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, f"{t.fan_pct}%")
        p.setFont(f_fan_rpm)
        p.drawText(QRectF(rx, 30, 74, 22), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, f"{t.fan_rpm} RPM")

        # 3-Fan MSI Trio tarzı GPU ikonu (sağa yaslı, RPM yazısıyla asla çakışmaz)
        self._draw_gpu_3fan_icon(p, col_split + 80, 10, 88, 38, green, t.fan_angle)

        # Divider under fan header
        p.setPen(QPen(grid_col, 2))
        p.drawLine(col_split, 56, W, 56)

        # 4 GPU stat rows
        f_stat = self._font(16)
        p.setFont(f_stat)

        # 1) GPU %
        self._draw_ring_icon(p, rx + 14, 82, 11, t.gpu_load, green)
        p.setPen(green)
        p.drawText(QRectF(rx + 34, 66, 54, 32), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, "GPU")
        p.setPen(white)
        p.drawText(QRectF(rx + 84, 66, rw - 80, 32), Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter, f"{t.gpu_load} %")

        # 2) GPU Watt
        self._draw_bolt_icon(p, rx + 14, 128, 13, green)
        p.setPen(green)
        p.drawText(QRectF(rx + 36, 112, rw - 36, 32), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, "— W" if t.gpu_watt is None else f"{t.gpu_watt} W")

        # 3) GPU Temp (+ Hot Spot sağa hizalı)
        self._draw_thermometer_icon(p, rx + 14, 176, 13, green)
        p.setPen(temp_color(t.gpu_temp, white, edna))
        p.drawText(QRectF(rx + 36, 160, rw - 36, 32), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, "— °C" if t.gpu_temp is None else f"{t.gpu_temp} °C")
        if t.gpu_hotspot is not None:
            p.setFont(self._font(10))
            hs_col = QColor(231, 76, 60) if t.gpu_hotspot >= 95 else (QColor(253, 188, 75) if t.gpu_hotspot >= 86 else green)
            p.setPen(hs_col)
            p.drawText(QRectF(rx + 96, 160, rw - 92, 32), Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter, f"HS {t.gpu_hotspot}°")
            p.setFont(f_stat)

        # 4) GPU MHz
        self._draw_gauge_icon(p, rx + 14, 226, 12, green)
        p.setPen(green)
        p.drawText(QRectF(rx + 36, 208, rw - 36, 32), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, f"{t.gpu_mhz} MHZ")

        # =====================================================================
        # ROW 2 LEFT: FRAMETIME Pill + Canlı Sparkline + Label
        # =====================================================================
        has_spark = (not sm) and len(t.ft_hist) >= 2 and (t.frametime_ms is not None)
        pill_cy = y_r2 + (32 if has_spark else 44)
        p.setPen(QPen(green, 2.5))
        p.drawLine(14, pill_cy, 68, pill_cy)
        p.drawLine(col_split - 68, pill_cy, col_split - 14, pill_cy)

        pill_rect = QRectF(68, pill_cy - 18, col_split - 136, 36)
        p.setBrush(bg_cell)
        p.drawRoundedRect(pill_rect, 16, 16)

        f_ft_val = self._font(15)
        p.setFont(f_ft_val)
        p.setPen(white)
        p.drawText(pill_rect, Qt.AlignmentFlag.AlignCenter, (f"{sm['avg_ft']:.1f} ms" if sm and sm.get("avg_ft") else
                    "—" if t.frametime_ms is None else f"{t.frametime_ms:.1f} ms"))

        if has_spark:
            sx0, sy0, sw, sh = 14.0, y_r2 + 56.0, col_split - 28.0, 26.0
            pts = list(t.ft_hist)
            med = sorted(pts)[len(pts) // 2]
            vmax = max(25.0, min(65.0, max(pts) * 1.15))
            sp_path = QPainterPath()
            for i, fv in enumerate(pts):
                px = sx0 + sw * i / max(1, len(pts) - 1)
                py = sy0 + sh - sh * min(1.0, max(0.0, fv / vmax))
                if i == 0:
                    sp_path.moveTo(px, py)
                else:
                    sp_path.lineTo(px, py)
            p.setPen(QPen(green, 1.6))
