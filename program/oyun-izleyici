class NetPingPoller:
    """Arka planda hafif TCP RTT (1.1.1.1:443) ile canlı ping ve jitter (ms) ölçer; alt süreç açmaz."""

    TARGETS = (("1.1.1.1", 443), ("8.8.8.8", 53))

    def __init__(self, interval=3.0):
        import threading
        self.interval = interval
        self.ping_ms = None
        self.jitter_ms = None
        self._samples = deque(maxlen=10)
        self._stop = False
        threading.Thread(target=self._run, daemon=True).start()

    def _measure_once(self):
        import socket
        for host, port in self.TARGETS:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(1.5)
            t0 = time.perf_counter()
            try:
                s.connect((host, port))
                return (time.perf_counter() - t0) * 1000.0
            except OSError:
                continue
            finally:
                try:
                    s.close()
                except OSError:
                    pass
        return None

    def _run(self):
        while not self._stop:
            ms = self._measure_once()
            if ms is not None:
                self._samples.append(ms)
                self.ping_ms = round(ms, 1)
                if len(self._samples) >= 2:
                    diffs = [abs(self._samples[i] - self._samples[i - 1]) for i in range(1, len(self._samples))]
                    self.jitter_ms = round(sum(diffs) / len(diffs), 1)
                else:
                    self.jitter_ms = 0.0
            else:
                self.ping_ms = None
            for _ in range(int(self.interval * 5)):
                if self._stop:
                    return
                time.sleep(0.2)

    def stop(self):
        self._stop = True


def detect_display_mode():
    """Aktif birincil ekranın çözünürlük ve yenileme hızını döndürür (ör. 2560x1440@180Hz)."""
    try:
        scr = QGuiApplication.primaryScreen()
        if scr is None:
            return None
        geo = scr.geometry()
        dpr = scr.devicePixelRatio() or 1.0
        w = int(round(geo.width() * dpr))
        h = int(round(geo.height() * dpr))
        hz = int(round(scr.refreshRate() or 0))
        return f"{w}x{h}@{hz}Hz" if hz > 0 else f"{w}x{h}"
    except Exception:
        return None


