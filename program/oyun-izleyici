def tier_color(pct, base, edna):
    """Edna temasında doluluk arttıkça vurgu rengi kehribara, sonra turuncuya döner."""
    if not edna:
        return base
    if pct >= 90:
        return QColor(246, 116, 0)
    if pct >= 75:
        return QColor(253, 188, 75)
    return base


def temp_color(celsius, base, edna):
    if not edna or celsius is None:
        return base
    if celsius >= 85:
        return QColor(231, 76, 60)
    if celsius >= 75:
        return QColor(253, 188, 75)
    return base


def draw_edna_landscape(p, W, y0, h):
    """Alt bilgi çubuğunun arkasında: gün batımı ışıltısı, uzak dağ sırası, kumul ve tek ağaç."""
    b = y0 + h
    glow = QRadialGradient(W * 0.64, b + 8, W * 0.62)
    glow.setColorAt(0.0, QColor(246, 150, 40, 80))
    glow.setColorAt(0.45, QColor(200, 70, 110, 34))
    glow.setColorAt(1.0, QColor(0, 0, 0, 0))
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QBrush(glow))
    p.drawRect(QRectF(2, y0 + 2, W - 4, h - 4))

    far = QPainterPath()
    far.moveTo(2, b - 30)
    far.cubicTo(40, b - 50, 72, b - 46, 112, b - 35)
    far.cubicTo(152, b - 24, 192, b - 54, 248, b - 47)
    far.cubicTo(292, b - 42, 332, b - 30, W - 2, b - 38)
    far.lineTo(W - 2, b - 2)
    far.lineTo(2, b - 2)
    far.closeSubpath()
    p.setBrush(QColor(84, 110, 122, 72))
    p.drawPath(far)

    dune = QPainterPath()
    dune.moveTo(2, b - 15)
    dune.cubicTo(80, b - 27, 160, b - 6, 240, b - 16)
    dune.cubicTo(300, b - 23, 350, b - 10, W - 2, b - 19)
    dune.lineTo(W - 2, b - 2)
    dune.lineTo(2, b - 2)
    dune.closeSubpath()
    g = QLinearGradient(0, b - 28, 0, b)
    g.setColorAt(0.0, QColor(245, 166, 35, 120))
    g.setColorAt(0.55, QColor(214, 96, 70, 105))
    g.setColorAt(1.0, QColor(110, 62, 120, 120))
    p.setBrush(QBrush(g))
    p.drawPath(dune)

    tx, ty = W - 64, b - 16        # tepenin üstündeki tek ağaç
    p.setBrush(QColor(78, 58, 42, 230))
    p.drawRect(QRectF(tx - 0.9, ty - 7, 1.8, 7))
    p.setBrush(QColor(112, 150, 62, 235))
    p.drawEllipse(QPointF(tx, ty - 11), 5.2, 4.6)
    p.drawEllipse(QPointF(tx - 3, ty - 8.5), 3.3, 3.0)
    p.drawEllipse(QPointF(tx + 3, ty - 8.8), 3.3, 3.0)


