    def _fill_pc_activity(self):
        if self._act_store is None or self._pci is None:
            self.digest_lbl.setText("Hafif arka plan izleyici modülü (pc_izleyici.py) henüz yüklenmedi.")
            return
        pci = self._pci
        machine = self._machine()
        days = self._period_days()
        I = self._item
        try:
            digest = pci.SummaryEngine.build_digest(self._act_store, machine=machine, days=days)
        except Exception as e:
            self.digest_lbl.setText(f"Özet oluşturulamadı: {e}")
            return

        # 1) KPI Kartları
        kpis = digest["kpis"]
        self._kpi_cards["active_str"].setText(kpis["active_str"])
        self._kpi_cards["game_str"].setText(kpis["game_str"])
        self._kpi_cards["top_web"].setText(kpis["top_web"])
        self._kpi_cards["top_ram"].setText(kpis["top_ram"])
        self._kpi_cards["events_count"].setText(
            f"{kpis['installs_count']} kurulum · {kpis['critical_count']} kritik"
        )

        # 2) Doğal Türkçe Özet Metni
        bullets_html = "<br>".join(f"• {b}" for b in digest["bullets"])
        self.digest_lbl.setText(
            f"<div style='line-height:1.45;'><b>{digest['label']} — PC & Oyun Özeti</b><br>{bullets_html}</div>"
        )

        # 3) Özet Sekmesi Alt Tabloları (İlk Uygulamalar + Webler ve Son Olaylar)
        top_rows = []
        for a in digest["apps"][:8]:
            top_rows.append([
                I(a["category"], a["category"], align_right=False),
                I(a["name"], a["name"], align_right=False),
                I(pci.fmt_duration_tr(a["secs"]), a["secs"]),
                I(str(a["visits"]), a["visits"]),
            ])
        for w in digest["webs"][:8]:
            top_rows.append([
                I("🌐 Web", "Web", align_right=False),
                I(w["domain"], w["domain"], align_right=False),
                I(pci.fmt_duration_tr(w["secs"]) if w["secs"] >= 5 else "—", w["secs"]),
                I(str(w["visits"]), w["visits"]),
            ])
        self._fill_table(self.sum_top_tbl, top_rows, (2, Qt.SortOrder.DescendingOrder))

        se_rows = []
        for e in digest["events"][:15]:
            se_rows.append([
                I(_date(e["ts"]), e["ts"], align_right=False),
                I(e["title"], e["title"], align_right=False),
                I(e["detail"] or "", e["detail"] or "", align_right=False),
            ])
        self._fill_table(self.sum_evt_tbl, se_rows, (0, Qt.SortOrder.DescendingOrder))

        # 4) Uygulamalar & Web Sekmesi
        all_apps = self._act_store.top_apps(machine, days, limit=80)
        tot_app_sec = sum(float(a["secs"] or 0) for a in all_apps) or 1.0
        app_rows = []
        for a in all_apps:
            pct = (float(a["secs"] or 0) / tot_app_sec) * 100.0
            app_rows.append([
                I(a["name"], a["name"], align_right=False),
                I(a["category"], a["category"], align_right=False),
                I(pci.fmt_duration_tr(a["secs"]), a["secs"]),
                I(f"%{pct:.1f}", pct),
                I((a["last_title"] or "")[:90], a["last_title"] or "", align_right=False),
            ])
        self._fill_table(self.apps_tbl, app_rows, (2, Qt.SortOrder.DescendingOrder))

        all_webs = self._act_store.top_websites(machine, days, limit=100)
        web_rows = []
        for w in all_webs:
            web_rows.append([
                I(w["domain"], w["domain"], align_right=False),
                I(pci.fmt_duration_tr(w["secs"]) if w["secs"] >= 5 else "—", w["secs"]),
                I(str(w["visits"]), w["visits"]),
                I((w["last_title"] or "")[:90], w["last_title"] or "", align_right=False),
            ])
        self._fill_table(self.web_tbl, web_rows, (1, Qt.SortOrder.DescendingOrder))

        # 5) RAM & GPU Tüketimi Sekmesi
        res_list = self._act_store.top_resources(machine, days, limit=60)
        res_rows = []
        for r in res_list:
            res_rows.append([
                I(r["app"], r["app"], align_right=False),
                I(pci.fmt_mb_tr(r["avg_ram_mb"]), r["avg_ram_mb"] or 0),
                I(pci.fmt_mb_tr(r["max_ram_mb"]), r["max_ram_mb"] or 0),
                I(f"%{r['avg_gpu_pct']:.1f}", r["avg_gpu_pct"] or 0),
                I(f"%{r['max_gpu_pct']:.0f}", r["max_gpu_pct"] or 0),
                I(pci.fmt_mb_tr(r["avg_vram_mb"]), r["avg_vram_mb"] or 0),
                I(pci.fmt_mb_tr(r["max_vram_mb"]), r["max_vram_mb"] or 0),
                I(f"%{r['avg_cpu_pct']:.1f}", r["avg_cpu_pct"] or 0),
                I(str(r["samples"]), r["samples"] or 0),
            ])
        self._fill_table(self.res_tbl, res_rows, (1, Qt.SortOrder.DescendingOrder))
        if res_list:
            top_r = res_list[0]
            top_g = max(res_list, key=lambda x: (x["max_vram_mb"] or 0) + (x["avg_gpu_pct"] or 0) * 50)
            self.res_summary.setText(
                f"{digest['label']} · En yüksek ortalama RAM: {top_r['app']} ({pci.fmt_mb_tr(top_r['avg_ram_mb'])}, "
                f"zirve {pci.fmt_mb_tr(top_r['max_ram_mb'])})   ·   "
                f"En yüksek GPU/VRAM: {top_g['app']} (ort. %{top_g['avg_gpu_pct']:.0f} GPU, zirve {pci.fmt_mb_tr(top_g['max_vram_mb'])} VRAM)"
            )

        # 6) Olaylar Sekmesi
        self._fill_events()

    def _fill_events(self):
        if self._act_store is None:
            return
        machine = self._machine()
        days = self._period_days()
        kind = self.evt_kind_combo.currentData() if hasattr(self, "evt_kind_combo") else "tumu"
        q = self.evt_search.text().strip() if hasattr(self, "evt_search") else ""
        names = self._names()
        I = self._item
        evts = self._act_store.list_events(machine=machine, days=days if days else 3650, kind=kind, search=q, limit=400)
        rows = []
        for e in evts:
            badge = self._EVT_BADGES.get(e["kind"], e["kind"])
            rows.append([
                I(_date(e["ts"]), e["ts"], align_right=False),
                I(names.get(e["machine_id"], e["machine_id"]), e["machine_id"], align_right=False),
                I(badge, badge, align_right=False),
                I(e["title"], e["title"], align_right=False),
                I(e["detail"] or "", e["detail"] or "", align_right=False),
            ])
        self._fill_table(self.evt_tbl, rows, (0, Qt.SortOrder.DescendingOrder))

    def _launch_hud(self):
        import subprocess
        py = sys.executable
        if IS_WIN and py.lower().endswith("python.exe"):
            pyw = py[:-10] + "pythonw.exe"
            if os.path.isfile(pyw):
                py = pyw
        try:
            subprocess.Popen([py, os.path.abspath(__file__), "--hud"], close_fds=True, **_hidden())
        except Exception:
            pass

    def _export_markdown(self):
        from PySide6.QtWidgets import QFileDialog, QMessageBox
        if self._act_store is None or self._pci is None:
            return
        default = os.path.join(os.path.expanduser("~"), time.strftime("pc-aktivite-raporu-%Y-%m-%d.md"))
        path, _ = QFileDialog.getSaveFileName(self, "Meraklısına Verileri Kaydet (.md)", default, "Markdown (*.md)")
        if path:
            md = self._pci.SummaryEngine.to_markdown(self._act_store, machine=self._machine(), days=self._period_days())
            with open(path, "w", encoding="utf-8", newline="\n") as f:
                f.write(md)
            QMessageBox.information(self, "Kaydedildi", f"Meraklısına verileri kaydedildi:\n{path}")

    def closeEvent(self, event):
        if self._act_store is not None:
            try:
                self._act_store.close()
            except Exception:
                pass
            self._act_store = None
        super().closeEvent(event)


