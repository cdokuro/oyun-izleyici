    def _selected_session(self):
        row = self.sess_tbl.currentRow()
        it = self.sess_tbl.item(row, 0) if row >= 0 else None
        if it is None:
            return None
        return (it.data(Qt.ItemDataRole.UserRole + 1), it.data(Qt.ItemDataRole.UserRole + 2), row, it)

    def _edit_note(self, row, col):
        from PySide6.QtWidgets import QInputDialog, QMessageBox
        if col != len(self.SESS_COLS) - 1:
            return
        it = self.sess_tbl.item(row, 0)
        sid, mid = it.data(Qt.ItemDataRole.UserRole + 1), it.data(Qt.ItemDataRole.UserRole + 2)
        if mid != self.store.machine_id:
            QMessageBox.information(self, "Not", "Başka bir PC'nin oturumuna not o PC'den eklenebilir.")
            return
        cur = self.sess_tbl.item(row, col).text()
        text, ok = QInputDialog.getText(self, "Oturum Notu",
                                        "Not (ör. 1440p Ultra, DLSS Kalite, FSR kapalı):", text=cur)
        if ok:
            self.store.set_note(sid, text)
            if self.sync:
                self.sync.request()
            self._fill_sessions()

    def _delete_selected(self):
        from PySide6.QtWidgets import QMessageBox
        sel = self._selected_session() if self.tabs.currentWidget() is self._sess_page else None
        if sel is None:
            QMessageBox.information(self, "Oturum Sil", "Silmek için 'Oturumlar' sekmesinde bir satır seç.")
            return
        sid, mid, row, it = sel
        if mid != self.store.machine_id:
            QMessageBox.information(self, "Oturum Sil", "Başka bir PC'nin oturumu sadece o PC'den silinebilir.")
            return
        game = self.sess_tbl.item(row, 2).text()
        ans = QMessageBox.question(
            self, "Oturumu Sil",
            f"{game} — {it.text()} oturumu silinsin mi?\n\n"
            "Bu oturum toplamlardan ve GitHub'daki kayıttan çıkar. (Yerel yedeklerde ve depo geçmişinde "
            "kopyası durmaya devam eder.)")
        if ans == QMessageBox.StandardButton.Yes:
            self.store.backup_if_needed(force=True)  # silmeden önce taze yedek
            self.store.delete_session(sid)
            if self.sync:
                self.sync.request()
            self.refresh()

