class WinFrameCapture:
    """Windows'ta PresentMon ile sunulan kareleri yakalar ve MangoHud ile AYNI biçimde
    <program>.exe_<tarih>.csv yazar; böylece oturum / filtre / veritabanı kodu hiç değişmeden çalışır.

    - Oyunu otomatik seçer: ≥15 FPS üreten, engelli listede olmayan süreç (ön plandaysa hemen,
      değilse 8 sn kararlı üretince).
    - Her 100 ms'de bir satır yazar (MangoHud ile aynı aralık)."""

    HEADER_INFO = "os,cpu,gpu,ram,kernel,driver,cpuscheduler"
    COLS = ("fps,frametime,cpu_load,cpu_power,gpu_load,cpu_temp,gpu_temp,gpu_core_clock,gpu_mem_clock,"
            "gpu_vram_used,gpu_power,ram_used,swap_used,process_rss,cpu_mhz,elapsed")
    BUCKET_SEC = 0.1
    WINDOW_SEC = 2.0
    START_FPS = 15.0
    BG_START_SEC = 8.0
    STALL_WRITE_SEC = 5.0
    SESSION_NAME = "oyun-izleyici"

    def __init__(self, out_dir, exe_path, telemetry, extra_ignore=()):
        import threading
        self.out_dir, self.exe, self.t = out_dir, exe_path, telemetry
        self.ignore = set(WIN_IGNORED_EXES) | {x.strip().lower() for x in extra_ignore if x and x.strip()}
        self.lock = threading.Lock()
        self.proc = None
        self.status = "başlamadı"
        self.error = None
        self._error_reported = None
        self._stop = False
        self._frames = {}       # pid -> deque[(t, ft_ms)]
        self._names = {}        # pid -> exe adı
        self._last_ts = {}      # pid -> son CPUStartTime (kare süresi sütunu yoksa)
        self._qual_since = {}   # pid -> ilk uygun olduğu an
        self._active = None
        self._bucket = []
        self._live_gpu_busy = deque(maxlen=60)
        self._live_cpu_busy = deque(maxlen=60)
        self._live_disp_lat = deque(maxlen=60)
        self._live_pmode = ""
        self.frames_seen = 0
        self.rows_written = 0
        self.header = None
        os.makedirs(out_dir, exist_ok=True)

    # --- yaşam döngüsü ---
    def start(self):
        import threading
        if not os.path.isfile(self.exe):
            self.status, self.error = "PresentMon yok", f"PresentMon bulunamadı: {self.exe}"
            return False
        self._kill_stale()
        threading.Thread(target=self._reader, daemon=True).start()
        threading.Thread(target=self._ticker, daemon=True).start()
        return True

    def stop(self):
        import subprocess
        self._stop = True
        with self.lock:
            self._close_active()
        try:
            if self.proc and self.proc.poll() is None:
                self.proc.terminate()
        except Exception:
            pass
        # Çıkışta veya güncellemede çekirdek ETW oturumunun yetim kalmasını önle
        if os.path.isfile(self.exe):
            try:
                subprocess.run([self.exe, "--session_name", self.SESSION_NAME, "--terminate_existing_session"],
                               capture_output=True, timeout=3, **_hidden())
            except Exception:
                pass

    def take_error(self):
        """Yeni bir hata oluştuysa metnini bir kez döndürür (bildirim için)."""
        if self.error and self.error != self._error_reported:
            self._error_reported = self.error
            return self.error
        return None

    def _kill_stale(self):
        """Önceki çalıştırmadan kalmış PresentMon'u (aynı dosya yolu) kapat."""
        ps = _win_psutil()
        if not ps:
            return
        mine = os.path.normcase(os.path.abspath(self.exe))
        for p in ps.process_iter(["pid", "exe"]):
            try:
                if p.info["exe"] and os.path.normcase(p.info["exe"]) == mine and p.info["pid"] != os.getpid():
                    p.terminate()
            except Exception:
                continue

    # --- PresentMon çıktısı ---
    def _spawn(self):
        import subprocess
        args = [self.exe, "--session_name", self.SESSION_NAME, "--stop_existing_session",
                "--output_stdout", "--no_console_stats", "--v2_metrics"]
        for n in ("dwm.exe", "explorer.exe", "chrome.exe", "msedge.exe", "firefox.exe", "zen.exe", "radeonsoftware.exe",
                  "amdrsserv.exe", "amdow.exe", "electron.exe", "antigravity.exe", "opencode.exe",
                  "python.exe", "pythonw.exe", "steamwebhelper.exe", "discord.exe", "gameoverlayui.exe", "gamebar.exe"):
            args += ["--exclude", n]
        errlog = open(os.path.join(self.out_dir, "presentmon.log"), "w", encoding="utf-8")
        return subprocess.Popen(args, stdout=subprocess.PIPE, stderr=errlog, text=True, bufsize=1,
                                encoding="utf-8", errors="replace", **_hidden())

    @staticmethod
    def parse_header(parts):
        """Başlık satırından sütun konumları (PresentMon v1 ve v2 uyumlu)."""
        low = [p.strip().lower() for p in parts]
        if "application" not in low or "processid" not in low:
            return None
        idx = {
            "app": low.index("application"), "pid": low.index("processid"),
            "ft": None, "ts": None, "ts_ms": False, "gpu_busy": None, "cpu_busy": None,
            "disp_lat": None, "pmode": None, "dropped": None,
        }
        for key, cands in (
            ("ft", ("frametime", "msbetweenpresents")),
            ("ts", ("cpustarttime", "timeinseconds")),
            ("gpu_busy", ("gpubusy", "msgpuactive", "gputime")),
            ("cpu_busy", ("cpubusy", "msinpresentapi")),
            ("disp_lat", ("displaylatency", "msuntildisplayed")),
            ("pmode", ("presentmode",)),
            ("dropped", ("dropped", "isdropped")),
        ):
            for n in cands:
                if n in low:
                    idx[key] = low.index(n)
                    if key == "ts" and n == "cpustarttime":
                        idx["ts_ms"] = True   # PresentMon v2 CPUStartTime milisaniye cinsindendir
                    break
        return idx

    def _reader(self):
        import csv
        wait = 5
        while not self._stop:
            started = time.monotonic()
            try:
                self.proc = self._spawn()
            except Exception as e:
                self.status, self.error = "hata", f"PresentMon başlatılamadı: {e}"
                time.sleep(30)
                continue
            self.status = "çalışıyor"
            idx = None
            for line in self.proc.stdout:
                if self._stop:
                    return
                line = line.strip()
                if not line:
                    continue
                parts = next(csv.reader([line]))
                if idx is None:
                    idx = self.parse_header(parts)
                    if idx is not None:
                        self.header = line
                        if idx["ft"] is None and idx["ts"] is None:
                            self.error = "PresentMon çıktısında kare süresi sütunu yok: " + line[:160]
                            idx = None
                    continue
                self.on_row(parts, idx)
            if self._stop:
                return
            rc = self.proc.poll()
            tail = ""
            try:
                with open(os.path.join(self.out_dir, "presentmon.log"), encoding="utf-8", errors="replace") as f:
                    tail = " ".join(f.read().split())[-220:]
            except OSError:
                pass
            self.status = "hata"
            self.error = f"PresentMon kapandı (kod {rc}). {tail}".strip()
            wait = 5 if time.monotonic() - started > 30 else min(60, wait * 2)
            time.sleep(wait)

    @staticmethod
    def _is_placeholder_app(name):
        n = (name or "").strip().lower()
        return (not n) or n in ("<unknown>", "unknown", "_unknown_", "<error>", "system", "idle", "registry")

    @staticmethod
    def _query_pid_exe_name(pid):
        """Resolve real .exe basename from PID (Win32 QueryFullProcessImageNameW -> psutil fallback)."""
        if not pid or pid <= 4:
            return ""
        try:
            import ctypes
            from ctypes import wintypes
            k32 = ctypes.windll.kernel32
            k32.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
            k32.OpenProcess.restype = ctypes.c_void_p
            k32.QueryFullProcessImageNameW.argtypes = [ctypes.c_void_p, wintypes.DWORD, wintypes.LPWSTR, ctypes.POINTER(wintypes.DWORD)]
            k32.QueryFullProcessImageNameW.restype = wintypes.BOOL
            k32.CloseHandle.argtypes = [ctypes.c_void_p]
            PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
            h = k32.OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, int(pid))
            if h:
                try:
                    buf = ctypes.create_unicode_buffer(512)
                    sz = wintypes.DWORD(512)
                    if k32.QueryFullProcessImageNameW(h, 0, buf, ctypes.byref(sz)) and buf.value:
                        return os.path.basename(buf.value)
                finally:
                    k32.CloseHandle(h)
        except Exception:
            pass
        ps = _win_psutil()
        if ps:
            try:
                nm = ps.Process(int(pid)).name()
                if nm:
                    return nm
            except Exception:
                pass
        return ""

    def _resolve_pid_name(self, pid, raw_app):
        """Return valid exe name for pid; resolve via OS if PresentMon emitted <unknown>."""
        if not self._is_placeholder_app(raw_app):
            return raw_app
        cached = self._names.get(pid)
        if cached and not self._is_placeholder_app(cached):
            return cached
        resolved = self._query_pid_exe_name(pid)
        return resolved if not self._is_placeholder_app(resolved) else ""

    @staticmethod
    def _pid_rss_mb(pid):
        ps = _win_psutil()
        if not ps:
            return 0.0
        try:
            return ps.Process(int(pid)).memory_info().rss / (1024 * 1024)
        except Exception:
            return 0.0

    def on_row(self, parts, idx):
        """PresentMon'dan gelen tek bir sunulan kare satırı (test edilebilsin diye ayrı)."""
        from collections import deque
        try:
            pid = int(parts[idx["pid"]])
            raw_app = parts[idx["app"]].strip()
        except (ValueError, IndexError):
            return
        if pid <= 4:
            return
        # Düşürülmüş (ekrana çıkmamış) kareleri sayma (sahte FPS sıçramasını önler)
        if idx.get("dropped") is not None and idx["dropped"] < len(parts):
            if parts[idx["dropped"]].strip().lower() in ("1", "true"):
                return
        app = self._resolve_pid_name(pid, raw_app)
        if not app or app.lower() in self.ignore:
            return
        now = time.monotonic()
        ft = None
        frame_ts = None
        try:
            if idx["ts"] is not None:
                frame_ts = float(parts[idx["ts"]])
                if idx.get("ts_ms"):
                    frame_ts /= 1000.0
            if idx["ft"] is not None:
                ft = float(parts[idx["ft"]])
            elif frame_ts is not None:
                prev = self._last_ts.get(pid)
                self._last_ts[pid] = frame_ts
                if prev is not None:
                    ft = (frame_ts - prev) * 1000.0
        except (ValueError, IndexError):
            return
        if ft is None or not (0.8 <= ft <= 5000.0):
            return
        def _opt_float(key):
            i = idx.get(key)
            if i is None or i >= len(parts):
                return None
            try:
                v = float(parts[i])
                return v if 0.0 <= v <= 1000.0 else None
            except ValueError:
                return None
        gb = _opt_float("gpu_busy")
        cb = _opt_float("cpu_busy")
        dl = _opt_float("disp_lat")
        pm = parts[idx["pmode"]].strip() if idx.get("pmode") is not None and idx["pmode"] < len(parts) else ""
        with self.lock:
            self.frames_seen += 1
            self._names[pid] = app
            self._frames.setdefault(pid, deque()).append((now, ft))
            if self._active is not None and self._active["pid"] == pid:
                self._bucket.append((frame_ts if frame_ts is not None else now, ft))
                if gb is not None:
                    self._live_gpu_busy.append(gb)
                if cb is not None:
                    self._live_cpu_busy.append(cb)
                if dl is not None and dl > 0.0:
                    self._live_disp_lat.append(dl)
                if pm:
                    self._live_pmode = pm

    def live_metrics(self):
        with self.lock:
            if self._active is None:
                return None, None, None, ""
            avg = lambda dq: (sum(dq) / len(dq)) if dq else None
            pm = self._live_pmode
            if "Independent Flip" in pm:
                pm = "IND-FLIP"
            elif "Composed: Flip" in pm:
                pm = "COMP-FLIP"
            elif "Flip" in pm:
                pm = "FLIP"
            elif pm:
                pm = pm[:12].upper()
            return avg(self._live_gpu_busy), avg(self._live_cpu_busy), avg(self._live_disp_lat), pm

    # --- 100 ms'lik zamanlayıcı: oyun seçimi + satır yazımı ---
    def _ticker(self):
        while not self._stop:
            time.sleep(self.BUCKET_SEC)
            try:
                self.tick(time.monotonic())
            except Exception as e:
                self.error = f"kare yakalama hatası: {e}"

    @staticmethod
    def _pid_alive(pid):
        ps = _win_psutil()
        return bool(ps and ps.pid_exists(pid))

    def _pick_candidate(self, now, exclude=None):
        fg = windows_foreground_pid()
        best = None
        for pid, dq in self._frames.items():
            if pid == exclude or pid == os.getpid() or pid <= 4:
                continue
            nm = self._names.get(pid, "")
            if self._is_placeholder_app(nm) or nm.lower() in self.ignore or not self._pid_alive(pid):
                continue
            n = sum(1 for ts, _ in dq if now - ts <= self.WINDOW_SEC)
            if n < self.START_FPS * self.WINDOW_SEC:
                self._qual_since.pop(pid, None)
                continue
            since = self._qual_since.setdefault(pid, now)
            is_fg = (pid == fg)
            if not is_fg:
                if now - since < self.BG_START_SEC:
                    continue
                # Arka plandaki küçük araç/katman süreçleri oyunu devralmasın
                if self._pid_rss_mb(pid) < 120.0:
                    continue
            score = (1 if is_fg else 0, n)
            if best is None or score > best[0]:
                best = (score, pid)
        return best[1] if best else None

    def tick(self, now):
        with self.lock:
            for pid in list(self._frames):                      # eski kareleri ve ölü süreçleri temizle
                dq = self._frames[pid]
                while dq and now - dq[0][0] > 4.0:
                    dq.popleft()
                if not dq:
                    del self._frames[pid]
                    self._qual_since.pop(pid, None)
            act = self._active
            if act is not None:
                if not self._pid_alive(act["pid"]):
                    self._frames.pop(act["pid"], None)           # ölü sürecin kalan kareleri yeni oturum açmasın
                    self._qual_since.pop(act["pid"], None)
                    self._close_active()
                    act = None
                elif now - act["last_frame"] > self.STALL_WRITE_SEC and self._pick_candidate(now, act["pid"]):
                    self._close_active()                         # başka bir oyun devraldı
                    act = None
            if act is None:
                cand = self._pick_candidate(now)
                if cand is not None:
                    act = self._open(cand, now)
            if act is not None:
                self._write_bucket(act, now)

    def _open(self, pid, now):
        name = self._names.get(pid, "oyun.exe")
        safe = re.sub(r'[<>:"/\\|?*\s,]+', "_", name) or "oyun.exe"
        path = os.path.join(self.out_dir, f"{safe}_{time.strftime('%Y-%m-%d_%H-%M-%S')}.csv")
        fh = open(path, "w", encoding="utf-8", newline="\n")
        t = self.t
        clean = lambda s: str(s or "").replace(",", " ")
        fh.write(self.HEADER_INFO + "\n")
        fh.write(",".join(["Windows", clean(getattr(t, "cpu_name", "")), clean(getattr(t, "gpu_name", "")),
                           str(int(getattr(t, "ram_total_gb", 0) * 1048576)), "", "", ""]) + "\n")
        fh.write(self.COLS + "\n")
        fh.flush()
        self._bucket = []
        self._active = {"pid": pid, "name": name, "path": path, "fh": fh, "start": now,
                        "last_frame": now, "last_ft": 16.7, "n": 0}
        return self._active

    def _close_active(self):
        act, self._active = self._active, None
        self._bucket = []
        self._live_gpu_busy.clear()
        self._live_cpu_busy.clear()
        self._live_disp_lat.clear()
        self._live_pmode = ""
        if act:
            try:
                act["fh"].close()
            except OSError:
                pass

    def _write_bucket(self, act, now):
        b, self._bucket = self._bucket, []
        if not b:
            # PresentMon stdout'u boruda 4 KB tamponlar (~0.4-1 sn'de bir toplu gelir);
            # bos tiklerde sahte dusuk FPS satiri yazma.
            return
        # Toplu gelen kareleri PresentMon'un gercek zaman damgasina gore 100 ms dilimlere ayir
        bins = []
        cur_bin = None
        cur_fts = []
        for ts, ft in b:
            bid = int(ts / self.BUCKET_SEC)
            if cur_bin is None or bid != cur_bin:
                if cur_fts:
                    bins.append(cur_fts)
                cur_bin = bid
                cur_fts = [ft]
            else:
                cur_fts.append(ft)
        if cur_fts:
            bins.append(cur_fts)

        t = self.t
        v = lambda x: 0 if x is None else x
        lines = []
        last_ft = act["last_ft"]
        for fts in bins:
            if len(fts) >= 4:
                s_fts = sorted(fts)[1:-1]  # tek karelik uç sapmaları (glitch) kırp
                ft = sum(s_fts) / len(s_fts)
            else:
                ft = sum(fts) / len(fts)
            last_ft = ft
            fps = min(1000.0, max(1.0, 1000.0 / ft))
            row = [f"{fps:.3f}", f"{ft:.3f}", v(getattr(t, "cpu_load", 0)), v(getattr(t, "cpu_watt", 0)),
                   v(getattr(t, "gpu_load", 0)), v(getattr(t, "cpu_temp", 0)), v(getattr(t, "gpu_temp", 0)),
                   v(getattr(t, "gpu_mhz", 0)), 0, f"{v(getattr(t, 'vram_used_mb', 0)) / 1024.0:.3f}",
                   v(getattr(t, "gpu_watt", 0)), f"{v(getattr(t, 'ram_used_gb', 0)):.3f}", 0, 0,
                   int(v(getattr(t, "cpu_ghz", 0)) * 1000), int((now - act["start"]) * 1e9)]
            lines.append(",".join(str(x) for x in row) + "\n")
        act["last_frame"], act["last_ft"] = now, last_ft
        try:
            act["fh"].writelines(lines)
            act["fh"].flush()
            act["n"] += len(lines)
            self.rows_written += len(lines)
        except OSError:
            self._close_active()


def cleanup_old_logs(directory, days=3):
    """Windows'ta /tmp gibi kendiliğinden temizlenen bir klasör yok: eski kayıt dosyalarını sil."""
    cutoff = time.time() - days * 86400
    for path in glob.glob(os.path.join(directory, "*.csv")):
        try:
            if os.path.getmtime(path) < cutoff:
                os.remove(path)
        except OSError:
            pass


