class _Stat:
    """Ortalama + maksimum için hafif sayaç (0 = sensör yok, sayılmaz)."""
    __slots__ = ("s", "n", "mx")

    def __init__(self):
        self.s = 0.0
        self.n = 0
        self.mx = None

    def add(self, v):
        if v is None or v <= 0:
            return
        self.s += v
        self.n += 1
        self.mx = v if self.mx is None else max(self.mx, v)

    def avg(self):
        return self.s / self.n if self.n else None


class SessionAccumulator:
    """Bir oyun oturumunun tüm satırlarını toplayıp menü/yükleme ekranı anomalilerini ayıklayarak özet çıkarır."""

    def __init__(self, log_path):
        from array import array
        self.log_file = os.path.basename(log_path)
        self.game = game_name_from_log(log_path)
        self.start_ts = start_ts_from_log(log_path)
        self.fps = array("f")
        self.active_fps = array("f")   # sadece gerçek 3D oyun yükündeki kareler (menü / yükleme ekranı hariç)
        self.ft = _Stat()
        self.active_ft = _Stat()
        self.last_elapsed = None
        # MangoHud logundan gelen sensörler
        self.log_hw = {k: _Stat() for k in ("gpu_temp", "cpu_temp", "gpu_power", "cpu_power", "vram")}
        # Panelin kendi okumaları (log sütunu boşsa yedek olarak + derin telemetri)
        self.panel_hw = {k: _Stat() for k in (
            "gpu_temp", "cpu_temp", "gpu_power", "cpu_power", "vram",
            "gpu_hotspot", "gpu_mem_temp", "disp_lat", "ping",
        )}
        self.ac_samples = 0       # priz/pil örnekleri (sadece laptoplarda)
        self.ac_on = 0
        self._low_run = []        # şu an süren <15 FPS serisi (yükleme mi takılma mı: seri bitince belli olur)
        self._low_run_n = 0
        self.stutters = 0         # ani kare takılması sayısı (>25 ms ve ortalamanın >=2.2x)
        self.resolution = None    # aktif ekran çözünürlüğü + Hz (ör. 2560x1440@180Hz)
        self._tl_points = []      # 10 sn'lik oturum zaman çizelgesi: [[sec, fps, gpu_c, cpu_c, gpu_w], ...]
        self._tl_last_bucket = -1
        self._tl_fps_sum = 0.0
        self._tl_fps_n = 0

    def _flush_low_run(self):
        if 0 < self._low_run_n < self.LOAD_RUN_ROWS:
            for lf, lft in self._low_run:
                self.active_fps.append(lf)
                self.active_ft.add(lft)
        self._low_run, self._low_run_n = [], 0

    LOW_FPS_FLOOR = 15.0     # bunun altındaki kareler: tek tek takılma, uzun süre kalırsa yükleme ekranı
    LOAD_RUN_ROWS = 20       # 100 ms'lik 20 satır = 2 sn: bu kadar süren <15 FPS serisi yükleme ekranıdır

    @staticmethod
    def drop_load_runs(values):
        """Sırayla verilen FPS listesinden, >=2 sn süren <15 FPS serilerini (yükleme ekranı) çıkarır.
        Daha kısa düşüşler gerçek takılmadır: 1% / 0.1% low'a girmeleri gerekir."""
        out, run = [], []
        for v in values:
            if v < SessionAccumulator.LOW_FPS_FLOOR:
                run.append(v)
                continue
            if run and len(run) < SessionAccumulator.LOAD_RUN_ROWS:
                out.extend(run)
            run = []
            out.append(v)
        if run and len(run) < SessionAccumulator.LOAD_RUN_ROWS:
            out.extend(run)
        return out

    @staticmethod
    def is_gameplay_frame(fps, gpu_power=None, gpu_load=None):
        """Menüdeki 800-2000 FPS patlamalarını filtreler (düşük FPS'e dokunmaz: takılmalar korunur)."""
        if fps > 720.0:
            return False
        # Ekran kartı boştayken (<38W ve <%25 yük) çok yüksek FPS üretiyorsa 2D menü/intro ekranıdır
        if fps > 240.0 and gpu_power is not None and 0 < gpu_power < 38.0 and (gpu_load is None or gpu_load < 25.0):
            return False
        return True

    def add(self, rec):
        f = rec["fps"]
        ft = rec.get("frametime")
        gw = rec.get("gpu_power")
        gl = rec.get("gpu_load")
        self.fps.append(f)
        self.ft.add(ft)
        if f < self.LOW_FPS_FLOOR:
            self._low_run_n += 1
            if self._low_run_n <= self.LOAD_RUN_ROWS:
                self._low_run.append((f, ft))
        else:
            self._flush_low_run()
            if self.is_gameplay_frame(f, gw, gl):
                # Gerçek 3D oyunda ani frametime sıçraması (>25ms ve çalışan ortalamanın 2.2 katı) -> takılma
                if ft is not None and self.active_ft.n >= 20:
                    avg_so_far = self.active_ft.avg() or 16.7
                    if ft > max(25.0, avg_so_far * 2.2) and ft < 1500.0:
                        self.stutters += 1
                self.active_fps.append(f)
                self.active_ft.add(ft)
                self._tl_fps_sum += f
                self._tl_fps_n += 1
        if rec.get("elapsed"):
            self.last_elapsed = rec["elapsed"]
        self.log_hw["gpu_temp"].add(rec.get("gpu_temp"))
        self.log_hw["cpu_temp"].add(rec.get("cpu_temp"))
        self.log_hw["gpu_power"].add(gw)
        self.log_hw["cpu_power"].add(rec.get("cpu_power"))
        v = rec.get("gpu_vram_used")
        self.log_hw["vram"].add(v * 1024.0 if v else None)  # GB -> MB

    def add_panel_sample(self, t):
        self.panel_hw["gpu_temp"].add(t.gpu_temp)
        self.panel_hw["cpu_temp"].add(t.cpu_temp)
        self.panel_hw["gpu_power"].add(t.gpu_watt)
        self.panel_hw["cpu_power"].add(t.cpu_watt)
        self.panel_hw["vram"].add(t.vram_used_mb)
        self.panel_hw["gpu_hotspot"].add(getattr(t, "gpu_hotspot", None))
        self.panel_hw["gpu_mem_temp"].add(getattr(t, "gpu_mem_temp", None))
        self.panel_hw["disp_lat"].add(getattr(t, "disp_lat_ms", None))
        self.panel_hw["ping"].add(getattr(t, "ping_ms", None))
        if not self.resolution and getattr(t, "display_mode", None):
            self.resolution = t.display_mode
        if t.on_ac is not None:
            self.ac_samples += 1
            self.ac_on += 1 if t.on_ac else 0
        # Her 10 saniyede bir hafif zaman çizelgesi noktası kaydet (oturum grafiği için)
        sec = int(self.duration())
        bucket = sec // 10
        if bucket > self._tl_last_bucket and (self._tl_fps_n > 0 or t.fps is not None):
            self._tl_last_bucket = bucket
            fps_val = round(self._tl_fps_sum / self._tl_fps_n, 1) if self._tl_fps_n else (t.fps or 0)
            self._tl_fps_sum = 0.0
            self._tl_fps_n = 0
            self._tl_points.append([
                sec,
                fps_val,
                int(t.gpu_temp) if t.gpu_temp is not None else None,
                int(t.cpu_temp) if t.cpu_temp is not None else None,
                int(t.gpu_watt) if t.gpu_watt is not None else None,
            ])
            # Çok uzun oturumlarda bellek/senkron boyutunu küçük tut (~240 nokta max)
            if len(self._tl_points) > 360:
                self._tl_points = self._tl_points[::2]

    def duration(self):
        if self.last_elapsed:
            return self.last_elapsed / 1e9
        return len(self.fps) * 0.1

    def _hw(self, key):
        st = self.log_hw[key] if self.log_hw[key].n else self.panel_hw[key]
        return st.avg(), st.mx

    @staticmethod
    def filter_menu_outliers(sorted_vals):
        """Sıralı FPS listesinden menü patlamalarını (medyanın 1.65 katını aşan üst kuyruk) keser.
        Alt uca dokunmaz: gerçek takılmalar 1% / 0.1% low'da görünmeli."""
        m = len(sorted_vals)
        if m < 30:
            return sorted_vals
        median = sorted_vals[m // 2]
        p90 = sorted_vals[int(m * 0.90)]
        upper_cap = min(720.0, max(median * 1.65, p90 * 1.18))
        trimmed = [v for v in sorted_vals if v <= upper_cap]
        return trimmed if len(trimmed) >= max(10, m // 4) else sorted_vals

    def result(self):
        n_total = len(self.fps)
        if n_total == 0:
            return None
        pending = [lf for lf, _ in self._low_run] if 0 < self._low_run_n < self.LOAD_RUN_ROWS else []
        active = list(self.active_fps) + pending     # süren kısa düşüş de takılmadır
        base_pool = active if len(active) >= max(20, n_total // 5) else self.fps
        vals = self.filter_menu_outliers(sorted(base_pool))
        n = len(vals)
        n1 = max(1, n // 100)
        n01 = max(1, n // 1000)
        dur = self.duration()
        gt_avg, gt_max = self._hw("gpu_temp")
        ct_avg, ct_max = self._hw("cpu_temp")
        gw_avg, _ = self._hw("gpu_power")
        cw_avg, _ = self._hw("cpu_power")
        _, vram_max = self._hw("vram")
        _, hs_max = self.panel_hw["gpu_hotspot"].avg(), self.panel_hw["gpu_hotspot"].mx
        _, gmem_max = self.panel_hw["gpu_mem_temp"].avg(), self.panel_hw["gpu_mem_temp"].mx
        dlat_avg = self.panel_hw["disp_lat"].avg()
        ping_avg = self.panel_hw["ping"].avg()
        avg_ft = self.active_ft.avg() if self.active_ft.n >= 20 else self.ft.avg()
        import json as _json
        tl_json = _json.dumps(self._tl_points, separators=(",", ":")) if len(self._tl_points) >= 2 else None
        return {
            "log_file": self.log_file,
            "game": self.game,
            "start_ts": self.start_ts,
            "end_ts": self.start_ts + dur,
            "duration_s": dur,
            "avg_fps": sum(vals) / n,
            "low1": sum(vals[:n1]) / n1,
            "low01": sum(vals[:n01]) / n01,
            "max_fps": vals[-1],
            "avg_ft": avg_ft,
            "gpu_temp_avg": gt_avg, "gpu_temp_max": gt_max,
            "cpu_temp_avg": ct_avg, "cpu_temp_max": ct_max,
            "gpu_w_avg": gw_avg, "cpu_w_avg": cw_avg,
            "vram_max_mb": vram_max,
            "samples": n_total,
            "ac_ratio": (self.ac_on / self.ac_samples) if self.ac_samples else None,
            "gpu_hotspot_max": hs_max,
            "gpu_mem_temp_max": gmem_max,
            "stutters": self.stutters,
            "disp_lat_avg": dlat_avg,
            "ping_avg": ping_avg,
            "resolution": self.resolution,
            "timeline": tl_json,
        }

    @classmethod
    def from_file(cls, path):
        acc = cls(path)
        colmap = None
        with open(path, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                if colmap is None:
                    colmap = header_columns(line)
                    continue
                rec = parse_row(line, colmap)
                if rec:
                    acc.add(rec)
        return acc


class SessionStore:
    """Kalıcı kayıt: ~/.local/share/oyun-izleyici/oyunlar.db (+ günlük yedekler).

    Her satırın bir machine_id'si vardır. Bu PC'nin oturumları burada üretilir; diğer PC'lerinkiler
    GitHub deposundan gelir ve sadece okunur.
    """

    SESSION_FIELDS = ("log_file", "game", "start_ts", "end_ts", "duration_s", "avg_fps", "low1",
                      "low01", "max_fps", "avg_ft", "gpu_temp_avg", "gpu_temp_max", "cpu_temp_avg",
                      "cpu_temp_max", "gpu_w_avg", "cpu_w_avg", "vram_max_mb", "samples", "ac_ratio",
                      "gpu_hotspot_max", "gpu_mem_temp_max", "stutters", "disp_lat_avg", "ping_avg",
                      "resolution", "timeline")
    SYNC_FIELDS = SESSION_FIELDS + ("note",)

    def __init__(self, machine_id, path=DB_PATH):
        import sqlite3
        self.sqlite3 = sqlite3
        self.machine_id = machine_id
        self.path = path
        self.recovered_from = None
        self.changed_since_sync = True
        os.makedirs(os.path.dirname(path), exist_ok=True)
        os.makedirs(BACKUP_DIR, exist_ok=True)
        self.db = self._open_checked()
        self._init_schema()
        self.backup_if_needed()

    def _connect(self):
        db = self.sqlite3.connect(self.path, timeout=10)
        db.row_factory = self.sqlite3.Row
        db.execute("PRAGMA journal_mode=WAL")
        db.execute("PRAGMA synchronous=FULL")
        return db

    def _open_checked(self):
        """Veritabanı bozuksa kenara alır ve en son yedekten geri yükler."""
        if os.path.exists(self.path):
            try:
                db = self._connect()
                ok = db.execute("PRAGMA quick_check").fetchone()[0]
                if ok == "ok":
                    return db
                db.close()
            except self.sqlite3.DatabaseError:
                pass
            stamp = time.strftime("%Y%m%d-%H%M%S")
            for suffix in ("", "-wal", "-shm"):
                if os.path.exists(self.path + suffix):
                    os.replace(self.path + suffix, f"{self.path}.bozuk-{stamp}{suffix}")
            backups = self.list_backups()
            if backups:
                import shutil
                shutil.copy2(backups[-1], self.path)
                self.recovered_from = backups[-1]
        return self._connect()

    _SESSIONS_DDL = """
        CREATE TABLE IF NOT EXISTS sessions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            machine_id TEXT NOT NULL,
            log_file TEXT NOT NULL,
            game TEXT NOT NULL,
            start_ts REAL, end_ts REAL, duration_s REAL,
            finished INTEGER NOT NULL DEFAULT 0,
            avg_fps REAL, low1 REAL, low01 REAL, max_fps REAL, avg_ft REAL,
            gpu_temp_avg REAL, gpu_temp_max REAL, cpu_temp_avg REAL, cpu_temp_max REAL,
            gpu_w_avg REAL, cpu_w_avg REAL, vram_max_mb REAL, samples INTEGER,
            ac_ratio REAL, note TEXT,
            gpu_hotspot_max REAL, gpu_mem_temp_max REAL, stutters INTEGER,
            disp_lat_avg REAL, ping_avg REAL, resolution TEXT, timeline TEXT,
            UNIQUE(machine_id, log_file)
        )"""

    _V3_COLUMNS = (
        ("gpu_hotspot_max", "REAL"),
        ("gpu_mem_temp_max", "REAL"),
        ("stutters", "INTEGER"),
        ("disp_lat_avg", "REAL"),
        ("ping_avg", "REAL"),
        ("resolution", "TEXT"),
        ("timeline", "TEXT"),
    )

    def _init_schema(self):
        ver = self.db.execute("PRAGMA user_version").fetchone()[0]
        with self.db:
            if ver == 1:
                # v1 -> v2: makine kimliği, not ve priz/pil sütunları (eski satırlar bu PC'nindir)
                self.backup_if_needed(force=True)
                self.db.execute("ALTER TABLE sessions RENAME TO sessions_v1")
                self.db.execute(self._SESSIONS_DDL)
                old_cols = [r[1] for r in self.db.execute("PRAGMA table_info(sessions_v1)")]
                keep = [c for c in old_cols if c != "id"]
                self.db.execute(
                    f"INSERT INTO sessions (machine_id, {', '.join(keep)}) "
                    f"SELECT ?, {', '.join(keep)} FROM sessions_v1", (self.machine_id,))
                self.db.execute("DROP TABLE sessions_v1")
            self.db.execute(self._SESSIONS_DDL)
            # v2 -> v3: derin telemetri ve oturum zaman çizelgesi sütunları (veri kaybı olmadan eklenir)
            existing = {r[1] for r in self.db.execute("PRAGMA table_info(sessions)")}
            for col, typ in self._V3_COLUMNS:
                if col not in existing:
                    self.db.execute(f"ALTER TABLE sessions ADD COLUMN {col} {typ}")
            self.db.execute("CREATE INDEX IF NOT EXISTS idx_sessions_game ON sessions(game)")
            self.db.execute("CREATE INDEX IF NOT EXISTS idx_sessions_machine ON sessions(machine_id)")
            # Kısa açılışlar / silinen oturumlar (bu PC): tekrar içe aktarılmasın diye
            self.db.execute("""
                CREATE TABLE IF NOT EXISTS ignored_logs (
                    log_file TEXT PRIMARY KEY, reason TEXT, ts REAL
                )""")
            self.db.execute("""
                CREATE TABLE IF NOT EXISTS machines (
                    machine_id TEXT PRIMARY KEY, name TEXT, gpu TEXT, cpu TEXT, ram TEXT,
                    os TEXT, has_battery INTEGER
                )""")
            if ver < 3:
                self.db.execute("PRAGMA user_version=3")
            # Mevcut oturumlardaki birleşik oyun adlarını (ör. DOOMTHEDARKAGES) log dosya adından veya sözlükten düzelt
            for r in self.db.execute("SELECT id, game, log_file FROM sessions").fetchall():
                nice = game_name_from_log(r["log_file"]) if r["log_file"] else format_game_title(r["game"])
                if nice and nice != r["game"]:
                    self.db.execute("UPDATE sessions SET game=? WHERE id=?", (nice, r["id"]))
                    self.changed_since_sync = True

    # --- yazma ---
    def upsert(self, res, finished):
        cols = ["machine_id"] + list(self.SESSION_FIELDS) + ["finished"]
        vals = [self.machine_id] + [res.get(c) for c in self.SESSION_FIELDS] + [1 if finished else 0]
        updates = ", ".join(f"{c}=excluded.{c}" for c in cols if c not in ("machine_id", "log_file"))
        with self.db:
            self.db.execute(
                f"INSERT INTO sessions ({', '.join(cols)}) VALUES ({', '.join('?' * len(cols))}) "
                f"ON CONFLICT(machine_id, log_file) DO UPDATE SET {updates}", vals)
        if finished:
            self.changed_since_sync = True
        try:
            self.backup_if_needed(refresh=True)  # bugünün yedeği her kayıttan sonra güncel
        except Exception as e:
            print(f"[oyun-izleyici] yedek hatası: {e}", file=sys.stderr)

    def ignore(self, log_file, reason):
        with self.db:
            self.db.execute("INSERT OR REPLACE INTO ignored_logs VALUES (?, ?, ?)",
                            (log_file, reason, time.time()))

    def delete_session(self, session_id):
        row = self.db.execute("SELECT log_file FROM sessions WHERE id=? AND machine_id=?",
                              (session_id, self.machine_id)).fetchone()
        if not row:
            return False
        with self.db:
            self.db.execute("DELETE FROM sessions WHERE id=?", (session_id,))
            self.db.execute("INSERT OR REPLACE INTO ignored_logs VALUES (?, ?, ?)",
                            (row["log_file"], "kullanıcı sildi", time.time()))
        self.changed_since_sync = True
        self.backup_if_needed(refresh=True)
        return True

    def set_note(self, session_id, note):
        with self.db:
            cur = self.db.execute("UPDATE sessions SET note=? WHERE id=? AND machine_id=?",
                                  (note.strip() or None, session_id, self.machine_id))
        self.changed_since_sync = True
        self.backup_if_needed(refresh=True)
        return cur.rowcount > 0

    def finish_orphans(self, existing_logs, live_log):
        """Log dosyası artık olmayan (ör. yeniden başlatma) yarım oturumları son ara kayıtla kapatır."""
        with self.db:
            for r in self.db.execute("SELECT id, log_file FROM sessions WHERE finished=0 AND machine_id=?",
                                     (self.machine_id,)).fetchall():
                if r["log_file"] != live_log and r["log_file"] not in existing_logs:
                    self.db.execute("UPDATE sessions SET finished=1 WHERE id=?", (r["id"],))
                    self.changed_since_sync = True

    def upsert_machine(self, mid, info):
        with self.db:
            self.db.execute("INSERT OR REPLACE INTO machines VALUES (?, ?, ?, ?, ?, ?, ?)",
                            (mid, info.get("name") or mid, info.get("gpu"), info.get("cpu"),
                             info.get("ram"), info.get("os"), 1 if info.get("has_battery") else 0))

    def replace_machine_sessions(self, mid, rows):
        """Başka bir PC'nin oturumlarını depodaki haliyle değiştirir (tek işlemde)."""
        cols = ["machine_id"] + list(self.SYNC_FIELDS) + ["finished"]
        with self.db:
            self.db.execute("DELETE FROM sessions WHERE machine_id=?", (mid,))
            for r in rows:
                self.db.execute(f"INSERT OR REPLACE INTO sessions ({', '.join(cols)}) "
                                f"VALUES ({', '.join('?' * len(cols))})",
                                [mid] + [r.get(c) for c in self.SYNC_FIELDS] + [1])

    def restore_own_sessions(self, rows):
        """Bu PC'nin depodaki kayıtlarından yerelde olmayanları geri yükler (kurulum sıfırlansa bile)."""
        cols = ["machine_id"] + list(self.SYNC_FIELDS) + ["finished"]
        added = 0
        with self.db:
            for r in rows:
                lf = r.get("log_file")
                if not lf or self.db.execute("SELECT 1 FROM ignored_logs WHERE log_file=?", (lf,)).fetchone():
                    continue
                cur = self.db.execute(f"INSERT OR IGNORE INTO sessions ({', '.join(cols)}) "
                                      f"VALUES ({', '.join('?' * len(cols))})",
                                      [self.machine_id] + [r.get(c) for c in self.SYNC_FIELDS] + [1])
                added += cur.rowcount
        return added

    # --- okuma ---
    def is_done(self, log_file):
        r = self.db.execute("SELECT 1 FROM sessions WHERE log_file=? AND machine_id=? AND finished=1 "
                            "UNION SELECT 1 FROM ignored_logs WHERE log_file=?",
                            (log_file, self.machine_id, log_file)).fetchone()
        return r is not None

    def own_finished_sessions(self):
        return self.db.execute("SELECT * FROM sessions WHERE machine_id=? AND finished=1 ORDER BY start_ts",
                               (self.machine_id,)).fetchall()

    def machines(self):
        rows = {r["machine_id"]: dict(r) for r in self.db.execute("SELECT * FROM machines")}
        for r in self.db.execute("SELECT DISTINCT machine_id FROM sessions"):
            rows.setdefault(r["machine_id"], {"machine_id": r["machine_id"], "name": r["machine_id"]})
        rows.setdefault(self.machine_id, {"machine_id": self.machine_id, "name": self.machine_id})
        return sorted(rows.values(), key=lambda m: (m["machine_id"] != self.machine_id, m["name"] or ""))

    @staticmethod
    def _where(machine=None, game=None, ac_only=False):
        conds, args = [], []
        if machine:
            conds.append("machine_id=?")
            args.append(machine)
        if game:
            conds.append("game=?")
            args.append(game)
        if ac_only:
            conds.append("(ac_ratio IS NULL OR ac_ratio >= 0.9)")
        return (" WHERE " + " AND ".join(conds)) if conds else "", args

    def totals(self, machine=None):
        w, a = self._where(machine)
        return self.db.execute("SELECT COUNT(DISTINCT game) AS games, COUNT(*) AS sessions, "
                               f"COALESCE(SUM(duration_s),0) AS secs FROM sessions{w}", a).fetchone()

    def game_totals(self, machine=None, ac_only=False):
        w, a = self._where(machine, ac_only=ac_only)
        return self.db.execute(f"""
            SELECT game, COUNT(*) AS sessions, SUM(duration_s) AS secs,
                   SUM(avg_fps*duration_s)/SUM(duration_s) AS avg_fps,
                   SUM(low1*duration_s)/SUM(duration_s) AS low1,
                   SUM(low01*duration_s)/SUM(duration_s) AS low01,
                   MAX(avg_fps) AS best_avg, MIN(low01) AS worst_low01,
                   SUM(gpu_temp_avg*duration_s)/SUM(CASE WHEN gpu_temp_avg IS NULL THEN 0 ELSE duration_s END) AS gpu_temp_avg,
                   SUM(gpu_w_avg*duration_s)/SUM(CASE WHEN gpu_w_avg IS NULL THEN 0 ELSE duration_s END) AS gpu_w_avg,
                   SUM(cpu_temp_avg*duration_s)/SUM(CASE WHEN cpu_temp_avg IS NULL THEN 0 ELSE duration_s END) AS cpu_temp_avg,
                   MAX(gpu_temp_max) AS gpu_temp_max, MAX(cpu_temp_max) AS cpu_temp_max,
                   MAX(gpu_hotspot_max) AS gpu_hotspot_max,
                   MAX(gpu_mem_temp_max) AS gpu_mem_temp_max,
                   SUM(COALESCE(stutters, 0)) AS stutters,
                   AVG(disp_lat_avg) AS disp_lat_avg,
                   AVG(ping_avg) AS ping_avg,
                   MAX(vram_max_mb) AS vram_max_mb,
                   MIN(start_ts) AS first_ts, MAX(end_ts) AS last_ts
            FROM sessions{w} GROUP BY game ORDER BY secs DESC""", a).fetchall()

    def game_total(self, game, machine=None):
        for r in self.game_totals(machine):
            if r["game"] == game:
                return r
        return None

    def game_past_seconds(self, game, machine=None, exclude_log=None):
        """Bu PC'de belirtilen oyunun mevcut aktif log hariç toplam oynama süresi (saniye)."""
        if not game:
            return 0.0
        mid = machine or self.machine_id
        ex = os.path.basename(exclude_log) if exclude_log else ""
        if ex:
            row = self.db.execute(
                "SELECT COALESCE(SUM(duration_s), 0) FROM sessions WHERE machine_id=? AND LOWER(game)=LOWER(?) AND log_file<>?",
                (mid, game, ex),
            ).fetchone()
        else:
            row = self.db.execute(
                "SELECT COALESCE(SUM(duration_s), 0) FROM sessions WHERE machine_id=? AND LOWER(game)=LOWER(?)",
                (mid, game),
            ).fetchone()
        return float(row[0] or 0.0) if row else 0.0

    def sessions(self, game=None, machine=None):
        w, a = self._where(machine, game)
        return self.db.execute(f"SELECT * FROM sessions{w} ORDER BY start_ts DESC", a).fetchall()

    # --- güvenlik ---
    def list_backups(self):
        return sorted(glob.glob(os.path.join(BACKUP_DIR, "oyunlar-*.db")))

    def backup_if_needed(self, force=False, refresh=False):
        """force: zaman damgalı ek yedek; refresh: bugünün yedeğini güncel hale getir."""
        stamp = "%Y-%m-%d_%H%M%S" if force else "%Y-%m-%d"
        target = os.path.join(BACKUP_DIR, time.strftime(f"oyunlar-{stamp}.db"))
        if os.path.exists(target) and not (force or refresh):
            return
        tmp = target + ".tmp"
        dst = self.sqlite3.connect(tmp)
        try:
            self.db.backup(dst)
        finally:
            dst.close()
        os.replace(tmp, target)  # yarım yedek asla gerçek yedeğin yerine geçmez
        for old in self.list_backups()[:-BACKUP_KEEP]:
            try:
                os.remove(old)
            except OSError:
                pass

    def export_csv(self, out_path):
        import csv
        names = {m["machine_id"]: m["name"] for m in self.machines()}
        rows = self.sessions()
        with open(out_path, "w", newline="", encoding="utf-8") as f:
            w = csv.writer(f)
            w.writerow(["pc", "oyun", "baslangic", "bitis", "sure_dk", "ort_fps", "low_1", "low_0.1",
                        "maks_fps", "ort_frametime_ms", "gpu_c_ort", "gpu_c_maks", "gpu_hotspot_maks",
                        "gpu_vram_c_maks", "cpu_c_ort", "cpu_c_maks", "gpu_w_ort", "cpu_w_ort",
                        "vram_maks_mb", "takilma", "gecikme_ms", "ping_ms", "cozunurluk",
                        "prizde_oran", "not", "log"])
            for r in rows:
                def n(v, d=1):
                    return "" if v is None else round(v, d)
                w.writerow([names.get(r["machine_id"], r["machine_id"]), r["game"],
                            time.strftime("%Y-%m-%d %H:%M", time.localtime(r["start_ts"])),
                            time.strftime("%Y-%m-%d %H:%M", time.localtime(r["end_ts"])),
                            n(r["duration_s"] / 60), n(r["avg_fps"]), n(r["low1"]), n(r["low01"]),
                            n(r["max_fps"]), n(r["avg_ft"], 2), n(r["gpu_temp_avg"]), n(r["gpu_temp_max"]),
                            n(r["gpu_hotspot_max"]), n(r["gpu_mem_temp_max"]),
                            n(r["cpu_temp_avg"]), n(r["cpu_temp_max"]), n(r["gpu_w_avg"]),
                            n(r["cpu_w_avg"]), n(r["vram_max_mb"], 0),
                            "" if r["stutters"] is None else r["stutters"],
                            n(r["disp_lat_avg"], 1), n(r["ping_avg"], 0), r["resolution"] or "",
                            n(r["ac_ratio"], 2), r["note"] or "", r["log_file"]])


