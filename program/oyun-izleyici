                                    f"Depoya erişilemedi:\n{e}\n\n"
                                    "Depo adını ve token yetkisini (Contents: Read & Write) kontrol et.")

        def _connect_ssh():
            slug = normalize_repo_slug(repo_in.text())
            if not slug:
                QMessageBox.warning(dlg, "Depo Adı", "Geçerli bir depo adı gir (ör. cdokuro/oyun-kayitlari).")
                return
            if not git_exe:
                QMessageBox.warning(dlg, "Git Yok", "Git bulunamadı. 'GitHub Token' sekmesini kullanabilirsin.")
                return
            try:
                key, pub_txt = ensure_ssh_key()
                pub_box.setPlainText(pub_txt)
            except Exception as e:
                QMessageBox.warning(dlg, "SSH Anahtarı", str(e))
                return
            key_fwd = key.replace("\\", "/")
            ssh_cmd = f'ssh -i "{key_fwd}" -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new'
            env = dict(os.environ, GIT_SSH_COMMAND=ssh_cmd, GIT_TERMINAL_PROMPT="0")
            status_lbl.setText("SSH ile depo bağlanıyor…")
            QApplication.processEvents()
            try:
                if os.path.isdir(os.path.join(REPO_DIR, ".git")):
                    p = subprocess.run([git_exe, "-C", REPO_DIR, "remote", "set-url", "origin",
                                        f"git@github.com:{slug}.git"],
                                       capture_output=True, text=True, timeout=30, env=env, **_hidden())
                else:
                    if os.path.isdir(REPO_DIR):
                        import shutil
                        shutil.rmtree(REPO_DIR, ignore_errors=True)
                    p = subprocess.run([git_exe, "clone", "-q", f"git@github.com:{slug}.git", REPO_DIR],
                                       capture_output=True, text=True, timeout=60, env=env, **_hidden())
                if p.returncode != 0:
                    err = (p.stderr or p.stdout or "git clone başarısız").strip()
                    raise RuntimeError(err)
                subprocess.run([git_exe, "-C", REPO_DIR, "config", "core.sshCommand", ssh_cmd],
                               capture_output=True, text=True, timeout=15, env=env, **_hidden())
                sync.configure_git(slug)
                dlg.accept()
            except Exception as e:
                status_lbl.setText(f"SSH hatası: {e}")
                QMessageBox.warning(dlg, "SSH Bağlantı Hatası",
                                    f"Depo klonlanamadı:\n{e}\n\n"
                                    "Genel anahtarı GitHub'daki Deploy Keys sayfasına 'Allow write access' "
                                    "işaretli olarak eklediğinden emin ol.")

