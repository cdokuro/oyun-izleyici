        act_edna.triggered.connect(lambda _=False: self.set_theme("klasik" if self.theme == "edna" else "edna"))
        act_clock = menu.addAction("🕒 Saat ve Tarih Şeridi")
        act_clock.setCheckable(True)
        act_clock.setChecked(self.show_clock)
        act_clock.triggered.connect(lambda checked=False: self.set_show_clock(checked))
        act_telem = menu.addAction("📡 Ağ / Disk / Ping Şeridi")
        act_telem.setCheckable(True)
        act_telem.setChecked(self.show_telem)
        act_telem.triggered.connect(lambda checked=False: self.set_show_telem(checked))
        sub = self._submenu(menu, "🎨 Tema Rengi / Renk Çarkı…")
        preset_acts = []
        for hx, label in presets:
            act = sub.addAction(label)
            act.setCheckable(True)
            act.setChecked(self.theme == "klasik" and self.accent_hex.lower() == hx.lower())
            act.triggered.connect(lambda _=False, v=hx: self.set_accent_color(v))
