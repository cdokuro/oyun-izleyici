    def toggle_panel(self):
        if self.isVisible():
            self.hide()
        else:
            self.show()
            self.raise_()

    def _on_tick(self):
        if self.daemon_managed:
            stop_flag = os.path.join(DATA_DIR, ".hud_stop")
            if os.path.exists(stop_flag):
                try:
                    os.remove(stop_flag)
                except OSError:
                    pass
                self.shutdown()
                QApplication.instance().quit()
                return
        self._topmost_tick = getattr(self, "_topmost_tick", 0) + 1
        if self._topmost_tick % 4 == 0:
            self._enforce_win_topmost()
        t = self.telemetry
        if t.gpu.nv is not None:
            t.gpu.nv.wanted = self.isVisible() or t.capturing()
        t.update()
        if t.capture is not None:
            err = t.capture.take_error()
            if err:
                notify("Raven Watch — kare yakalama sorunu", err[:240])
        if self.sync is not None and self.sync.tick():
            if self.history_win is not None and self.history_win.isVisible():
                self.history_win.refresh()
        if self.tray is not None:
            tip = "Raven Watch"
            if t.game_name:
                tip += f"\n{t.game_name}" + (f" — {t.fps} FPS" if t.fps is not None else " (duraklatıldı)")
            if self.sync is not None:
                tip += "\n" + self.sync.status_text()
            self.tray.setToolTip(tip)
        while t.finished_events:
            self._on_session_finished(t.finished_events.pop(0))
        # Yüksek sıcaklık uyarısı (10 sn kesintisiz eşik aşımı, en fazla 10 dk'da bir)
        hot_msg = None
        if t.gpu_hotspot is not None and t.gpu_hotspot >= 95:
            hot_msg = f"GPU Hot Spot yüksek: {t.gpu_hotspot} °C"
        elif t.cpu_temp is not None and t.cpu_temp >= 92:
            hot_msg = f"CPU sıcaklığı yüksek: {t.cpu_temp} °C"
        now_m = time.monotonic()
        if hot_msg:
            if self._hot_since is None:
                self._hot_since = now_m
            elif now_m - self._hot_since >= 10.0 and now_m - self._last_thermal_alert >= 600.0:
                self._last_thermal_alert = now_m
                notify("Raven Watch — Sıcaklık Uyarısı", hot_msg)
        else:
            self._hot_since = None
        if self.summary and (time.time() > self.summary_until or t.fps is not None):
            self.summary = None
        if self.store is not None:
            try:
                self.store.backup_if_needed()  # günde bir kez (dosya varsa hiçbir şey yapmaz)
            except Exception:
                pass
        self.update()

    def _on_session_finished(self, res):
        total = None
        try:
            g = self.store.game_total(res["game"], self.store.machine_id) if self.store else None
            total = g["secs"] if g else None
        except Exception:
            pass
        self.summary = dict(res, total_secs=total)
        self.summary_until = time.time() + 90
        body = (f"Ort. {res['avg_fps']:.0f} FPS  ·  1% Low {res['low1']:.0f}  ·  0.1% Low {res['low01']:.0f}\n"
                f"GPU {_num(res['gpu_temp_avg'])}/{_num(res['gpu_temp_max'])} °C, {_num(res['gpu_w_avg'])} W  ·  "
                f"CPU {_num(res['cpu_temp_avg'])}/{_num(res['cpu_temp_max'])} °C")
        if total:
            body += f"\nBu oyunda toplam: {fmt_duration(total)}"
        notify(f"{res['game']} — {fmt_duration(res['duration_s'])} oynandı", body)
        if self.sync is not None:
            self.sync.request()
        if self.history_win is not None and self.history_win.isVisible():
            self.history_win.refresh()

    def closeEvent(self, event):
        if self.tray is not None and self.mode == "tepsi":
            self.hide()
            event.ignore()
            return
        QApplication.instance().quit()
        event.accept()

    def shutdown(self):
        self.save_settings()
        self.telemetry.checkpoint_now()
        self.telemetry.stop()

    def open_history(self, tab_index=None):
        if self.store is None:
            notify("Raven Watch", "Kayıt veritabanı açılamadığı için geçmiş gösterilemiyor.")
            return
        if self.history_win is None:
            self.history_win = HistoryWindow(self.store, self.sync, self.theme, self.accent_hex)
        else:
            self.history_win.apply_theme(self.theme, self.accent_hex)
        self.history_win.refresh()
        if tab_index == 2:
            self.history_win.open_compare()
        elif isinstance(tab_index, int) and not isinstance(tab_index, bool):
            self.history_win.tabs.setCurrentIndex(tab_index)
        self.history_win.show()
        self.history_win.raise_()
        self.history_win.activateWindow()

    def open_compare(self):
        self.open_history(tab_index=2)

    def sync_or_connect(self):
        if self.sync is not None and self.sync.enabled:
            self.sync.request()
        else:
            self.open_compare()
            if self.history_win is not None:
                self.history_win._open_sync_setup()

    def _logical(self, pos):
        return QPointF(pos.x() * self.base_w / max(1, self.width()),
                       pos.y() * self.base_h / max(1, self.height()) - self.header_h)

    def _on_anim(self):
        rpm = self.telemetry.fan_rpm
        if rpm <= 0 or not self.isVisible():
            return
        # Dönüş hızı RPM ile orantılı (görsel amaçlı)
        self.telemetry.fan_angle = (self.telemetry.fan_angle + 10.0 + 30.0 * min(1.0, rpm / 3000.0)) % 360.0
        sx = self.width() / float(self.base_w)
        sy = self.height() / float(self.base_h)
        # Fan ikonu mantıksal (296, 10, 88, 38) -> x: 296..384 alanında
        self.update(QRect(int(290 * sx), int((4 + self.header_h) * sy), int(98 * sx) + 2, int(52 * sy) + 2))

    def mousePressEvent(self, event):
        lpos = self._logical(event.position())
        if event.button() == Qt.MouseButton.LeftButton and self.DOTS_RECT.contains(lpos):
            self._show_context_menu(event.globalPosition().toPoint())
            event.accept()
            return
        if event.button() == Qt.MouseButton.LeftButton and \
                self.sync and self.sync.update_available and self._update_rect().contains(lpos):
            apply_app_update(self)
            event.accept()
            return
        if event.button() == Qt.MouseButton.LeftButton:
            self.drag_pos = event.globalPosition().toPoint() - self.frameGeometry().topLeft()
            event.accept()
        elif event.button() == Qt.MouseButton.RightButton:
            self._show_context_menu(event.globalPosition().toPoint())

    def mouseMoveEvent(self, event):
        lpos = self._logical(event.position())
        hover = self.DOTS_RECT.contains(lpos)
        uhover = bool(self.sync and self.sync.update_available and self._update_rect().contains(lpos))
        if hover != self.dots_hover or uhover != self.update_hover:
            self.dots_hover = hover
            self.update_hover = uhover
            self.setCursor(Qt.CursorShape.PointingHandCursor if (hover or uhover) else Qt.CursorShape.ArrowCursor)
            self.update()
        if self.drag_pos is not None and event.buttons() & Qt.MouseButton.LeftButton:
            self.move(event.globalPosition().toPoint() - self.drag_pos)
            event.accept()

    def mouseReleaseEvent(self, event):
        if self.drag_pos is not None:
            self.save_settings()
        self.drag_pos = None

    def wheelEvent(self, event):
        # Ctrl + tekerlek: saydamlık; sadece tekerlek: boyut
        delta = event.angleDelta().y()
        if event.modifiers() & Qt.KeyboardModifier.ControlModifier:
            if delta:
                self.set_opacity(self.opacity + (0.05 if delta > 0 else -0.05))
            return
        if delta > 0:
            self._set_scale(min(1.5, self.scale_factor + 0.05))
        elif delta < 0:
            self._set_scale(max(0.7, self.scale_factor - 0.05))

    def leaveEvent(self, event):
        if self.dots_hover or self.update_hover:
            self.dots_hover = False
            self.update_hover = False
            self.setCursor(Qt.CursorShape.ArrowCursor)
            self.update()

    def _show_context_menu(self, global_pos):
        self._build_context_menu().exec(global_pos)

