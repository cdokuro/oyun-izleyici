def format_game_title(raw_name):
    if not raw_name:
        return ""
    s = raw_name.strip()
    if s.lower().endswith(".exe"):
        s = s[:-4]
    for suf in ("-Win64-Shipping", "_Win64_Shipping", "-Linux-Shipping"):
        if s.lower().endswith(suf.lower()):
            s = s[:-len(suf)]
    # Alt çizgi ve tireleri boşluğa çevir
    s = re.sub(r"[_\\-]+", " ", s)
    # CamelCase / PascalCase kelime sınırlarına boşluk ekle:
    # 1) BÜYÜK harf dizisinden sonra Büyük+küçük geliyorsa (DOOMThe -> DOOM The)
    s = re.sub(r"([A-Z]{2,})([A-Z][a-z])", r"\1 \2", s)
    # 2) küçük harf veya rakamdan sonra Büyük harf geliyorsa (TheDarkAges -> The Dark Ages)
    s = re.sub(r"([a-z0-9])([A-Z])", r"\1 \2", s)
    s = re.sub(r"\s+", " ", s).strip().upper()
    compact = s.replace(" ", "")
    return KNOWN_GAME_NAMES.get(compact, s)


def game_name_from_log(path):
    base = os.path.basename(path)
    m = LOG_NAME_RE.match(base)
    name = m.group(1) if m else os.path.splitext(base)[0]
    return format_game_title(name)


def start_ts_from_log(path):
    m = re.search(r"_(\d{4}-\d{2}-\d{2}_\d{2}-\d{2}-\d{2})\.csv$", os.path.basename(path))
    if m:
        try:
            return time.mktime(time.strptime(m.group(1), "%Y-%m-%d_%H-%M-%S"))
        except ValueError:
            pass
    try:
        return os.path.getmtime(path)
    except OSError:
        return time.time()


def header_columns(line):
    """MangoHud sütun başlığı satırıysa {sütun: index} döndürür."""
    cols = [c.strip() for c in line.split(",")]
    if "fps" in cols and "frametime" in cols:
        return {c: cols.index(c) for c in LOG_COLUMNS if c in cols}
    return None


def parse_row(line, colmap):
    parts = line.split(",")
    if len(parts) <= max(colmap.values()):
        return None
    try:
        rec = {c: float(parts[i]) for c, i in colmap.items()}
    except ValueError:
        return None
    if not (1.0 <= rec["fps"] <= 2000.0):
        return None
    return rec


def fmt_duration(sec, short=False):
    sec = int(sec or 0)
    h, rem = divmod(sec, 3600)
    m = rem // 60
    if short:
        return f"{h} SA {m:02d} DK" if h else f"{m} DK"
    return f"{h} sa {m:02d} dk" if h else f"{m} dk"


def fmt_clock_timer(sec):
    sec = max(0, int(sec or 0))
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    return f"{h:02d}:{m:02d}:{s:02d}"


