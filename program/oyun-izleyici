            status_lbl.setText("GitHub deposuna bağlantı test ediliyor…")
            QApplication.processEvents()
            try:
                _, repo = github_api_request("GET", f"https://api.github.com/repos/{slug}", token=tok)
                if repo.get("private") and not tok:
                    raise RuntimeError("Özel depo için GitHub Token gerekli.")
