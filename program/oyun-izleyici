CONFIG_DIR = (os.path.join(_ROAM, "oyun-izleyici") if IS_WIN
              else os.path.join(os.path.expanduser("~"), ".config", "oyun-izleyici"))
MACHINE_CONF = os.path.join(CONFIG_DIR, "makine.conf")
TOKEN_PATH = os.path.join(CONFIG_DIR, "github.token")
