def _slug(text):
    s = re.sub(r"[^a-z0-9-]+", "-", text.lower()).strip("-")
    return s or "pc"


def load_machine_config():
    """Yoksa varsayılanlarla oluşturur. kimlik = GitHub'daki klasör adı (PC başına sabit)."""
    import configparser
    import socket
    cp = configparser.ConfigParser()
    cp.read(MACHINE_CONF, encoding="utf-8-sig")
    if not cp.has_section("makine"):
        cp.add_section("makine")
    host = socket.gethostname()
    defaults = {
        "kimlik": _slug(host),
        "ad": host,
        "gpu_adi": "",
        "cpu_adi": "",
        "ram_etiketi": "",
        "mod": "otomatik",       # otomatik | panel | tepsi
        "baslik": "",            # oyun yokken panelin altında görünen yazı (boşsa RAVEN WATCH)
        "engelle": "",           # Windows: oyun sayılmayacak programlar (virgülle: foo.exe, bar.exe)
        "senkron": "acik",       # acik | kapali
        "kayit_deposu": "",      # isteğe bağlı: GitHub kayıt deposu (sahip/depo)
    }
    changed = False
    for k, v in defaults.items():
        if not cp.has_option("makine", k):
            cp.set("makine", k, v)
            changed = True
    if changed:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        tmp = MACHINE_CONF + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write("# Raven Watch — bu PC'ye özel ayarlar\n"
                    "# kimlik: GitHub deposundaki klasör adı (değiştirme), ad: listelerde görünen isim\n"
                    "# mod: otomatik (2+ ekran = panel, tek ekran = sadece tepsi) | panel | tepsi\n")
            cp.write(f)
        os.replace(tmp, MACHINE_CONF)
    cfg = dict(cp.items("makine"))
    cfg["kimlik"] = _slug(cfg["kimlik"])
    return cfg


def save_machine_config(updates):
    """makine.conf içindeki belirli anahtarları atomik olarak günceller."""
    import configparser
    load_machine_config()
    cp = configparser.ConfigParser()
    cp.read(MACHINE_CONF, encoding="utf-8-sig")
    if not cp.has_section("makine"):
        cp.add_section("makine")
    for k, v in updates.items():
        cp.set("makine", str(k), "" if v is None else str(v))
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = MACHINE_CONF + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("# Raven Watch — bu PC'ye özel ayarlar\n"
                "# kimlik: GitHub deposundaki klasör adı (değiştirme), ad: listelerde görünen isim\n"
                "# mod: otomatik (2+ ekran = panel, tek ekran = sadece tepsi) | panel | tepsi\n")
        cp.write(f)
    os.replace(tmp, MACHINE_CONF)


def _short_gpu_name(name):
    m = re.search(r"\b((?:RX|RTX|GTX|Arc)\s[A-Z]?\d+[A-Z]*(?:\s(?:XTX|XT|GRE|Ti|SUPER))?)", name)
    if m:
        return m.group(1)
    m = re.findall(r"\[([^\]]+)\]", name)
    if m:
        name = m[-1]
    for junk in ("NVIDIA ", "GeForce ", "AMD ", "Radeon ", "Intel(R) ", "Corporation ", " Laptop GPU",
                 " Mobile", " Max-Q", "Sapphire Pulse ", "Graphics"):
        name = name.replace(junk, " ")
    name = re.sub(r"\s+", " ", name).strip()
    if "/" in name:  # "RX 9070/9070 XT/9070 GRE" gibi aile adları
        name = name.split("/")[0]
    return name or "GPU"


def _short_cpu_name(name):
    name = name.replace("(R)", "").replace("(TM)", "").replace(" CPU", "")
    name = re.sub(r"\s+\d+-Core Processor", "", name)
    name = re.sub(r"@.*$", "", name)
    m = re.search(r"Ryzen (\d+) (\w+)", name)
    if m:
        return f"R{m.group(1)} {m.group(2)}"
    m = re.search(r"Core(?:\s+Ultra)?\s+(i\d-\w+|\d+\s+\w+)", name)
    if m:
        return ("Ultra " if "Ultra" in name else ("Core " if not m.group(1).startswith("i") else "")) + m.group(1)
    name = name.replace("Intel ", "").replace("AMD ", "").replace("Processor", "")
    return re.sub(r"\s+", " ", name).strip()[:16] or "CPU"


class NvidiaPoller:
    """nvidia-smi'yi arka planda okur. Kart uykudaysa (RTD3) uyandırmamak için sorgulamaz."""

    FIELDS = "name,temperature.gpu,power.draw,memory.used,memory.total,clocks.gr,utilization.gpu,fan.speed"

    def __init__(self, pci_dir, exe="nvidia-smi"):
        import threading
        self.pci_dir = pci_dir
        self.exe = exe
        self.data = {}
        self.name = None
        self._stop = False
        self.wanted = True   # panel görünmüyorsa sorgulama (kartın uykuya geçmesini engellemesin)
        self._poll(force=True)
        self.thread = threading.Thread(target=self._loop, daemon=True)
        self.thread.start()

    def asleep(self):
        if not self.pci_dir:
            return False
        return read_str(os.path.join(self.pci_dir, "power", "runtime_status")) == "suspended"

    def _poll(self, force=False):
        import subprocess
        if not force and self.asleep():
            self.data = {"asleep": True}
            return
        try:
            out = subprocess.run([self.exe, f"--query-gpu={self.FIELDS}", "--format=csv,noheader,nounits"],
                                 capture_output=True, text=True, timeout=5, **_hidden()).stdout.strip().splitlines()
        except Exception:
            return
        if not out:
            return
        vals = [v.strip() for v in out[0].split(",")]
        if len(vals) < 8:
            return

        def num(v):
            try:
                return float(v)
            except ValueError:
                return None
        self.name = vals[0]
        self.data = {"temp": num(vals[1]), "power": num(vals[2]), "mem_used": num(vals[3]),
                     "mem_total": num(vals[4]), "clock": num(vals[5]), "util": num(vals[6]),
                     "fan": num(vals[7])}

    def _loop(self):
        while not self._stop:
            time.sleep(1.5)
            if self.wanted:
                self._poll()


class GpuReader:
    """Ekran kartını otomatik seçer: NVIDIA > en çok VRAM'li AMD > Intel."""

    def __init__(self, lhm=None):
        self.kind = None
        self.dev = None
        self.hwmon = None
        self.nv = None
        self.lhm = lhm
        self.fan_hwmon_input = None
        self.win_names = []
        if IS_WIN:
            self._init_windows()
            return
        cards = []
        for d in sorted(glob.glob("/sys/class/drm/card[0-9]*/device")):
            if not os.path.isdir(d) or re.search(r"card\d+-", d):
                continue
            drv = os.path.basename(os.path.realpath(os.path.join(d, "driver"))) if os.path.exists(
                os.path.join(d, "driver")) else ""
            vram = read_int(os.path.join(d, "mem_info_vram_total"), 0)
            cards.append((drv, vram, d))
        nv = [c for c in cards if c[0] == "nvidia"]
        amd = sorted([c for c in cards if c[0] == "amdgpu"], key=lambda c: -c[1])
        intel = [c for c in cards if c[0] in ("i915", "xe")]
        if nv and shutil_which("nvidia-smi"):
            self.kind, self.dev = "nvidia", nv[0][2]
            self.nv = NvidiaPoller(self.dev)
        elif amd:
            self.kind, self.dev = "amd", amd[0][2]
            hw = glob.glob(os.path.join(self.dev, "hwmon", "hwmon*"))
            self.hwmon = hw[0] if hw else None
        elif intel:
            self.kind, self.dev = "intel", intel[0][2]
        # Laptoplarda GPU fanı çoğu zaman üretici sürücüsünde (ör. asus: gpu_fan)
        for lab in glob.glob("/sys/class/hwmon/hwmon*/fan*_label"):
            if "gpu" in read_str(lab).lower():
                self.fan_hwmon_input = lab.replace("_label", "_input")
                break

    def _init_windows(self):
        exe = shutil_which("nvidia-smi")
        if not exe:
            for cand in (r"C:\Windows\System32\nvidia-smi.exe",
                         r"C:\Program Files\NVIDIA Corporation\NVSMI\nvidia-smi.exe"):
                if os.path.exists(cand):
                    exe = cand
                    break
        self.win_names = _win_gpu_names()
        if exe:
            self.kind = "nvidia"
            self.nv = NvidiaPoller(None, exe=exe)
        elif self.lhm and self.lhm.available:
            self.kind = "lhm"
        elif self.win_names:
            self.kind = "win"          # AMD / Intel: Windows'ta sürücüsüz sensör yok; sadece ad

    def name(self):
        if self.kind == "lhm":
            d = self.lhm.data if self.lhm else {}
            if d.get("gpu_name"):
                return _short_gpu_name(d["gpu_name"])
            return _short_gpu_name(self.win_names[0]) if self.win_names else "GPU"
        if self.kind == "win":
            return _short_gpu_name(self.win_names[0]) if self.win_names else "GPU"
        if self.kind == "nvidia" and self.nv and self.nv.name:
            return _short_gpu_name(self.nv.name)
        if self.dev:
            slot = os.path.basename(os.path.realpath(self.dev))
            try:
                import subprocess
                out = subprocess.run(["lspci", "-mm", "-s", slot], capture_output=True, text=True,
                                     timeout=3).stdout
                parts = re.findall(r'"([^"]*)"', out)
                # Önce alt sistem adı (ör. "Sapphire Pulse Radeon RX 9070 XT"), sonra aile adı
                for cand in (parts[4] if len(parts) > 4 else "", parts[2] if len(parts) > 2 else ""):
                    if re.search(r"\b(RX|RTX|GTX|Arc)\s", cand):
                        return _short_gpu_name(cand)
                if len(parts) >= 3:
                    return _short_gpu_name(parts[2])
            except Exception:
                pass
        return "GPU"

    def read(self, t):
        if self.kind == "amd":
            d = self.dev
            t.gpu_load = read_int(os.path.join(d, "gpu_busy_percent"), 0)
            vu = read_int(os.path.join(d, "mem_info_vram_used"), 0)
            vt = read_int(os.path.join(d, "mem_info_vram_total"), 0)
            t.vram_used_mb, t.vram_total_mb = int(vu / 1048576), max(1, int(vt / 1048576))
            if self.hwmon:
                h = self.hwmon
                t.fan_rpm = read_int(os.path.join(h, "fan1_input"), 0)
                pwm_max = max(1, read_int(os.path.join(h, "pwm1_max"), 255))
                t.fan_pct = int(round(read_int(os.path.join(h, "pwm1"), 0) / pwm_max * 100))
                p_uw = read_int(os.path.join(h, "power1_average"), 0) or read_int(os.path.join(h, "power1_input"), 0)
                t.gpu_watt = int(round(p_uw / 1e6))
                t.gpu_temp = int(round(read_int(os.path.join(h, "temp1_input"), 0) / 1000))
                hs = read_int(os.path.join(h, "temp2_input"), 0)
                t.gpu_hotspot = int(round(hs / 1000)) if hs > 0 else None
                mt = read_int(os.path.join(h, "temp3_input"), 0)
                t.gpu_mem_temp = int(round(mt / 1000)) if mt > 0 else None
                t.gpu_mhz = int(round(read_int(os.path.join(h, "freq1_input"), 0) / 1e6))
        elif self.kind == "nvidia":
            dd = self.nv.data
            if dd.get("asleep"):
                t.gpu_load, t.gpu_watt, t.gpu_mhz = 0, 0, 0
                t.gpu_temp = None   # uykudaki kart sıcaklık vermez
                t.vram_used_mb = 0
            else:
                t.gpu_load = int(dd.get("util") or 0)
                t.gpu_watt = int(round(dd["power"])) if dd.get("power") is not None else None
                t.gpu_temp = int(round(dd["temp"])) if dd.get("temp") is not None else None
                t.gpu_mhz = int(dd.get("clock") or 0)
                t.vram_used_mb = int(dd.get("mem_used") or 0)
                if dd.get("mem_total"):
                    t.vram_total_mb = int(dd["mem_total"])
                if dd.get("fan") is not None:
                    t.fan_pct = int(dd["fan"])
        elif self.kind == "lhm":
            dd = self.lhm.data if self.lhm else {}
            t.gpu_load = int(round(dd["gpu_load"])) if dd.get("gpu_load") is not None else 0
            t.gpu_watt = int(round(dd["gpu_watt"])) if dd.get("gpu_watt") is not None else None
            t.gpu_temp = int(round(dd["gpu_temp"])) if dd.get("gpu_temp") is not None else None
            t.gpu_hotspot = int(round(dd["gpu_hotspot"])) if dd.get("gpu_hotspot") is not None else None
            t.gpu_mem_temp = int(round(dd["gpu_mem_temp"])) if dd.get("gpu_mem_temp") is not None else None
            t.gpu_mhz = int(round(dd["gpu_mhz"])) if dd.get("gpu_mhz") is not None else 0
            t.gpu_mem_mhz = int(round(dd["gpu_mem_mhz"])) if dd.get("gpu_mem_mhz") is not None else 0
            t.gpu_volt = round(float(dd["gpu_volt"]), 2) if dd.get("gpu_volt") is not None else None
            t.fan_rpm = int(round(dd["fan_rpm"])) if dd.get("fan_rpm") is not None else 0
            t.fan_pct = int(round(dd["fan_pct"])) if dd.get("fan_pct") is not None else 0
            if dd.get("vram_used") is not None:
                t.vram_used_mb = int(round(dd["vram_used"]))
            if dd.get("vram_total"):
                t.vram_total_mb = max(1, int(round(dd["vram_total"])))
        elif self.kind == "win":
            t.gpu_load, t.gpu_watt, t.gpu_temp, t.gpu_mhz = 0, None, None, 0
        elif self.kind == "intel":
            t.gpu_load, t.gpu_watt, t.gpu_temp = 0, None, None
            f = glob.glob(os.path.join(self.dev, "drm", "card*", "gt_act_freq_mhz"))
            t.gpu_mhz = read_int(f[0], 0) if f else 0
        if self.fan_hwmon_input:
            t.fan_rpm = read_int(self.fan_hwmon_input, 0)
        t.vram_pct = int(round(t.vram_used_mb / max(1, t.vram_total_mb) * 100))


def shutil_which(cmd):
    import shutil
    return shutil.which(cmd)


class CpuReader:
    """İşlemci sıcaklığı / gücü / çekirdek yükleri — AMD ve Intel."""

    def __init__(self):
        self.name_full = ""
        try:
            with open("/proc/cpuinfo") as f:
                for ln in f:
                    if ln.startswith("model name"):
                        self.name_full = ln.split(":", 1)[1].strip()
                        break
        except OSError:
            pass
        self.temp_input = None
        hw_by_name = {read_str(os.path.join(h, "name")): h for h in glob.glob("/sys/class/hwmon/hwmon*")}
        if "k10temp" in hw_by_name:
            self.temp_input = os.path.join(hw_by_name["k10temp"], "temp1_input")
        elif "zenpower" in hw_by_name:
            self.temp_input = os.path.join(hw_by_name["zenpower"], "temp1_input")
        elif "coretemp" in hw_by_name:
            h = hw_by_name["coretemp"]
            for lab in glob.glob(os.path.join(h, "temp*_label")):
                if read_str(lab).startswith("Package"):
                    self.temp_input = lab.replace("_label", "_input")
            if not self.temp_input:
                self.temp_input = os.path.join(h, "temp1_input")
        else:
            for tz in glob.glob("/sys/class/thermal/thermal_zone*"):
                if read_str(os.path.join(tz, "type")) in ("x86_pkg_temp", "cpu-thermal"):
                    self.temp_input = os.path.join(tz, "temp")
        # Güç: AMD APU'da iGPU'nun PPT değeri paket gücüdür; Intel/AMD RAPL okunabiliyorsa o
        self.ppt_input = None
        for d in glob.glob("/sys/class/drm/card[0-9]*/device"):
            if os.path.basename(os.path.realpath(os.path.join(d, "driver"))) == "amdgpu" and \
                    read_int(os.path.join(d, "mem_info_vram_total"), 0) < 2 * 1024 ** 3:
                for p in glob.glob(os.path.join(d, "hwmon", "hwmon*", "power1_input")):
                    self.ppt_input = p
        self.rapl = None
        for r in ("/sys/class/powercap/intel-rapl:0/energy_uj", "/sys/class/powercap/amd-rapl:0/energy_uj"):
            if os.access(r, os.R_OK) and read_int(r, -1) >= 0:
                self.rapl = r
                break
        self._rapl_prev = None
        # Fiziksel çekirdekler: aynı core_cpus_list'e sahip iş parçacıkları tek çubuk
        groups = {}
        for c in glob.glob("/sys/devices/system/cpu/cpu[0-9]*"):
            idx = int(re.search(r"(\d+)$", c).group(1))
            key = read_str(os.path.join(c, "topology", "core_cpus_list"), str(idx))
            groups.setdefault(key, []).append(idx)
        self.cores = sorted(groups.values(), key=lambda g: min(g))[:16]
        self.prev = self._read_proc_stat()

    def name(self):
        return _short_cpu_name(self.name_full) if self.name_full else "CPU"

    @staticmethod
    def _read_proc_stat():
        res = {}
        try:
            with open("/proc/stat") as f:
                for line in f:
                    if line.startswith("cpu"):
                        parts = line.split()
                        vals = [int(x) for x in parts[1:9]]
                        res[parts[0]] = (vals[3] + vals[4], sum(vals))
        except Exception:
            pass
        return res

    def read(self, t):
        now = self._read_proc_stat()

        def load(key):
            if key in now and key in self.prev:
                (i0, t0), (i1, t1) = self.prev[key], now[key]
                return max(0, min(100, int(round((1.0 - (i1 - i0) / max(1, t1 - t0)) * 100))))
            return 0
        t.cpu_load = load("cpu")
        t.core_loads = [max(load(f"cpu{i}") for i in g) for g in self.cores] or [t.cpu_load]
        self.prev = now
        if self.temp_input:
            t.cpu_temp = int(round(read_int(self.temp_input, 0) / 1000))
        if self.ppt_input:
            t.cpu_watt = int(round(read_int(self.ppt_input, 0) / 1e6))
        elif self.rapl:
            e, ts = read_int(self.rapl, 0), time.monotonic()
            if self._rapl_prev and e >= self._rapl_prev[0]:
                t.cpu_watt = int(round((e - self._rapl_prev[0]) / 1e6 / max(0.1, ts - self._rapl_prev[1])))
            self._rapl_prev = (e, ts)
        else:
            t.cpu_watt = None
        max_khz = max((read_int(f, 0) for f in glob.glob(
            "/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq")), default=0)
        t.cpu_ghz = round(max_khz / 1e6, 2) if max_khz else None


def read_power_source():
    """True = prizde, False = pilde, None = pil yok (masaüstü)."""
    if IS_WIN:
        ps = _win_psutil()
        try:
            b = ps.sensors_battery() if ps else None
        except Exception:
            b = None
        return None if b is None else bool(b.power_plugged)
    has_battery = False
    for p in glob.glob("/sys/class/power_supply/*"):
        typ = read_str(os.path.join(p, "type"))
        if typ == "Battery":
            has_battery = True
    if not has_battery:
        return None
    for p in glob.glob("/sys/class/power_supply/*"):
        if read_str(os.path.join(p, "type")) in ("Mains", "USB") and read_str(os.path.join(p, "online")) == "1":
            return True
    return False


