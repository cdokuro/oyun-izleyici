EDNA_ACCENT = "#10a6d4"


def _mix_hex(base_rgb, acc_rgb, ratio):
    r = int(round(base_rgb[0] * (1.0 - ratio) + acc_rgb[0] * ratio))
    g = int(round(base_rgb[1] * (1.0 - ratio) + acc_rgb[1] * ratio))
    b = int(round(base_rgb[2] * (1.0 - ratio) + acc_rgb[2] * ratio))
    return f"#{max(0, min(255, r)):02x}{max(0, min(255, g)):02x}{max(0, min(255, b)):02x}"


def theme_palette(theme="klasik", accent_hex="#40ff70"):
    """Aktif panel temasına (Edna veya Klasik + vurgu rengi) uygun pencere/menü renk paleti."""
    if theme == "edna":
        return {
            "accent": EDNA_ACCENT,
            "bg": "#263238",
            "surface": "#2c3a41",
            "surface_alt": "#314048",
            "surface_hi": "#37474f",
            "hover": "#1f4656",
            "border": "#3e5059",
            "border_strong": "#546e7a",
            "text": "#edf0f2",
            "text_dim": "#9eb0ba",
            "upd_bg": "#173f50",
            "upd_hover": "#1e5870",
            "danger_border": "#9e3f3f",
            "danger_hover_bg": "#4a2328",
            "danger_text": "#ff7a7a",
            "pos_text": "#3ddc84",
            "neg_text": "#ff6b6b",
        }
    c = QColor(accent_hex)
    if not c.isValid():
        c = QColor("#40ff70")
    acc = (c.red(), c.green(), c.blue())
    return {
        "accent": c.name(),
        "bg": _mix_hex((6, 8, 8), acc, 0.03),
        "surface": _mix_hex((9, 11, 11), acc, 0.05),
        "surface_alt": _mix_hex((12, 15, 15), acc, 0.07),
        "surface_hi": _mix_hex((14, 18, 18), acc, 0.11),
        "hover": _mix_hex((18, 22, 22), acc, 0.22),
        "border": _mix_hex((22, 26, 26), acc, 0.16),
        "border_strong": _mix_hex((30, 34, 34), acc, 0.28),
        "text": "#f2f7f3",
        "text_dim": _mix_hex((128, 138, 134), acc, 0.14),
        "upd_bg": _mix_hex((14, 20, 18), acc, 0.20),
        "upd_hover": _mix_hex((20, 30, 26), acc, 0.34),
        "danger_border": "#7a2a2a",
        "danger_hover_bg": "#3b1414",
        "danger_text": "#ff6b6b",
        "pos_text": "#40ff70",
        "neg_text": "#ff6b6b",
    }


