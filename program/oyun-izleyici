def _hidden():
    """Windows'ta alt süreçler konsol penceresi açmasın."""
    if not IS_WIN:
        return {}
    import subprocess
    return {"creationflags": getattr(subprocess, "CREATE_NO_WINDOW", 0x08000000)}


def _win_psutil():
    try:
        import psutil
        return psutil
    except ImportError:
        return None


def windows_foreground_pid():
    """Ön plandaki pencerenin süreç numarası (yoksa None)."""
    try:
        import ctypes
        from ctypes import wintypes
        user32 = ctypes.windll.user32
        pid = wintypes.DWORD(0)
        user32.GetWindowThreadProcessId(user32.GetForegroundWindow(), ctypes.byref(pid))
        return pid.value or None
    except Exception:
        return None


def _win_cpu_name():
    try:
        import winreg
        with winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, r"HARDWARE\DESCRIPTION\System\CentralProcessor\0") as k:
            return winreg.QueryValueEx(k, "ProcessorNameString")[0].strip()
    except Exception:
        import platform
        return platform.processor() or "CPU"


def _win_gpu_names():
    """Windows'taki ekran kartı adları (WMI)."""
    try:
        import subprocess
        out = subprocess.run(
            ["powershell.exe", "-NoProfile", "-NonInteractive", "-Command",
             "Get-CimInstance Win32_VideoController | ForEach-Object { $_.Name }"],
            capture_output=True, text=True, errors="replace", timeout=20, **_hidden()).stdout
        return [ln.strip() for ln in out.splitlines() if ln.strip()]
    except Exception:
        return []


class WinThermal:
    """ACPI ısıl bölge sıcaklığı (°C). Kalıcı bir PowerShell süreci WMI'yi 3 sn'de bir okur; yönetici gerekmez.
    Bu işlemci sıcaklığı değil, dizüstünün ısıl bölgesidir (genelde işlemciye yakın bir değer)."""

    SCRIPT = (
        "$ErrorActionPreference='SilentlyContinue';"
        "while($true){"
        "$v=@(Get-CimInstance -Namespace root/cimv2 -ClassName Win32_PerfFormattedData_Counters_ThermalZoneInformation"
        " | ForEach-Object {[double]$_.Temperature});"
        "if(-not $v){$v=@(Get-CimInstance -Namespace root/wmi -ClassName MSAcpi_ThermalZoneTemperature"
        " | ForEach-Object {[double]$_.CurrentTemperature/10})};"
        "Write-Output ('T ' + (($v | ForEach-Object {[string]::Format([Globalization.CultureInfo]::InvariantCulture,'{0:F1}',$_)}) -join ' '));"
        "[Console]::Out.Flush();Start-Sleep -Seconds 3}"
    )

    def __init__(self):
        import threading
        self.celsius = None
        self.proc = None
        self._stop = False
        threading.Thread(target=self._run, daemon=True).start()

    @staticmethod
    def parse_line(line):
        """'T 305.1 310.0' -> en yüksek geçerli sıcaklık (°C); geçerli değer yoksa None."""
        if not line.startswith("T "):
            return None
        vals = []
        for tok in line[2:].split():
            try:
                k = float(tok)
            except ValueError:
                continue
            if 250.0 < k < 400.0:          # Kelvin: -23..127 °C
                vals.append(k - 273.15)
        return max(vals) if vals else None

    def _run(self):
        import subprocess
        try:
            self.proc = subprocess.Popen(
                ["powershell.exe", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass",
                 "-Command", self.SCRIPT],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, **_hidden())
            for line in self.proc.stdout:
                if self._stop:
                    break
                self.celsius = self.parse_line(line.strip())
        except Exception:
            self.celsius = None

    def stop(self):
        self._stop = True
        try:
            if self.proc:
                self.proc.terminate()
        except Exception:
            pass


class WinLhmPoller:
    """Windows: LibreHardwareMonitorLib.dll uzerinden AMD/NVIDIA/Intel GPU ve Ryzen/Intel CPU sensorlerini
    tek bir gizli PowerShell surecinde 1 sn'de bir JSON satiri olarak okur."""

    SCRIPT_TMPL = r"""
$ErrorActionPreference='SilentlyContinue'
Add-Type -Path '__DLL__'
$c = New-Object LibreHardwareMonitor.Hardware.Computer
$c.IsCpuEnabled = $true
$c.IsGpuEnabled = $true
$c.Open()
function Pick($sensors, $type, $names) {
    foreach ($n in $names) {
        foreach ($s in $sensors) {
            if ($s.SensorType.ToString() -eq $type -and $s.Name -eq $n -and $null -ne $s.Value) {
                return [double]$s.Value
            }
        }
    }
    return $null
}
while ($true) {
    $out = [ordered]@{}
    $bestGpu = $null
    $bestScore = -1
    foreach ($hw in $c.Hardware) {
        $hw.Update()
        $ht = $hw.HardwareType.ToString()
        if ($ht -eq 'Cpu') {
            $cw = Pick $hw.Sensors 'Power' @('Package','CPU Package')
            if ($null -ne $cw -and $cw -gt 0.1) { $out['cpu_watt'] = [math]::Round($cw, 2) }
            $ct = Pick $hw.Sensors 'Temperature' @('Core (Tctl/Tdie)','CPU Package','CCD1 (Tdie)','Core Average')
            if ($null -ne $ct -and $ct -gt 1.0) { $out['cpu_temp'] = [math]::Round($ct, 1) }
            $cm = Pick $hw.Sensors 'Clock' @('Cores (Average)','Core #1')
            if ($null -ne $cm -and $cm -gt 100.0) { $out['cpu_mhz'] = [math]::Round($cm, 1) }
        } elseif ($ht -like 'Gpu*') {
            $vt = Pick $hw.Sensors 'SmallData' @('GPU Memory Total','D3D Dedicated Memory Total')
            $gp = Pick $hw.Sensors 'Power' @('GPU Package','GPU Core','GPU Total')
            $gt = Pick $hw.Sensors 'Temperature' @('GPU Core','GPU Hot Spot')
            $score = 0
            if ($null -ne $gp) { $score += 100000 }
            if ($null -ne $gt) { $score += 50000 }
            if ($null -ne $vt) { $score += [int]$vt }
            if ($hw.Sensors.Count -gt 0 -and $score -gt $bestScore) {
                $bestScore = $score
                $bestGpu = $hw
            }
        }
    }
    if ($null -ne $bestGpu) {
        $s = $bestGpu.Sensors
        $out['gpu_name']     = $bestGpu.Name
        $out['gpu_load']     = Pick $s 'Load'        @('GPU Core','D3D 3D')
        $out['gpu_watt']     = Pick $s 'Power'       @('GPU Package','GPU Core','GPU Total')
        $out['gpu_temp']     = Pick $s 'Temperature' @('GPU Core','GPU Hot Spot')
        $out['gpu_hotspot']  = Pick $s 'Temperature' @('GPU Hot Spot')
        $out['gpu_mem_temp'] = Pick $s 'Temperature' @('GPU Memory','GPU Memory Junction')
        $out['gpu_mhz']      = Pick $s 'Clock'       @('GPU Core')
        $out['gpu_mem_mhz']  = Pick $s 'Clock'       @('GPU Memory')
        $out['gpu_volt']     = Pick $s 'Voltage'     @('GPU Core')
        $out['fan_rpm']      = Pick $s 'Fan'         @('GPU Fan','GPU Fan 1')
        $out['fan_pct']      = Pick $s 'Control'     @('GPU Fan','GPU Fan 1')
        $out['vram_used']    = Pick $s 'SmallData'   @('GPU Memory Used','D3D Dedicated Memory Used')
        $out['vram_total']   = Pick $s 'SmallData'   @('GPU Memory Total','D3D Dedicated Memory Total')
    }
    Write-Output ($out | ConvertTo-Json -Compress)
    [Console]::Out.Flush()
    Start-Sleep -Milliseconds 1000
}
"""

    def __init__(self, dll_path=LHM_DLL):
        import threading
        self.dll_path = dll_path
        self.available = bool(IS_WIN and dll_path and os.path.isfile(dll_path))
        self.data = {}
        self.proc = None
        self._stop = False
        if self.available:
            threading.Thread(target=self._run, daemon=True).start()

    def _run(self):
        import base64
        import json
        import subprocess
        script = self.SCRIPT_TMPL.replace("__DLL__", self.dll_path.replace("'", "''"))
        b64 = base64.b64encode(script.encode("utf-16-le")).decode("ascii")
        while not self._stop:
            try:
                self.proc = subprocess.Popen(
                    ["powershell.exe", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass",
                     "-EncodedCommand", b64],
                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
                    encoding="utf-8", errors="replace", **_hidden())
                for line in self.proc.stdout:
                    if self._stop:
                        break
                    line = line.strip()
                    if not line.startswith("{"):
                        continue
                    try:
                        d = json.loads(line)
                        if isinstance(d, dict):
                            self.data = d
                    except Exception:
                        continue
            except Exception:
                pass
            if not self._stop:
                time.sleep(3.0)

    def stop(self):
        self._stop = True
        try:
            if self.proc:
                self.proc.terminate()
        except Exception:
            pass


class WinCpuReader:
    """Windows: psutil ile yük / çekirdekler, LibreHardwareMonitor varsa gerçek sıcaklık / güç / frekans,
    yoksa ACPI ısıl bölge sıcaklığı."""

    def __init__(self, lhm=None):
        self.ps = _win_psutil()
        self.lhm = lhm
        self.name_full = _win_cpu_name()
        self.cores = [[0]]
        if self.ps:
            logical = self.ps.cpu_count(logical=True) or 1
            physical = self.ps.cpu_count(logical=False) or logical
            if logical == 2 * physical:                       # SMT: çiftler tek çekirdek
                self.cores = [[i, i + 1] for i in range(0, logical, 2)]
            else:                                             # hibrit / SMT yok: her mantıksal işlemci ayrı
                self.cores = [[i] for i in range(min(logical, 16))]
            self.ps.cpu_percent(percpu=True)                  # ilk çağrı boş döner: ısıt
        self.thermal = None if (lhm and lhm.available) else WinThermal()

    def name(self):
        return _short_cpu_name(self.name_full) if self.name_full else "CPU"

    def read(self, t):
        if self.ps:
            per = self.ps.cpu_percent(percpu=True)
            if per:
                t.cpu_load = int(round(sum(per) / len(per)))
                t.core_loads = [int(round(max(per[i] for i in g if i < len(per)))) for g in self.cores
                                if any(i < len(per) for i in g)] or [t.cpu_load]
            try:
                f = self.ps.cpu_freq()
                t.cpu_ghz = round(f.current / 1000.0, 2) if f and f.current else None
            except Exception:
                t.cpu_ghz = None
        dd = self.lhm.data if (self.lhm and self.lhm.available) else {}
        if dd.get("cpu_mhz"):
            t.cpu_ghz = round(float(dd["cpu_mhz"]) / 1000.0, 2)
        if dd.get("cpu_temp") is not None:
            t.cpu_temp = int(round(float(dd["cpu_temp"])))
        elif self.thermal is not None:
            c = self.thermal.celsius
            t.cpu_temp = int(round(c)) if c is not None else None
        else:
            t.cpu_temp = None
        t.cpu_watt = int(round(float(dd["cpu_watt"]))) if dd.get("cpu_watt") is not None else None

    def stop(self):
        if self.thermal is not None:
            self.thermal.stop()


def win_read_memory(t):
    ps = _win_psutil()
    if not ps:
        return
    vm = ps.virtual_memory()
    t.ram_used_gb = (vm.total - vm.available) / 1024 ** 3
    t.ram_total_gb = vm.total / 1024 ** 3
    t.ram_pct = int(round((vm.total - vm.available) / max(1, vm.total) * 100))


