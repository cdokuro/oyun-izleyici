        p.setPen(pen_fg)
        span = int(-360 * 16 * (max(5, min(100, pct)) / 100.0))
        p.drawArc(QRectF(cx - r, cy - r, 2 * r, 2 * r), 90 * 16, span)

    def _draw_bolt_icon(self, p: QPainter, cx, cy, size, green):
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(green)
        poly = QPolygonF([
            QPointF(cx + size * 0.15, cy - size * 0.9),
            QPointF(cx - size * 0.55, cy + size * 0.1),
            QPointF(cx - size * 0.05, cy + size * 0.1),
            QPointF(cx - size * 0.25, cy + size * 0.9),
            QPointF(cx + size * 0.55, cy - size * 0.15),
            QPointF(cx + size * 0.05, cy - size * 0.15),
        ])
