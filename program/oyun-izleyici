_NOTIFY_TRAY = None


def notify(title, body):
    import json
    import subprocess
    if IS_WIN:
        try:
            if _NOTIFY_TRAY is not None:
                from PySide6.QtWidgets import QSystemTrayIcon
                _NOTIFY_TRAY.showMessage(title, body, QSystemTrayIcon.MessageIcon.Information, 9000)
                return
            # Hafif arka plan modu (--hud): bildirimi tepsiye sahip pc_izleyici servisine ilet
            os.makedirs(DATA_DIR, exist_ok=True)
            nf = os.path.join(DATA_DIR, ".notify.json")
            tmp = nf + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump({"title": title, "body": body, "ts": time.time()}, f, ensure_ascii=False)
            os.replace(tmp, nf)
        except Exception:
            pass
        return
    try:
        subprocess.Popen(["notify-send", "-a", "Raven Watch", "-i", "applications-games", title, body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def acquire_single_instance(wait=0.0):
    """Panel zaten açıksa None döner (ikinci kopya açılmaz). wait: kilit boşalana kadar beklenecek sn
    (kendini güncelleyip yeniden başlayan Windows sürümü için)."""
    if IS_WIN:
        lock_path = os.path.join(DATA_DIR, "oyun-izleyici.lock")
        os.makedirs(DATA_DIR, exist_ok=True)
    else:
        lock_path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "oyun-izleyici.lock")
    deadline = time.time() + wait
    while True:
        fd = open(lock_path, "w")
        try:
            if IS_WIN:
                msvcrt.locking(fd.fileno(), msvcrt.LK_NBLCK, 1)
            else:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except OSError:
            fd.close()
            if time.time() >= deadline:
                return None
            time.sleep(0.3)


