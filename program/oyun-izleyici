    def _fill_compare(self):
        a, b = self.cmp_a.currentData(), self.cmp_b.currentData()
        names = self._names()
        machines = {m["machine_id"]: m for m in self.store.machines()}
        ac_only = self.cmp_ac.isChecked()
        pal = theme_palette(self.theme, self.accent_hex)

        if len(machines) < 2:
            if self.sync is not None and self.sync.enabled:
                self.cmp_banner_lbl.setText(
                    "GitHub kayıt deposu bağlı, ancak henüz başka bir PC'den kayıt görünmüyor. "
                    "Diğer PC'de de aynı kayıt deposunu bağladıktan sonra senkronize et."
                )
                self.b_cmp_connect.setText("🔄 Şimdi Senkronize Et")
            else:
                self.cmp_banner_lbl.setText(
                    "Henüz karşılaştırılacak ikinci bir PC yok. Diğer PC'lerdeki oyun kayıtlarını çekip "
                    "doğrudan karşılaştırmak için özel GitHub kayıt deponu buradan bağla."
                )
                self.b_cmp_connect.setText("🔗 GitHub Kayıt Deposu Bağla")
            self.cmp_banner.show()
        else:
            self.cmp_banner.hide()

        def card(mid):
            m = machines.get(mid, {})
            t = self.store.totals(mid)
            hw = " · ".join(x for x in (m.get("cpu"), m.get("gpu"), m.get("ram")) if x)
            return (f"{names.get(mid, mid)}\n{hw or 'donanım bilgisi yok'}\n"
                    f"Toplam {fmt_duration(t['secs'])} · {t['games']} oyun · {t['sessions']} oturum")
        if a:
            self.cmp_card_a.setText("A — " + card(a))
        if b:
            self.cmp_card_b.setText("B — " + card(b))
        if not a or not b or a == b:
            self.cmp_bars.set_data("", "", [])
            self._fill_table(self.cmp_tbl, [], (0, Qt.SortOrder.AscendingOrder))
            return
        ga = {r["game"]: r for r in self.store.game_totals(a, ac_only)}
        gb = {r["game"]: r for r in self.store.game_totals(b, ac_only)}

        def diff(x, y):
            if not x or not y:
                return "—", None
            d = (x - y) / y * 100
            return (f"A %{abs(d):.0f} {'önde' if d >= 0 else 'geride'}", d)
        I = self._item
        rows = []
        bar_items = []
        for game in sorted(set(ga) & set(gb)):
            ra, rb = ga[game], gb[game]
            bar_items.append((game, ra["avg_fps"], rb["avg_fps"]))
            fd, fdv = diff(ra["avg_fps"], rb["avg_fps"])
            ld, ldv = diff(ra["low1"], rb["low1"])
            fi = I(fd, fdv)
            li = I(ld, ldv)
            for it, v in ((fi, fdv), (li, ldv)):
                if v is not None:
                    it.setForeground(QColor(pal["pos_text"]) if v >= 0 else QColor(pal["neg_text"]))
            ef_a = (ra["avg_fps"] / ra["gpu_w_avg"]) if (ra["avg_fps"] and ra["gpu_w_avg"] and ra["gpu_w_avg"] > 5) else None
            ef_b = (rb["avg_fps"] / rb["gpu_w_avg"]) if (rb["avg_fps"] and rb["gpu_w_avg"] and rb["gpu_w_avg"] > 5) else None
            rows.append([
                I(game, game, align_right=False),
                I(fmt_duration(ra["secs"]), ra["secs"]), I(fmt_duration(rb["secs"]), rb["secs"]),
                I(_num(ra["avg_fps"]), ra["avg_fps"]), I(_num(rb["avg_fps"]), rb["avg_fps"]), fi,
                I(_num(ra["low1"]), ra["low1"]), I(_num(rb["low1"]), rb["low1"]), li,
                I(_num(ra["gpu_temp_avg"], 0, " °C"), ra["gpu_temp_avg"]),
                I(_num(rb["gpu_temp_avg"], 0, " °C"), rb["gpu_temp_avg"]),
                I(f"{_num(ra['gpu_w_avg'], 0)} / {_num(rb['gpu_w_avg'], 0)} W", ra["gpu_w_avg"]),
                I(f"{_num(ef_a, 2)} / {_num(ef_b, 2)}", ef_a),
            ])
        self.cmp_bars.set_data(names.get(a, a), names.get(b, b), bar_items)
        self._fill_table(self.cmp_tbl, rows, (0, Qt.SortOrder.AscendingOrder))
        only = len(set(ga) ^ set(gb))
        self.cmp_note.setText(
            f"{len(rows)} ortak oyun ({only} oyun sadece birinde oynanmış). Süre ağırlıklı ortalamalar. "
            "Karşılaştırma ancak iki PC'de aynı çözünürlük ve grafik ayarıyla oynandıysa adildir; "
            "oturumlara not ekleyerek ayarları kaydedebilirsin.")

