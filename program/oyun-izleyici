        act_guide.triggered.connect(lambda: show_shortcuts_guide(self, self.accent_hex, self.theme))
        menu.addAction(act_guide)
        act_sync = QAction(
            "🔄 GitHub ile Senkronize Et / Güncelleme Denetle" if (self.sync and self.sync.enabled)
            else "🔗 GitHub Kayıt Deposu Bağla…", self)
        act_sync.triggered.connect(self.sync_or_connect)
        menu.addAction(act_sync)
        menu.addSeparator()
        self._add_color_menu(menu)
        menu.addSeparator()

        act_top = QAction("📌 Her Zaman Üstte (Aktif)" if self.always_on_top else "📌 Her Zaman Üstte Tut", self)
        act_top.triggered.connect(self._toggle_top)
        menu.addAction(act_top)

        act_hdmi = QAction("🖥️ Sol Monitöre (HDMI) Hizala", self)
        act_hdmi.triggered.connect(self.move_to_left_hdmi_monitor)
        menu.addAction(act_hdmi)

        act_reset = QAction("📐 Boyutu Sıfırla (%100)", self)
        act_reset.triggered.connect(lambda: self._set_scale(1.0))
        menu.addAction(act_reset)
        self._add_opacity_menu(menu)
        menu.addSeparator()
