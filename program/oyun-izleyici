def mangohud_gpu_slot(gpu):
    """Birden fazla ekran kartı varsa MangoHud kaydının hangi karta bakacağını belirleyen PCI adresi.
    pci_dev olmazsa MangoHud ilk karta (çoğu AMD masaüstünde işlemcinin içindeki iGPU) bakar ve
    GPU °C / W / VRAM yanlış kaydedilir. Şimdilik sadece AMD için (NVIDIA yolu laptopta doğrulanmadı)."""
    try:
        if gpu is None or gpu.kind != "amd" or not gpu.dev:
            return None
        n = sum(1 for d in glob.glob("/sys/class/drm/card[0-9]*/device")
                if os.path.isdir(d) and not re.search(r"card\d+-", d) and os.path.exists(os.path.join(d, "driver")))
        return os.path.basename(os.path.realpath(gpu.dev)) if n >= 2 else None
    except Exception:
        return None


def ensure_mangohud_gpu(gpu):
    """Mevcut MangoHud.conf'ta pci_dev yoksa ekler (bir kez yedek alır). Eklediyse True."""
    slot = mangohud_gpu_slot(gpu)
    if not slot or not os.path.exists(MH_CONF):
        return False
    try:
        with open(MH_CONF, encoding="utf-8") as f:
            text = f.read()
        if re.search(r"^\s*pci_dev\s*=", text, re.M):
            return False
        bak = MH_CONF + ".yedek-pcidev"
        if not os.path.exists(bak):
            import shutil
            shutil.copy2(MH_CONF, bak)
        with open(MH_CONF, "a", encoding="utf-8") as f:   # yerinde ekle: açık oyunda da uygulanır
            f.write(("" if text.endswith("\n") else "\n") +
                    f"# Raven Watch: kayıt iGPU'ya değil bu ekran kartına bakar\npci_dev={slot}\n")
        return True
    except OSError:
        return False


def build_mangohud_config(mode, pos="top-center", bg=0.3, size=20, pci_dev=None):
    head = [f"# Raven Watch tarafından yazıldı (mod: {mode}). Değiştirmek için: panel/tepsi menüsü ->",
            "# Oyun İçi Gösterge. Oyunda göster/gizle: Sağ Shift + F12. Elle düzenlersen 'Kendi ayarım'ı seç."]
    if mode == "gizli":
        body = ["legacy_layout=0", "alpha=0", "background_alpha=0", "hud_no_margin"]
    else:
        body = ["legacy_layout=0", f"position={pos}", f"font_size={size}", f"background_alpha={bg}",
                "background_color=000000", "text_outline", "text_color=FFFFFF",
                "gpu_color=40FF70", "cpu_color=40FF70", "vram_color=40FF70", "ram_color=40FF70",
                "fps_color_change", "fps_value=60,120", "fps_color=FF5555,FFDD33,40FF70"]
        if mode == "tek":
            body += ["horizontal", "hud_compact", "hud_no_margin", "table_columns=20", "round_corners=6",
                     "fps", "frametime", "frame_timing=0",
                     "gpu_text=GPU", "gpu_stats", "gpu_temp", "gpu_power",
                     "cpu_text=CPU", "cpu_stats", "cpu_temp", "vram", "ram"]
        else:  # detay
            body += ["table_columns=3", "round_corners=8", "fps", "fps_metrics=avg,0.01", "frametime",
                     "frame_timing=1", "gpu_text=GPU", "gpu_stats", "gpu_temp", "gpu_power", "gpu_core_clock",
                     "vram", "cpu_text=CPU", "cpu_stats", "cpu_temp", "cpu_power", "cpu_mhz", "ram"]
    if pci_dev:
        body.append(f"pci_dev={pci_dev}")   # hem gösterge hem kayıt sadece bu ekran kartına baksın
    return "\n".join(head + body + ["toggle_hud=Shift_R+F12"] + _MH_LOGGING) + "\n"


def _with_logging(text, pci_dev=None):
    """Kullanıcının kendi ayarına kayıt satırlarını ekler (no_display kaydı engellediği için saydamlığa çevirir)."""
    lines = text.splitlines()
    had_no_display = any(re.match(r"^\s*no_display\s*(=.*)?$", ln) for ln in lines)
    drop = re.compile(r"^\s*(no_display|output_folder|autostart_log|log_duration|log_interval)\s*(=.*)?$")
    out = [ln for ln in lines if not drop.match(ln)]
    if had_no_display:
        out = [ln for ln in out if not re.match(r"^\s*(legacy_layout|alpha|background_alpha)\s*=", ln)]
        out += ["legacy_layout=0", "alpha=0", "background_alpha=0"]
    if pci_dev and not any(re.match(r"^\s*pci_dev\s*=", ln) for ln in out):
        out.append(f"pci_dev={pci_dev}")
    return "\n".join(out + _MH_LOGGING) + "\n"


def apply_overlay(mode, pos, bg, size, pci_dev=None):
    os.makedirs(os.path.dirname(MH_CONF), exist_ok=True)
    if not os.path.exists(MH_ORIG) and os.path.exists(MH_CONF):
        import shutil
        shutil.copy2(MH_CONF, MH_ORIG)   # ilk değişiklikten önceki ayar: "Kendi ayarım"
    if mode == "kendi":
        try:
            with open(MH_ORIG, encoding="utf-8") as f:
                text = _with_logging(f.read(), pci_dev)
        except OSError:
            text = build_mangohud_config("gizli", pci_dev=pci_dev)
    else:
        text = build_mangohud_config(mode, pos, bg, size, pci_dev)
    # Yerinde yaz (dosyayı değiştirmeden): MangoHud inotify ile izliyor, açık oyunda anında yenilenir
    with open(MH_CONF, "w", encoding="utf-8") as f:
        f.write(text)



