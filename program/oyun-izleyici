    def _draw_thermometer_icon(self, p: QPainter, cx, cy, size, green):
        p.setPen(QPen(green, 2.2))
        p.setBrush(green)
        bulb_r = size * 0.38
        p.drawEllipse(QPointF(cx, cy + size * 0.42), bulb_r, bulb_r)
