            f"Toplam oyun süresi: {fmt_duration(tot['secs'])}   ·   {tot['games']} oyun   ·   {tot['sessions']} oturum")

        I = self._item
        rows = []
        for g in games:
            rows.append([
                I(g["game"], g["game"], align_right=False),
                I(fmt_duration(g["secs"]), g["secs"]),
                I(str(g["sessions"]), g["sessions"]),
                I(_num(g["avg_fps"]), g["avg_fps"]),
                I(_num(g["low1"]), g["low1"]),
                I(_num(g["best_avg"]), g["best_avg"]),
                I(_num(g["gpu_temp_max"], 0, " °C"), g["gpu_temp_max"]),
                I(_date(g["first_ts"], False), g["first_ts"]),
                I(_date(g["last_ts"]), g["last_ts"]),
            ])
        self._fill_table(self.games_tbl, rows, (1, Qt.SortOrder.DescendingOrder))

        self._reset_combo(self.game_combo, [("Tüm oyunlar", None)] +
                          [(g, g) for g in sorted(r["game"] for r in games)], keep=True)
        self._fill_sessions()
        self._fill_compare()
        self._fill_pc_activity()

        if self.sync is not None:
            self.sync_lbl.setText(self.sync.status_text())
            self.b_upd.setVisible(bool(self.sync.update_available))
            self.b_repo.setText("⚙ Depo Ayarı" if self.sync.enabled else "🔗 GitHub Bağla")
        backups = self.store.list_backups()
        last_bak = os.path.basename(backups[-1]) if backups else "yok"
        self.footer.setText(f"Bu PC: {self._names().get(self.store.machine_id)} ({self.store.machine_id})   ·   "
                            f"Kayıt: {self.store.path}   ·   Son yedek: {last_bak} ({len(backups)} yedek)   ·   "
                            f"{MIN_SESSION_SEC // 60} dk'dan kısa açılışlar kaydedilmez")

    def _fill_sessions(self):
        game = self.game_combo.currentData()
        machine = self._machine()
        names = self._names()
        try:
            sessions = self.store.sessions(game, machine)
        except Exception:
            return
        if game:
            g = self.store.game_total(game, machine)
            if g:
                where = names.get(machine, "tüm PC'ler") if machine else "tüm PC'ler"
                self.game_summary.setText(
                    f"{game} ({where})  —  Toplam {fmt_duration(g['secs'])}  ·  {g['sessions']} oturum  ·  "
                    f"Ort. {_num(g['avg_fps'])} FPS  ·  Ort. 1% Low {_num(g['low1'])}  ·  "
                    f"En iyi oturum {_num(g['best_avg'])} FPS  ·  En kötü 0.1% Low {_num(g['worst_low01'])}  ·  "
                    f"GPU maks {_num(g['gpu_temp_max'], 0, ' °C')}  ·  CPU maks {_num(g['cpu_temp_max'], 0, ' °C')}")
            self.game_summary.show()
        else:
            self.game_summary.hide()

        I = self._item
        rows = []
        self._sess_timelines = {}
        for s in sessions:
            dur = fmt_duration(s["duration_s"]) + ("" if s["finished"] else "  (sürüyor)")
            first = I(_date(s["start_ts"]), s["start_ts"], align_right=False)
            first.setData(Qt.ItemDataRole.UserRole + 1, s["id"])
            first.setData(Qt.ItemDataRole.UserRole + 2, s["machine_id"])
            if s["timeline"]:
                self._sess_timelines[s["id"]] = (f"{s['game']} ({_date(s['start_ts'])})", s["timeline"])
            ac = s["ac_ratio"]
            power = "—" if ac is None else ("Priz" if ac >= 0.9 else "Pil" if ac <= 0.1 else f"Karışık (%{ac * 100:.0f} priz)")
            hs = s["gpu_hotspot_max"]
            stut = s["stutters"]
            ping = s["ping_avg"]
            res_txt = s["resolution"] or "—"
            rows.append([
                first,
                I(names.get(s["machine_id"], s["machine_id"]), names.get(s["machine_id"], ""), align_right=False),
                I(s["game"], s["game"], align_right=False),
                I(dur, s["duration_s"]),
                I(_num(s["avg_fps"]), s["avg_fps"]),
                I(_num(s["low1"]), s["low1"]),
                I(_num(s["low01"]), s["low01"]),
                I(_num(s["max_fps"]), s["max_fps"]),
                I(_num(s["avg_ft"], 1, " ms"), s["avg_ft"]),
                I(f"{_num(s['gpu_temp_avg'])} / {_num(s['gpu_temp_max'])}", s["gpu_temp_max"]),
                I(_num(hs, 0, " °C"), hs),
                I(_num(s["gpu_w_avg"], 0, " W"), s["gpu_w_avg"]),
                I(f"{_num(s['cpu_temp_avg'])} / {_num(s['cpu_temp_max'])}", s["cpu_temp_max"]),
                I(_num(s["cpu_w_avg"], 0, " W"), s["cpu_w_avg"]),
                I(_num(s["vram_max_mb"], 0, " MB"), s["vram_max_mb"]),
                I("—" if stut is None else str(int(stut)), stut),
                I(_num(ping, 0, " ms"), ping),
                I(res_txt, res_txt, align_right=False),
                I(power, -1 if ac is None else ac, align_right=False),
                I(s["note"] or "", s["note"] or "", align_right=False),
            ])
        self._fill_table(self.sess_tbl, rows, (0, Qt.SortOrder.DescendingOrder))
        self._on_session_selected()

    def _on_session_selected(self):
        sel = self._selected_session()
