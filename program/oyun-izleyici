        self.fps = self.fps_low = self.fps_avg = self.frametime_ms = None
        self.stutters = 0
        self.gpu_busy_ms = self.cpu_busy_ms = self.disp_lat_ms = None
        self.present_mode = ""
        self.bottleneck = ""

    @staticmethod
    def _log_candidates():
        out = []
        for path in glob.glob(os.path.join(MANGOHUD_DIR, "*.csv")):
            if path.endswith("_summary.csv"):
                continue
            try:
                out.append((os.path.getmtime(path), path))
            except OSError:
                continue
        return out

    @staticmethod
    def _program_alive(log_path):
        """Logu yazan program hâlâ çalışıyor mu? (oyun alt-tab/duraklatmada log yazmayı keser)"""
        m = LOG_NAME_RE.match(os.path.basename(log_path))
        prog = (m.group(1) if m else "").lower()
        if not prog:
            return False
        if IS_WIN:
            ps = _win_psutil()
            if not ps:
                return False
            names = {prog} if prog.endswith(".exe") else {prog, prog + ".exe"}
            for p in ps.process_iter(["name"]):
                try:
                    if (p.info["name"] or "").lower() in names:
                        return True
                except Exception:
                    continue
            return False
        for cmd_path in glob.glob("/proc/[0-9]*/cmdline"):
            try:
                with open(cmd_path, "rb") as f:
                    args = f.read().decode("utf-8", errors="ignore").split("\x00")
            except OSError:
                continue
            # Sadece program yolunun kendisi eşleşsin (ör. Z:\...\Game.exe veya /usr/bin/game)
            for arg in args[:3]:
                if arg and os.path.basename(arg.replace("\\", "/")).lower() == prog:
                    return True
        return False

    @staticmethod
    def _superseded(path, cands):
        """Aynı programın daha sonra başlamış bir logu varsa bu oturum bitmiştir
        (oyun kapatılıp hemen yeniden açıldığında program 'hâlâ açık' görünür)."""
        m = LOG_NAME_RE.match(os.path.basename(path))
        if not m:
            return False
        prog, start = m.group(1).lower(), start_ts_from_log(path)
        for _, other in cands:
            mo = LOG_NAME_RE.match(os.path.basename(other))
            if other != path and mo and mo.group(1).lower() == prog and start_ts_from_log(other) > start:
                return True
        return False

    def _ended(self, path, mt, cands, now_wall):
        return now_wall - mt > ORPHAN_STALE_SEC and (
            self._superseded(path, cands) or not self._program_alive(path))

    def _read_new_rows(self):
        try:
            with open(self._log_path, "rb") as f:
                f.seek(self._log_pos)
                data = f.read()
        except OSError:
            return []
        self._log_pos += len(data)
        lines = (self._log_partial + data.decode("utf-8", errors="ignore")).split("\n")
        self._log_partial = lines.pop()  # yarım kalan son satır
        rows = []
        for ln in lines:
            if self._log_cols is None:
                self._log_cols = header_columns(ln)
                continue
            rec = parse_row(ln, self._log_cols)
            if rec:
                rows.append(rec)
        return rows

    def _save(self, res, finished):
        if self.store is None:
            return
        try:
            self.store.upsert(res, finished)
        except Exception as e:
            print(f"[oyun-izleyici] kayıt hatası: {e}", file=sys.stderr)

    def capturing(self):
        return self.capture is not None and self.capture._active is not None

    def stop(self):
        if self.capture is not None:
            self.capture.stop()
        if self.pinger is not None:
            self.pinger.stop()
        if hasattr(self.cpu, "stop"):
            self.cpu.stop()
        if self.lhm is not None:
            self.lhm.stop()

    def checkpoint_now(self):
        """Panel kapanırken süren oturumu yarım olarak kaydet (sonraki açılışta tamamlanır)."""
        if self.session is not None:
            res = self.session.result()
            if res and res["duration_s"] >= MIN_SESSION_SEC:
                self._save(res, False)

    def _finish_session(self, notify=True):
        res = self.session.result() if self.session else None
        if res and res["duration_s"] >= MIN_SESSION_SEC:
            self._save(res, True)
            if notify:
                self.finished_events.append(res)
        elif self.session and self.store is not None:
            try:
                self.store.ignore(self.session.log_file, "kısa oturum")
            except Exception:
                pass
        self._reset_fps()

    def _import_orphans(self, cands):
        """Panel kapalıyken / başka oyunla aynı anda biten logları sessizce kaydeder."""
        if self.store is None:
            return
        now = time.time()
        try:
            self.store.finish_orphans({os.path.basename(p) for _, p in cands},
                                      os.path.basename(self._log_path) if self._log_path else None)
            for mt, path in cands:
                lf = os.path.basename(path)
                if path == self._log_path or now - mt < ORPHAN_STALE_SEC or self.store.is_done(lf):
                    continue
                if game_name_from_log(path) in IGNORED_PROGRAMS:
                    self.store.ignore(lf, "program")
                    continue
                if not self._ended(path, mt, cands, now):
                    continue
                res = SessionAccumulator.from_file(path).result()
                if res and res["duration_s"] >= MIN_SESSION_SEC:
                    self.store.upsert(res, True)
                else:
                    self.store.ignore(lf, "kısa oturum")
        except Exception as e:
            print(f"[oyun-izleyici] içe aktarma hatası: {e}", file=sys.stderr)

    def _update_game(self):
        now_wall = time.time()
        cands = self._log_candidates()
        mtimes = {p: mt for mt, p in cands}

        # Mevcut oturum: log durduysa ve program kapandıysa bitir
        if self._log_path:
            mt = mtimes.get(self._log_path)
            if mt is None:
                self._finish_session()
            elif self._ended(self._log_path, mt, cands, now_wall):
                for rec in self._read_new_rows():
                    self.session.add(rec)
                self._finish_session()

        # Yeni oturum: en taze, yok sayılmayan log
        if self._log_path is None:
            fresh = [(mt, p) for mt, p in cands
                     if now_wall - mt <= MANGOHUD_STALE_SEC
                     and game_name_from_log(p) not in IGNORED_PROGRAMS]
            if fresh:
                path = max(fresh)[1]
                self._reset_fps()
                self._log_path = path
                self.session = SessionAccumulator(path)
                self.game_name = self.session.game

        if now_wall - self._last_scan > 30:
            self._last_scan = now_wall
            self._import_orphans(cands)

        if self._log_path is None:
            return

        rows = self._read_new_rows()
        for rec in rows:
            self.session.add(rec)
            self.fps_hist.append((rec["fps"], rec["frametime"], rec.get("gpu_power"), rec.get("gpu_load")))
            if rec.get("frametime"):
                self.ft_hist.append(rec["frametime"])
        self.stutters = self.session.stutters if self.session else 0

        if self.capture is not None:
            gb, cb, dl, pm = self.capture.live_metrics()
            self.gpu_busy_ms, self.cpu_busy_ms, self.disp_lat_ms, self.present_mode = gb, cb, dl, pm
            if gb is not None and cb is not None and (gb > 0.1 or cb > 0.1):
                if gb > cb * 1.18:
                    self.bottleneck = "GPU"
                elif cb > gb * 1.18:
                    self.bottleneck = "CPU"
                else:
                    self.bottleneck = "DENGELİ"
            elif self.gpu_load >= 93:
                self.bottleneck = "GPU"
            elif self.cpu_load >= 85 and self.gpu_load < 85:
                self.bottleneck = "CPU"
            else:
                self.bottleneck = ""

        live = now_wall - mtimes.get(self._log_path, 0) <= MANGOHUD_STALE_SEC
        if not live or not self.fps_hist:
            # Oyun duraklatıldı / alt-tab: değerleri gösterme ama oturumu sürdür
            self.fps = self.frametime_ms = None
            return

        self.session.add_panel_sample(self)
        recent = list(self.fps_hist)[-5:]  # son ~0.5 sn
        self.fps = int(round(sum(r[0] for r in recent) / len(recent)))
        self.frametime_ms = recent[-1][1]
        active_window = [r[0] for r in self.fps_hist
                         if SessionAccumulator.is_gameplay_frame(r[0], r[2] if len(r) > 2 else self.gpu_watt,
                                                                 r[3] if len(r) > 3 else self.gpu_load)]
        active_window = SessionAccumulator.drop_load_runs(active_window)
        raw_vals = sorted(active_window if len(active_window) >= 15 else (r[0] for r in self.fps_hist))
        fps_vals = SessionAccumulator.filter_menu_outliers(raw_vals)
        self.fps_avg = int(round(sum(fps_vals) / len(fps_vals)))
        n_low = max(1, len(fps_vals) // 100)  # son 60 sn'nin en düşük %1'i
        self.fps_low = int(round(sum(fps_vals[:n_low]) / n_low))

        # Ara kayıt (elektrik kesilse / panel çökse bile oturum kaybolmaz)
        if time.monotonic() - self._last_checkpoint >= CHECKPOINT_SEC:
            self._last_checkpoint = time.monotonic()
            res = self.session.result()
            if res and res["duration_s"] >= MIN_SESSION_SEC:
                self._save(res, False)

    def update(self):
        # 1-2. Ekran kartı ve işlemci (donanıma göre otomatik)
        try:
            self.gpu.read(self)
        except Exception as e:
            print(f"[oyun-izleyici] GPU okuma hatası: {e}", file=sys.stderr)
        try:
            self.cpu.read(self)
        except Exception as e:
            print(f"[oyun-izleyici] CPU okuma hatası: {e}", file=sys.stderr)
        self.on_ac = read_power_source()

        # 3. RAM Metrics
        if IS_WIN:
            try:
                win_read_memory(self)
            except Exception:
                pass
        try:
            mem = {}
            with open("/proc/meminfo", "r") as f:
                for line in f:
                    parts = line.split(":")
                    if len(parts) == 2:
                        k = parts[0].strip()
                        v = int(parts[1].strip().split()[0])
                        mem[k] = v
            total_kb = mem["MemTotal"]
            avail_kb = mem["MemAvailable"]
            used_kb = max(0, total_kb - avail_kb)
            self.ram_used_gb = used_kb / (1024 * 1024)
            self.ram_total_gb = total_kb / (1024 * 1024)
            self.ram_pct = int(round((used_kb / max(1, total_kb)) * 100))
        except Exception:
            pass

        # 3.5. PSU Toplam Çekilen Güç (Watt) Hesabı
        gw = self.gpu_watt or 0
        cw = self.cpu_watt or 0
        base_overhead = 15 if self.on_ac is not None else 35
        raw_dc = gw + cw + base_overhead
        self.psu_watt = int(round(raw_dc * 1.08))

        # 3.7. Ağ (Mbps), Disk (MB/s), Canlı Ping/Jitter ve Ekran Modu
        if self.pinger is not None:
            self.ping_ms = self.pinger.ping_ms
            self.jitter_ms = self.pinger.jitter_ms
        if not self.display_mode:
            self.display_mode = detect_display_mode()
        ps = _win_psutil()
        if ps is not None:
            try:
                now_m = time.monotonic()
                nio = ps.net_io_counters()
                dio = ps.disk_io_counters()
                cur_io = (now_m, nio.bytes_recv if nio else 0, nio.bytes_sent if nio else 0,
                          (dio.read_bytes + dio.write_bytes) if dio else 0)
                if self._io_prev is not None:
                    dt = max(0.1, cur_io[0] - self._io_prev[0])
                    self.net_down_mbps = max(0.0, (cur_io[1] - self._io_prev[1]) * 8.0 / (dt * 1e6))
                    self.net_up_mbps = max(0.0, (cur_io[2] - self._io_prev[2]) * 8.0 / (dt * 1e6))
                    self.disk_mbps = max(0.0, (cur_io[3] - self._io_prev[3]) / (dt * 1048576.0))
                self._io_prev = cur_io
            except Exception:
                pass

        # 4. Aktif oyun + FPS / 1% Low / Avg / Frametime + oturum kaydı (MangoHud logundan)
        self._update_game()


