    def _submenu(self, parent, title):
        sub = StayOpenMenu(title, parent, owner=self)
        parent.addMenu(sub)
        return sub

    def _refresh_menu_state(self):
        """Menü açıkken yapılan seçimden sonra işaretleri / pasif-aktif durumlarını güncelle."""
        for fn in list(getattr(self, "_menu_sync", [])):
            try:
                fn()
            except RuntimeError:
                pass                      # kapanmış menünün öğeleri

    def _radio_menu(self, parent, title, options, current, on_pick):
        from PySide6.QtGui import QActionGroup
        sub = self._submenu(parent, title)
        grp = QActionGroup(sub)
        grp.setExclusive(True)
        for value, label in options:
            act = sub.addAction(label)
            act.setCheckable(True)
            act.setChecked(value == current)
            grp.addAction(act)
            act.triggered.connect(lambda _=False, v=value: on_pick(v))
        return sub

    def _add_overlay_menu(self, menu):
        if IS_WIN:
            return                          # oyun içi gösterge MangoHud'a bağlı (Linux)
        sub = self._submenu(menu, "🎮 Oyun İçi Gösterge (MangoHud)")
        o = self.overlay
        styled_menus = []
        self._radio_menu(sub, "👁️ Görünüm", OVERLAY_MODES, o["mode"], lambda v: self.set_overlay(mode=v))
        styled = o["mode"] in ("tek", "detay")
        for title, opts, key in (("📍 Konum", OVERLAY_POSITIONS, "pos"), ("🌫️ Arka Plan Saydamlığı", OVERLAY_ALPHAS, "bg"),
                                 ("🔤 Yazı Boyutu", OVERLAY_SIZES, "size")):
            m = self._radio_menu(sub, title, opts, o[key], lambda v, k=key: self.set_overlay(**{k: v}))
            m.setEnabled(styled)
            styled_menus.append(m)
        self._menu_sync.append(
            lambda: [m.setEnabled(self.overlay["mode"] in ("tek", "detay")) for m in styled_menus])
        sub.addSeparator()
        info = sub.addAction("⌨️ Oyunda göster / gizle: Sağ Shift + F12")
        info.setEnabled(False)
        info2 = sub.addAction("⚡ Değişiklik açık oyunda anında uygulanır")
        info2.setEnabled(False)

    def _add_opacity_menu(self, menu):
        opts = [
            (1.0, "%100 (Tam Koyu Arka Plan)"),
            (0.85, "%85"),
            (0.7, "%70"),
            (0.5, "%50"),
            (0.3, "%30"),
            (0.15, "%15 (Hafif Cam)"),
            (0.0, "%0 (Tam Şeffaf — Sadece Yazı & Grafikler)"),
        ]
        cur = min(opts, key=lambda o: abs(o[0] - self.opacity))[0]
        m = self._radio_menu(menu, "🪟 Arka Plan Saydamlığı (Ctrl + tekerlek)", opts, cur, self.set_opacity)
        m.setEnabled(self.isVisible())

    def set_opacity(self, value):
        self.opacity = min(1.0, max(0.0, round(value, 2)))
        self.setWindowOpacity(1.0)
        self.update()
        self.save_settings()

    def set_overlay(self, **changes):
        self.overlay.update(changes)
        o = self.overlay
        pci = mangohud_gpu_slot(self.telemetry.gpu)
        try:
            apply_overlay(o["mode"], o["pos"], o["bg"], o["size"], pci)
        except Exception as e:
            notify("Raven Watch", f"MangoHud ayarı yazılamadı: {e}")
            return
        self.save_settings()
        label = dict(OVERLAY_MODES).get(o["mode"], o["mode"])
        notify("Oyun içi gösterge", f"{label} — açık oyunda hemen uygulanır (Sağ Shift + F12: göster/gizle)")

    def _draw_header(self, p, W, hh, edna, accent, text, dim):
        """Üstteki saat / tarih şeridi: gündüz-gece simgesi, büyük saat, saniye, gün adı ve tarih."""
        import datetime
        now = datetime.datetime.now()
        base = QLinearGradient(0, 0, 0, hh)
        if edna:
            base.setColorAt(0.0, QColor(52, 68, 76, 255))
            base.setColorAt(1.0, QColor(40, 53, 60, 255))
        else:
            base.setColorAt(0.0, QColor(255, 255, 255, 14))
            base.setColorAt(1.0, QColor(0, 0, 0, 40))
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QBrush(base))
        p.drawRect(QRectF(2, 2, W - 4, hh - 3))

        # gündüz: güneş, gece: hilal
        cx, cy = 26.0, hh / 2.0
        if 6 <= now.hour < 18:
            sun = QColor(253, 188, 75)
            p.setPen(QPen(sun, 2.0, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
            for k in range(8):
                a = math.radians(k * 45)
                p.drawLine(QPointF(cx + math.cos(a) * 10.0, cy + math.sin(a) * 10.0),
                           QPointF(cx + math.cos(a) * 13.0, cy + math.sin(a) * 13.0))
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(sun)
            p.drawEllipse(QPointF(cx, cy), 6.6, 6.6)
        else:
            moon = QPainterPath()
            moon.addEllipse(QPointF(cx, cy), 9.0, 9.0)
            cut = QPainterPath()
            cut.addEllipse(QPointF(cx + 5.0, cy - 3.0), 8.0, 8.0)
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QColor(201, 212, 230) if edna else accent)
            p.drawPath(moon.subtracted(cut))

        # saat:dakika (büyük) + saniye (küçük, soluk)
        f_time = self._font(24)
        p.setFont(f_time)
        hm = now.strftime("%H:%M")
        p.setPen(text)
        p.drawText(QRectF(48, 0, 120, hh), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, hm)
        adv = p.fontMetrics().horizontalAdvance(hm)
        p.setFont(self._font(12))
        p.setPen(accent)
