def normalize_repo_slug(raw):
    """'https://github.com/sahip/depo.git', 'git@github.com:sahip/depo' veya 'sahip/depo' -> 'sahip/depo'."""
    s = (raw or "").strip()
    for pref in ("https://github.com/", "http://github.com/", "github.com/", "git@github.com:"):
        if s.lower().startswith(pref):
            s = s[len(pref):]
            break
    if s.lower().endswith(".git"):
        s = s[:-4]
    parts = [p for p in s.strip("/").split("/") if p]
    if len(parts) < 2:
        return ""
    slug = f"{parts[0]}/{parts[1]}"
    return slug if re.match(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", slug) else ""


def find_git_exe():
    """PATH veya standart Windows kurulum yollarındaki git ikilisini bulur."""
    g = shutil_which("git")
    if g:
        return g
    if IS_WIN:
        cands = [
            os.path.join(_LOCAL, "Programs", "Git", "cmd", "git.exe"),
            r"C:\Program Files\Git\cmd\git.exe",
            r"C:\Program Files (x86)\Git\cmd\git.exe",
        ]
        for c in cands:
            if os.path.isfile(c):
                return c
    return None


def ssh_key_path():
    return os.path.join(os.path.expanduser("~"), ".ssh", "oyun_kayitlari_ed25519")


def ensure_ssh_key():
    """Deploy key için ed25519 anahtar çifti oluşturur (varsa korur) ve (priv_path, pub_text) döndürür."""
    import socket
    import subprocess
    key = ssh_key_path()
    pub = key + ".pub"
    if not (os.path.isfile(key) and os.path.isfile(pub)):
        os.makedirs(os.path.dirname(key), exist_ok=True)
        keygen = (os.path.join(os.environ.get("SystemRoot", r"C:\Windows"), "System32", "OpenSSH", "ssh-keygen.exe")
                  if IS_WIN else shutil_which("ssh-keygen"))
        if not keygen or not os.path.isfile(keygen):
            keygen = shutil_which("ssh-keygen")
        if not keygen:
            raise RuntimeError("ssh-keygen bulunamadı (OpenSSH kurulu değil).")
        p = subprocess.run([keygen, "-q", "-t", "ed25519", "-N", "",
                            "-C", f"oyun-izleyici@{socket.gethostname()}", "-f", key],
                           capture_output=True, text=True, timeout=20, **_hidden())
        if p.returncode != 0:
            raise RuntimeError((p.stderr or p.stdout or "ssh-keygen başarısız").strip())
    with open(pub, encoding="utf-8") as f:
        return key, f.read().strip()


def read_github_token():
    try:
        with open(TOKEN_PATH, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def write_github_token(token):
    token = (token or "").strip()
    if not token:
        try:
            os.remove(TOKEN_PATH)
        except OSError:
            pass
        return
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = TOKEN_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(token + "\n")
    if not IS_WIN:
        try:
            os.chmod(tmp, 0o600)
        except OSError:
            pass
    os.replace(tmp, TOKEN_PATH)


def github_api_request(method, url, token=None, body=None, timeout=20):
    import json
    import urllib.error
    import urllib.request
    headers = {
        "Accept": "application/vnd.github+json",
        "User-Agent": "oyun-izleyici",
        "X-GitHub-Api-Version": "2022-11-28",
    }
    if token:
        headers["Authorization"] = f"Bearer {token}"
    data = None
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            return resp.status, (json.loads(raw) if raw.strip() else {})
    except urllib.error.HTTPError as e:
        raw = ""
        try:
            raw = e.read().decode("utf-8", errors="replace")
            err_msg = json.loads(raw).get("message") or raw
        except Exception:
            err_msg = raw or str(e)
        raise RuntimeError(f"GitHub HTTP {e.code}: {err_msg}") from None
    except urllib.error.URLError as e:
        raise RuntimeError(f"Bağlantı hatası: {e.reason}") from None


def _os_name():
    if IS_WIN:
        import platform
        try:
            build = int(platform.version().split(".")[-1])
        except ValueError:
            build = 0
        return "Windows " + ("11" if build >= 22000 else platform.release())
    for ln in read_str("/etc/os-release").splitlines():
        if ln.startswith("PRETTY_NAME="):
            return ln.split("=", 1)[1].strip('"')
    return "Linux"


class SyncManager:
    def __init__(self, store, cfg, machine_info):
        self.store = store
        self.cfg = cfg
        self.mid = cfg["kimlik"]
        self.info = machine_info
        self.mode = None          # "git" | "api" | None
        self.repo_slug = ""
        self.token = ""
        self.enabled = False
        self.state = "kapalı"
        self.last_ok = None
        self.last_error = None
        self.update_available = False
        self.remote_version = None
        self._notified_update_ver = None
        self._thread = None
        self._result = None
        self._again = False
        self.next_at = time.time() + 10  # açılıştan 10 sn sonra ilk senkron
        self._reload_mode()
        self.check_app_update()

    def _reload_mode(self):
        self.repo_slug = normalize_repo_slug(self.cfg.get("kayit_deposu", ""))
        self.token = read_github_token()
        if self.cfg.get("senkron", "acik") == "kapali":
            self.mode, self.enabled, self.state = None, False, "kapalı"
            return
        if os.path.isdir(os.path.join(REPO_DIR, ".git")) and find_git_exe():
            self.mode, self.enabled, self.state = "git", True, "bekliyor"
        elif self.repo_slug:
            self.mode, self.enabled, self.state = "api", True, "bekliyor"
        else:
            self.mode, self.enabled, self.state = None, False, "kapalı"

    def configure_api(self, repo_slug, token):
        slug = normalize_repo_slug(repo_slug)
        if not slug:
            raise ValueError("Geçerli bir depo adı gir (ör. kullanici/oyun-kayitlari).")
        write_github_token(token)
        save_machine_config({"kayit_deposu": slug, "senkron": "acik"})
        self.cfg["kayit_deposu"] = slug
        self.cfg["senkron"] = "acik"
        self.repo_slug = slug
        self.token = (token or "").strip()
        self.mode = "api"
        self.enabled = True
        self.last_error = None
        self.state = "bekliyor"
        self.request()

    def configure_git(self, repo_slug=""):
        slug = normalize_repo_slug(repo_slug)
        updates = {"senkron": "acik"}
        if slug:
            updates["kayit_deposu"] = slug
            self.cfg["kayit_deposu"] = slug
        save_machine_config(updates)
        self.cfg["senkron"] = "acik"
        self._reload_mode()
        self.last_error = None
        if self.enabled:
            self.request()

    def disconnect(self):
        save_machine_config({"kayit_deposu": "", "senkron": "kapali"})
        write_github_token("")
        self.cfg["kayit_deposu"] = ""
        self.cfg["senkron"] = "kapali"
        self.repo_slug = ""
        self.token = ""
        self.mode = None
        self.enabled = False
        self.last_error = None
        self.state = "kapalı"

    @staticmethod
    def _parse_version(text):
        """Kaynak dosyadaki APP_VERSION = 'X.Y.Z' değerini (X, Y, Z) demeti olarak okur."""
        m = re.search(r'^APP_VERSION\s*=\s*["\'](\d+)\.(\d+)\.(\d+)["\']', text, re.M)
        return (int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None

    def check_app_update(self):
        """Güncelleme rozetini yalnızca public GitHub release'in MAJOR veya MINOR sürümü
        kurulu sürümden büyükse gösterir; küçük yama veya yerel farklarda asla çıkmaz.
        Kaynak: public repo latest release → manifest.json (release+hash zinciri)."""
        try:
            import json as _json
            import urllib.request as _ur
            _status, release = github_api_request(
                "GET", "https://api.github.com/repos/cdokuro/oyun-izleyici/releases/latest")
            manifest_asset = None
            for asset in release.get("assets", []):
                if asset.get("name") == "manifest.json":
                    manifest_asset = asset
                    break
            if manifest_asset is None:
                self.update_available = False
                self.remote_version = None
                return False
            with _ur.urlopen(manifest_asset["browser_download_url"], timeout=15) as resp:
                manifest = _json.loads(resp.read().decode("utf-8"))
            ver_str = manifest.get("version", "")
            m = re.match(r'^(\d+)\.(\d+)\.(\d+)$', ver_str)
            if not m:
                self.update_available = False
                self.remote_version = None
                return False
            rem = (int(m.group(1)), int(m.group(2)), int(m.group(3)))
            loc = self._parse_version(f'APP_VERSION = "{APP_VERSION}"') or (0, 0, 0)
            if rem[:2] <= loc[:2]:
                self.update_available = False
                self.remote_version = None
                return False
            self.update_available = True
            self.remote_version = ver_str
            if self._notified_update_ver != ver_str:
                self._notified_update_ver = ver_str
                notify(f"Raven Watch — Yeni Sürüm v{ver_str}!",
                       "GitHub'dan büyük bir uygulama güncellemesi indirildi. "
                       "Paneldeki 'GÜNCELLE' rozetine veya sağ tık menüsündeki 'Uygulamayı Şimdi Güncelle'ye tıklayın.")
            return True
        except Exception:
            self.update_available = False
            self.remote_version = None
            return False

    # --- ana iş parçacığı ---
    def request(self):
        if not self.enabled:
            return
        if self._thread is not None:
            self._again = True
        else:
            self.next_at = 0

    def tick(self):
        """Panelin 500 ms'lik zamanlayıcısından çağrılır."""
        if not self.enabled:
            return False
        if self._thread is not None:
            if self._thread.is_alive():
                return False
            self._thread = None
            ok, err = self._result
            if ok:
                self.last_ok, self.last_error, self.state = time.time(), None, "tamam"
                self._import_repo()
                self.check_app_update()
            else:
                self.last_error, self.state = err, "hata"
            if self._again:
                self._again = False
                self.next_at = 0
            return True
        if time.time() >= self.next_at:
            self.next_at = time.time() + SYNC_INTERVAL_SEC
            self._start()
        return False

    def _start(self):
        import threading
        try:
            self._import_repo()          # önce depodakini al (kendi kaybolan kayıtlarımız dahil)
            self._export_own()           # sonra kendi klasörümüzü güncelle
        except Exception as e:
            self.last_error, self.state = f"dosya hatası: {e}", "hata"
            return
        self.state = "senkronize ediliyor"
        worker = self._git_worker if self.mode == "git" else self._api_worker
        self._thread = threading.Thread(target=worker, daemon=True)
        self._thread.start()

    def _own_dir(self):
        return os.path.join(REPO_DIR, "makineler", self.mid)

    @staticmethod
    def _write_if_changed(path, text):
        try:
            with open(path, encoding="utf-8", newline="") as f:
                if f.read() == text:
                    return False
        except OSError:
            pass
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8", newline="\n") as f:
            f.write(text)
        os.replace(tmp, path)
        return True

    def _export_own(self):
        import json
        d = self._own_dir()
        os.makedirs(d, exist_ok=True)
        info = dict(self.info, name=self.cfg.get("ad") or self.mid)
        self._write_if_changed(os.path.join(d, "makine.json"),
                               json.dumps(info, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
        lines = []
        for r in self.store.own_finished_sessions():
            rec = {}
            for c in SessionStore.SYNC_FIELDS:
                v = r[c]
                if isinstance(v, float):
                    v = round(v, 2)
                if v is not None:
                    rec[c] = v
            lines.append(json.dumps(rec, ensure_ascii=False, sort_keys=True))
        self._write_if_changed(os.path.join(d, "oturumlar.jsonl"), "\n".join(lines) + ("\n" if lines else ""))
        self.store.changed_since_sync = False

    def _import_repo(self):
        import json
        base = os.path.join(REPO_DIR, "makineler")
        for d in sorted(glob.glob(os.path.join(base, "*"))):
            mid = os.path.basename(d)
            try:
                with open(os.path.join(d, "makine.json"), encoding="utf-8") as f:
                    info = json.load(f)
            except (OSError, ValueError):
                info = {"name": mid}
            rows = []
            try:
                with open(os.path.join(d, "oturumlar.jsonl"), encoding="utf-8") as f:
                    for ln in f:
                        ln = ln.strip()
                        if ln:
                            try:
                                rows.append(json.loads(ln))
                            except ValueError:
                                continue
            except OSError:
                pass
            if mid == self.mid:
                self.store.restore_own_sessions(rows)
            else:
                self.store.upsert_machine(mid, info)
                self.store.replace_machine_sessions(mid, rows)
        self.store.upsert_machine(self.mid, dict(self.info, name=self.cfg.get("ad") or self.mid))

    # --- arka plan (git/SSH) ---
    def _git(self, *args, timeout=90):
        import subprocess
        git_exe = find_git_exe() or "git"
        env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
        if not IS_WIN:
            env.update(GIT_ASKPASS="true", SSH_ASKPASS="true")
        p = subprocess.run([git_exe, "-C", REPO_DIR, *args], capture_output=True, text=True,
                           timeout=timeout, env=env, **_hidden())
        if p.returncode != 0:
            raise RuntimeError((p.stderr or p.stdout).strip().splitlines()[-1] if (p.stderr or p.stdout).strip()
                               else f"git {args[0]} başarısız")
        return p.stdout

    def _git_worker(self):
        try:
            rel = os.path.join("makineler", self.mid)
            self._git("add", "--", rel)
            if self._git("status", "--porcelain", "--", rel).strip():
                self._git("-c", f"user.name=oyun-izleyici ({self.mid})",
                          "-c", f"user.email={self.mid}@oyun-izleyici.local",
                          "commit", "-q", "-m", f"{self.cfg.get('ad') or self.mid}: kayıtlar güncellendi")
            self._git("pull", "-q", "--rebase", "--autostash")
            ahead = self._git("rev-list", "--count", "@{u}..HEAD").strip()
            if ahead and ahead != "0":
                self._git("push", "-q")
            self._result = (True, None)
        except Exception as e:
            self._result = (False, str(e))

    # --- arka plan (GitHub Token / REST API — git gerektirmez) ---
    def _api_read_file(self, slug, rel_path, branch, token):
        import base64
        import urllib.parse
        q = urllib.parse.quote(rel_path, safe="/")
        url = f"https://api.github.com/repos/{slug}/contents/{q}?ref={urllib.parse.quote(branch)}"
        _, data = github_api_request("GET", url, token=token)
        if not isinstance(data, dict):
            return None, None
        sha = data.get("sha")
        if data.get("encoding") == "base64" and data.get("content") is not None:
            raw = base64.b64decode(data["content"].encode("ascii")).decode("utf-8", errors="replace")
            return raw, sha
        if sha:
            b_url = f"https://api.github.com/repos/{slug}/git/blobs/{sha}"
            _, blob = github_api_request("GET", b_url, token=token)
            if blob.get("encoding") == "base64" and blob.get("content") is not None:
                raw = base64.b64decode(blob["content"].encode("ascii")).decode("utf-8", errors="replace")
                return raw, sha
        return None, sha

    def _api_worker(self):
        import base64
        import urllib.parse
        slug = self.repo_slug
        token = self.token
        try:
            _, repo = github_api_request("GET", f"https://api.github.com/repos/{slug}", token=token)
            branch = repo.get("default_branch") or "main"

            # 1) Bu PC'nin kendi dosyalarını yalnızca değiştiyse GitHub'a gönder (token varsa)
            if token:
                own_dir = self._own_dir()
                msg = f"{self.cfg.get('ad') or self.mid}: kayıtlar güncellendi"
                for fname in ("makine.json", "oturumlar.jsonl"):
                    local_path = os.path.join(own_dir, fname)
                    if not os.path.isfile(local_path):
                        continue
                    with open(local_path, encoding="utf-8") as f:
                        local_txt = f.read()
                    rel = f"makineler/{self.mid}/{fname}"
                    remote_txt, remote_sha = None, None
                    try:
                        remote_txt, remote_sha = self._api_read_file(slug, rel, branch, token)
                    except RuntimeError as e:
                        if "HTTP 404" not in str(e):
                            raise
                    if remote_txt == local_txt:
                        continue
                    payload = {
                        "message": msg,
                        "content": base64.b64encode(local_txt.encode("utf-8")).decode("ascii"),
                        "branch": branch,
                    }
                    if remote_sha:
                        payload["sha"] = remote_sha
                    q = urllib.parse.quote(rel, safe="/")
                    github_api_request("PUT", f"https://api.github.com/repos/{slug}/contents/{q}",
                                       token=token, body=payload)

            # 2) Depodaki tüm makineleri indir (REPO_DIR/makineler/<id>/ altına)
            entries = []
            try:
                _, listing = github_api_request(
                    "GET",
                    f"https://api.github.com/repos/{slug}/contents/makineler?ref={urllib.parse.quote(branch)}",
                    token=token)
                if isinstance(listing, list):
                    entries = [it for it in listing if it.get("type") == "dir" and it.get("name")]
            except RuntimeError as e:
                if "HTTP 404" not in str(e):
                    raise

            for entry in entries:
                mid = entry["name"]
                if mid == self.mid and token:
                    continue
                target_dir = os.path.join(REPO_DIR, "makineler", mid)
                os.makedirs(target_dir, exist_ok=True)
                for fname in ("makine.json", "oturumlar.jsonl"):
                    try:
                        txt, _ = self._api_read_file(slug, f"makineler/{mid}/{fname}", branch, token)
                        if txt is not None:
                            self._write_if_changed(os.path.join(target_dir, fname), txt)
                    except RuntimeError as e:
                        if "HTTP 404" not in str(e):
                            raise

            # 3) Depoda program/oyun-izleyici ve pc_izleyici.py varsa yerel kopyasını güncelle
            for rel_p, loc_p in (("program/oyun-izleyici", "oyun-izleyici"), ("program/pc_izleyici.py", "pc_izleyici.py")):
                try:
                    prog_txt, _ = self._api_read_file(slug, rel_p, branch, token)
                    if prog_txt is not None:
                        self._write_if_changed(os.path.join(REPO_DIR, "program", loc_p), prog_txt)
                except RuntimeError as e:
                    if "HTTP 404" not in str(e):
                        raise

            self._result = (True, None)
        except Exception as e:
            self._result = (False, str(e))

    def status_text(self):
        if not self.enabled:
            return "GitHub senkronu kapalı — PC karşılaştırması için 'GitHub Deposu Bağla'ya tıkla"
        tag = f" ({self.repo_slug})" if self.repo_slug else ""
        ro = " [salt okunur]" if (self.mode == "api" and not self.token) else ""
        upd = "   ·   ⬆ Yeni uygulama güncellemesi hazır!" if self.update_available else ""
        if self.state == "senkronize ediliyor":
            return f"GitHub{tag}: senkronize ediliyor…" + upd
        if self.last_error:
            return f"GitHub{tag}: HATA — {self.last_error}" + upd
        if self.last_ok:
            return f"GitHub{tag}{ro}: son senkron " + time.strftime("%H:%M", time.localtime(self.last_ok)) + " ✓" + upd
        return f"GitHub{tag}{ro}: bekliyor" + upd


def _verify_file(path, expected_sha256):
    """Dosyanın SHA-256 özetini doğrular (make-release.py'deki verify_file ile ikiz).
    Zaman sabiti karşılaştırma."""
    import hashlib as _hashlib
    try:
        h = _hashlib.sha256()
        with open(path, "rb") as f:
            while True:
                chunk = f.read(65536)
                if not chunk:
                    break
                h.update(chunk)
        actual = h.hexdigest()
        if len(actual) != len(expected_sha256):
            return False
        result = 0
        for a, b in zip(actual, expected_sha256):
            result |= ord(a) ^ ord(b)
        return result == 0
    except (OSError, TypeError):
        return False


def apply_app_update(parent_win=None):
    """Public GitHub release'ten SHA-256 doğrulamasıyla güncelleme indirir ve kurar.
    manifest.json'daki hash'lerle uyuşmayan varlık KURULMAZ. Başarılıysa uygulamayı yeniden başlatır."""
    import shutil
    import json as _json
    import urllib.request as _ur
    import tempfile as _tmp
    inst_bin = INSTALLED_BIN
    try:
        # 1) Latest release manifestosunu al
        _status, release = github_api_request(
            "GET", "https://api.github.com/repos/cdokuro/oyun-izleyici/releases/latest")
        assets = {a["name"]: a for a in release.get("assets", [])}
        if "manifest.json" not in assets:
            notify("Raven Watch — Güncelleme Hatası", "Release'te manifest.json bulunamadı.")
            return
        # manifest.json'u indir
        with _ur.urlopen(assets["manifest.json"]["browser_download_url"], timeout=20) as resp:
            manifest = _json.loads(resp.read().decode("utf-8"))
        files = manifest.get("files", {})
        # İki dosya birlikte yoksa karışık sürüm kurma.
        needed = {"oyun-izleyici", "pc_izleyici.py"}
        available = needed & set(files.keys())
        if available != needed:
            notify("Raven Watch — Güncelleme Hatası",
                   "Release manifestosunda beklenen iki dosya da bulunmalı; güncelleme yapılmadı.")
            return
        # 2) Her dosyayı geçici olarak indir ve SHA-256 doğrula
        downloaded = {}  # name -> temp_path; temizliğin TEK sahibi aşağıdaki finally
        try:
            for name in ("oyun-izleyici", "pc_izleyici.py"):
                entry = files[name]
                asset = assets.get(name)
                if asset is None:
                    notify("Raven Watch — Güncelleme Hatası",
                           f"doğrulama başarısız: {name} (release varlığı yok)")
                    return
                tmp_fd, tmp_path = _tmp.mkstemp(prefix=f"oi_upd_{name}_")
                os.close(tmp_fd)
                downloaded[name] = tmp_path
                try:
                    _ur.urlretrieve(asset["browser_download_url"], tmp_path)
                except (OSError, ValueError, RuntimeError) as dl_err:
                    notify("Raven Watch — Güncelleme Hatası", f"İndirme başarısız: {name} ({dl_err})")
                    return
                if not _verify_file(tmp_path, entry["sha256"]):
                    notify("Raven Watch — Güncelleme Hatası",
                           f"doğrulama başarısız: {name}")
                    return
            # 3) Önce iki yedeği hazırla; sonra doğrulanmış dosyaları atomik yerleştir.
            targets = {
                "oyun-izleyici": inst_bin,
                "pc_izleyici.py": os.path.join(os.path.dirname(inst_bin), "pc_izleyici.py"),
            }
            os.makedirs(os.path.dirname(inst_bin), exist_ok=True)
            backups = {}
            for name, target in targets.items():
                if os.path.isfile(target):
                    backups[name] = target + ".bak"
                    shutil.copy2(target, backups[name])
            os.chmod(downloaded["oyun-izleyici"], 0o755)
            replaced = set()
            try:
                for name, target in targets.items():
                    os.replace(downloaded[name], target)
                    replaced.add(name)
            except OSError as place_error:
                rollback_errors = []
                for name, target in targets.items():
                    try:
                        if name in backups:
                            os.replace(backups[name], target)
                        elif name in replaced and os.path.exists(target):
                            os.unlink(target)
                    except OSError as rollback_error:
                        rollback_errors.append(f"{name}: {rollback_error}")
                if rollback_errors:
                    raise RuntimeError("Yerleştirme ve geri alma başarısız: " + "; ".join(rollback_errors)) from place_error
                raise RuntimeError("Yerleştirme başarısız; iki dosya da .bak yedeğinden geri yüklendi.") from place_error
        finally:
            for tmp_path in downloaded.values():
                try:
                    os.unlink(tmp_path)
                except OSError:
                    pass
    except (OSError, ValueError, RuntimeError, KeyError) as e:
        notify("Raven Watch — Güncelleme Hatası", str(e))
        return
    if parent_win is not None:
        try:
            parent_win.shutdown()
        except (OSError, RuntimeError, AttributeError):
            pass
    notify("Raven Watch Güncellendi", "Yeni sürüm kuruldu ve yeniden başlatılıyor…")
    if IS_WIN:
        import subprocess
        py = sys.executable
        if py.lower().endswith("python.exe"):
            py = py[:-len("python.exe")] + "pythonw.exe"
        subprocess.Popen([py, inst_bin], env=dict(os.environ, OI_RESTART="1"), close_fds=True,
                         creationflags=0x00000008 | 0x00000200)   # DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP
        os._exit(0)
    os.execv(sys.executable, [sys.executable, inst_bin])


