class StayOpenMenu(QMenu):
    """İşaretlenebilir (checkable) öğelere tıklayınca menü kapanmasın: çoklu ayar tek seferde yapılabilsin.
    Öğe tetiklenir, ardından pencere işaretleri ve pasif/aktif durumları günceller."""

    def __init__(self, *args, owner=None, **kw):
        super().__init__(*args, **kw)
        self.owner = owner

    def mouseReleaseEvent(self, e):
        act = self.actionAt(e.position().toPoint())
        if (act is not None and act.isEnabled() and act.isCheckable() and act.menu() is None
                and e.button() == Qt.MouseButton.LeftButton):
            act.trigger()
            if self.owner is not None:
                self.owner._refresh_menu_state()
            e.accept()
            return
        super().mouseReleaseEvent(e)


