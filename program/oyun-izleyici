    def _set_scale(self, factor):
        self.scale_factor = factor
        self.resize(int(self.base_w * factor), int(self.base_h * factor))
        self.update()
        self.save_settings()

    def _apply_window_flags(self):
        # Sistem tepsisi varsa veya daemon yönetiyorsa Tool bayrağı ile görev çubuğundan ve Alt+Tab'dan gizle
        base = Qt.WindowType.Tool if (self.tray is not None or self.daemon_managed or IS_WIN) else Qt.WindowType.Window
        flags = base | Qt.WindowType.FramelessWindowHint
        if self.always_on_top:
            flags |= Qt.WindowType.WindowStaysOnTopHint
        self.setWindowFlags(flags)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground, True)
        self.setAttribute(Qt.WidgetAttribute.WA_ShowWithoutActivating, True)
        self.setWindowOpacity(1.0)

    def _enforce_win_topmost(self):
        """Windows'ta oyun odağa dönünce HUD'un arka plana düşmesini engeller (odağı çalmadan HWND_TOPMOST)."""
        if not (IS_WIN and self.always_on_top and self.isVisible()):
            return
        try:
            import ctypes
            hwnd = int(self.winId())
            if not hwnd:
                return
            u32 = ctypes.windll.user32
            u32.SetWindowPos.argtypes = [
                ctypes.c_void_p, ctypes.c_void_p,
                ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_uint,
            ]
            u32.SetWindowPos.restype = ctypes.c_int
            # HWND_TOPMOST = -1; SWP_NOSIZE (0x1) | SWP_NOMOVE (0x2) | SWP_NOACTIVATE (0x10)
            u32.SetWindowPos(ctypes.c_void_p(hwnd), ctypes.c_void_p(-1), 0, 0, 0, 0, 0x0013)
        except Exception:
            pass

    def showEvent(self, event):
        super().showEvent(event)
        self._enforce_win_topmost()

    def move_to_left_hdmi_monitor(self):
        screens = QGuiApplication.screens()
        target_screen = None
        for s in screens:
            if "HDMI" in s.name().upper() or s.geometry().x() == 0:
                target_screen = s
                break
        if target_screen is None and screens:
            target_screen = min(screens, key=lambda s: s.geometry().x())

        if target_screen:
            geo = target_screen.geometry()
            # Sol monitörün sağ-orta kısmına veya sol üstüne şık şekilde yerleştir
            x = geo.x() + geo.width() - self.width() - 30
            y = geo.y() + (geo.height() - self.height()) // 2
            self.move(x, y)
            self.save_settings()

    def _setup_tray(self):
        from PySide6.QtWidgets import QSystemTrayIcon
        from PySide6.QtGui import QIcon, QPixmap
        if not QSystemTrayIcon.isSystemTrayAvailable():
            return
        icon = QIcon.fromTheme("applications-games")
        if icon.isNull():
            pm = QPixmap(64, 64)
            pm.fill(QColor(6, 9, 8))
            qp = QPainter(pm)
            qp.setPen(QColor(64, 255, 112))
            qp.setFont(make_font(26))
            qp.drawText(pm.rect(), Qt.AlignmentFlag.AlignCenter, "FPS")
            qp.end()
            icon = QIcon(pm)
        self.tray = QSystemTrayIcon(icon, self)
        self.tray.setToolTip("Raven Watch")
        menu = StayOpenMenu(owner=self)
        menu.aboutToShow.connect(lambda: self._fill_tray_menu(menu))  # işaretler her açılışta güncel
        self._fill_tray_menu(menu)
        self._tray_menu = menu
        self.tray.setContextMenu(menu)
        self.tray.activated.connect(
            lambda reason: self.open_history() if reason == QSystemTrayIcon.ActivationReason.Trigger else None)
        self.tray.show()
        global _NOTIFY_TRAY
        _NOTIFY_TRAY = self.tray            # Windows bildirimleri tepsi simgesinden gösterilir

    def _fill_tray_menu(self, menu):
        menu.clear()
        menu.setStyleSheet(build_menu_style(self.theme, self.accent_hex))
        self._menu_sync = []
        if self.sync and self.sync.update_available:
            act_u = menu.addAction("⬆ Yeni Güncelleme Var — Şimdi Güncelle!", lambda: apply_app_update(self))
            f = act_u.font()
            f.setBold(True)
