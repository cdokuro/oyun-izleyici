def _num(v, d=0, suffix=""):
    if v is None:
        return "—"
    return f"{v:.{d}f}{suffix}"


def _date(ts, with_time=True):
    if not ts:
        return "—"
    return time.strftime("%d.%m.%Y %H:%M" if with_time else "%d.%m.%Y", time.localtime(ts))


