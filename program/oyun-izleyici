    # --- yardımcılar ---
    @staticmethod
    def _item(text, sort_key=None, align_right=True):
        from PySide6.QtWidgets import QTableWidgetItem

        class _Item(QTableWidgetItem):
            def __lt__(self, other):
                a = self.data(Qt.ItemDataRole.UserRole)
                b = other.data(Qt.ItemDataRole.UserRole)
                if a is None or b is None:
                    return super().__lt__(other)
                return a < b

        it = _Item(text)
        it.setData(Qt.ItemDataRole.UserRole, sort_key if sort_key is not None else -1e18)
        if align_right:
            it.setTextAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
        return it

    def _fill_table(self, tbl, rows, default_sort):
        hdr = tbl.horizontalHeader()
        col, order = (hdr.sortIndicatorSection(), hdr.sortIndicatorOrder()) \
            if getattr(tbl, "_user_sorted", False) else default_sort
        tbl.setSortingEnabled(False)
        tbl.setRowCount(len(rows))
        for r, cells in enumerate(rows):
            for c, it in enumerate(cells):
                tbl.setItem(r, c, it)
        tbl.setSortingEnabled(True)
        tbl.sortByColumn(col, order)

    def _machine(self):
        return self.pc_combo.currentData()

    def _names(self):
        return {m["machine_id"]: m["name"] or m["machine_id"] for m in self.store.machines()}

    @staticmethod
    def _reset_combo(combo, items, keep, default_index=0):
        cur = combo.currentData() if keep else None
        combo.blockSignals(True)
        combo.clear()
        for text, data in items:
            combo.addItem(text, data)
        idx = combo.findData(cur) if cur is not None else -1
        combo.setCurrentIndex(idx if idx >= 0 else min(default_index, combo.count() - 1))
        combo.blockSignals(False)

    # --- doldurma ---
    def refresh(self):
        try:
            machines = self.store.machines()
        except Exception as e:
            self.totals_lbl.setText(f"Kayıt okunamadı: {e}")
            return
        own = self.store.machine_id
        items = [("Tüm PC'ler", None)] + [
            (f"{m['name'] or m['machine_id']}{'  (bu PC)' if m['machine_id'] == own else ''}", m["machine_id"])
            for m in machines]
        self._reset_combo(self.pc_combo, items, keep=True)
        pcs = [(f"{m['name'] or m['machine_id']}", m["machine_id"]) for m in machines]
        self._reset_combo(self.cmp_a, pcs, keep=True, default_index=0)
        self._reset_combo(self.cmp_b, pcs, keep=True, default_index=1)
        self._fill_all()

